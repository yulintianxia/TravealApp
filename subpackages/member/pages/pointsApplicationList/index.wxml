<wxs module="getDate" src="./state.wxs"></wxs>
<view class="page">
  <!-- 自定义导航栏 -->
  <!-- <view class="nav-bar" style="padding-top:{{statusBarHeight}}px">
    <view class="nav-bar-inner">
      <view class="nav-bar-title">积分申请</view>
    </view>
  </view> -->

  <!-- 列表区域 -->
  <scroll-view
    class="scroll-view"
    scroll-y
    style="height:calc(100vh - {{statusBarHeight + 44}}px)"
    bindscrolltolower="bindscrolltolower"
    lower-threshold="{{20}}"
  >
    <view class="list" wx:if="{{applicationList.length}}">
      <view
        class="card"
        wx:for="{{applicationList}}"
        wx:key="keyId"
        wx:for-item="item"
      >
        <view class="card-body" data-item="{{item}}" bindtap="see">
          <!-- 缩略图 -->
          <image
            class="card-thumb"
            src="{{item.firstPhoto}}"
            mode="aspectFill"
            wx:if="{{item.firstPhoto}}"
          />
          <view class="card-thumb card-thumb-empty" wx:else>
            <text class="thumb-text">暂无</text>
          </view>

          <!-- 信息区 -->
          <view class="card-info">
            <view class="card-name">{{item.wxName}}</view>
            <view class="card-remark">{{item.remark || '暂无备注信息'}}</view>
          </view>

          <!-- 右侧金额+状态 -->
          <view class="card-right">
            <view class="card-amount">¥{{item.paymentMoney}}</view>
            <view class="card-status status-{{item.status}}">{{getDate.judgmentState(item.status)}}</view>
          </view>
        </view>

        <!-- 底部日期 -->
        <view class="card-footer">
          <view class="card-date">{{item.createTime}}</view>
        </view>
      </view>
    </view>

    <view wx:else class="empty">
      <text class="empty-text">暂无申请明细</text>
    </view>
  </scroll-view>

  <!-- 底部按钮 -->
  <view class="btn-wrap">
    <view class="btn" bindtap="addUrl">新增积分申请</view>
  </view>
</view>
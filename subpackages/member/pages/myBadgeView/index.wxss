/* pages/MyBadgeView/index.wxss *//* 保留原 scoped 样式，移除 Vue 特有语法，适配小程序单位（rpx） */
.popUp-share-img {
  width: 66.67vw
}

.popUp-share-img img {
  display: block;
  width: 100%;
  height: auto
}

.popUp-share-img .tip {
  color: #fff;
  font-size: 3.73vw;
  line-height: 6.67vw
}

/* 省略大量原有样式，核心保留勋章相关样式 */
.medalwall-wrap {
  width: 100%;
  min-height: 100vh;
  background-size: cover;
  background-position: center;
}

.medal-list {
  width: 100%;
  height: auto;
}

.medal {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx;
}

.medal .img {
  width: 200rpx;
  height: 200rpx;
  background-size: cover;
  background-position: center;
}

.medal .img.menban {
  opacity: 0.5;
}

.medal .year {
  font-size: 28rpx;
  margin: 10rpx 0;
}

.medal .title {
  font-size: 32rpx;
  font-weight: bold;
  margin: 10rpx 0;
}

.medal .tip {
  font-size: 24rpx;
  color: #666;
  margin: 5rpx 0;
}

.medal .tipTitle {
  font-size: 26rpx;
  color: #333;
}

.medal .line {
  margin-top: 20rpx;
}

.medal .btn {
  padding: 10rpx 30rpx;
  border: 1px solid #0086f6;
  border-radius: 4rpx;
  background-color: #fff;
  color: #0086f6;
}

.medalwall-bottom .tour {
  display: flex;
  justify-content: center;
  margin-top: 20rpx;
}

.medalwall-bottom .dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: #ccc;
  margin: 0 8rpx;
}

.medalwall-bottom .dot.show {
  background-color: #0086f6;
}
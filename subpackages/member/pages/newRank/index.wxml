<view class="rank-container">
  <!-- 顶部导航 -->
  <view class="top-nav">
    <text class="nav-title">排行</text>
    <view class="nav-actions">
      <image src="/images/home/messageTip.png" class="action-icon" />
      <image src="/images/home/search.png" class="action-icon" />
    </view>
  </view>
  
  <!-- 金色龙背景 -->
  <view class="dragon-section">
    <image src="/images/home/1.png" class="dragon-image" />
    <view class="rank-badge">正莲·积分榜</view>
  </view>
  
  <!-- 前三名 -->
  <view class="top-three">
    <view class="rank-second">
      <view class="rank-number">2</view>
      <view class="rank-avatar">
        <image src="/images/home/2.png" />
      </view>
      <view class="rank-name">可悦海</view>
      <view class="rank-score">3000</view>
    </view>
    
    <view class="rank-first">
      <view class="rank-number">1</view>
      <view class="rank-avatar">
        <image src="/images/home/1.png" />
      </view>
      <view class="rank-name">益州白子画</view>
      <view class="rank-score">6006</view>
    </view>
    
    <view class="rank-third">
      <view class="rank-number">3</view>
      <view class="rank-avatar">
        <image src="/images/home/3.png" />
      </view>
      <view class="rank-name">正莲虎哥</view>
      <view class="rank-score">2800</view>
    </view>
  </view>
  
  <!-- 其他排名 -->
  <view class="other-ranks">
    <view class="rank-item" wx:for="{{otherRanks}}" wx:key="index">
      <view class="rank-index">{{index + 4}}</view>
      <view class="rank-avatar-small">
        <image src="{{item.avatar}}" />
      </view>
      <view class="rank-name">{{item.name}}</view>
      <view class="rank-score">{{item.score}} 积分</view>
    </view>
  </view>
  
  <!-- 底部导航 -->
  <view class="bottom-nav">
    <view class="nav-item" bindtap="goToHome">
      <image src="/images/home/tabbar_home.png" class="nav-icon" />
      <text class="nav-text">首页</text>
    </view>
    <view class="nav-item active" bindtap="goToMine">
      <image src="/images/home/tabbar_mine_hover.png" class="nav-icon" />
      <text class="nav-text">我的</text>
    </view>
  </view>
</view>
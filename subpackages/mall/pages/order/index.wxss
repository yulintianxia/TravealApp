/* pages/order/index.wxss */
page {
  background: linear-gradient(180deg, #070912 0%, #0b0e1a 38%, #0d111a 100%);
}

.order-page {
  min-height: 100vh;
  padding-bottom: 40rpx;
  background: radial-gradient(
    circle at top,
    rgba(27, 35, 52, 0.88) 0%,
    rgba(10, 12, 20, 0.94) 32%,
    rgba(8, 10, 16, 1) 100%
  );
}

.amount-price {
  font-size: 32rpx;
  color: #e8c98d;
  font-weight: 700;
  line-height: 1;
  margin-left:20rpx;
  margin-top:14rpx;
}

.order-number{
  font-size:26rpx;
  color: #f4ead7;
  margin-bottom:10rpx;
  display: flex;
  justify-content: space-between;

}
.order-state{
  font-size:24rpx;
  color: rgba(204, 201, 194, 0.72);
}

.status-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx 12rpx;
  color: #f4ead7;
}

.card-order {
  font-size: 26rpx;
  color: rgba(204, 201, 194, 0.72);
  display: flex;
  justify-content: space-between;
  margin-top:10rpx;
}
.time {
  font-size: 32rpx;
  line-height: 1;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.status-icons {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.signal-wrap {
  display: flex;
  align-items: flex-end;
  gap: 4rpx;
  height: 18rpx;
}

.signal {
  width: 4rpx;
  border-radius: 999rpx;
  background: #e7d8b7;
}

.signal-1 {
  height: 8rpx;
}
.signal-2 {
  height: 10rpx;
}
.signal-3 {
  height: 14rpx;
}
.signal-4 {
  height: 18rpx;
}

.wifi-wrap {
  position: relative;
  width: 24rpx;
  height: 20rpx;
}

.wifi {
  position: absolute;
  inset: 0;
  margin: auto;
  border: 2rpx solid transparent;
  border-top-color: #e7d8b7;
  border-radius: 50%;
}

.wifi-1 {
  width: 18rpx;
  height: 18rpx;
}
.wifi-2 {
  width: 12rpx;
  height: 12rpx;
}
.wifi-3 {
  width: 8rpx;
  height: 8rpx;
}

.battery-wrap {
  position: relative;
  width: 44rpx;
  height: 20rpx;
  display: flex;
  align-items: center;
}

.battery-body {
  width: 38rpx;
  height: 18rpx;
  border: 2rpx solid #e7d8b7;
  border-radius: 5rpx;
}

.battery-body::after {
  content: "";
  position: absolute;
  right: 0;
  width: 4rpx;
  height: 10rpx;
  background: #e7d8b7;
  border-radius: 2rpx;
}

.page-header {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 18rpx 36rpx 6rpx;
}

.header-title {
  font-size: 42rpx;
  color: #f2dfc2;
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: 2rpx;
}

.header-actions {
  position: absolute;
  right: 38rpx;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.dot-group {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 6rpx 8rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.04);
}

.dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: rgba(246, 224, 184, 0.9);
}

.header-bubble {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(241, 219, 177, 0.9);
  box-sizing: border-box;
}

.tab-bar {
  display: flex;
  align-items: stretch;
  background: rgba(17, 18, 27, 0.68);
  border-radius: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.04);
  margin: 18rpx 30rpx 0;
  overflow: hidden;
}

.tab-item {
  position: relative;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 26rpx 0 18rpx;
}

.tab-text {
  font-size: 28rpx;
  color: rgba(214, 206, 194, 0.58);
  font-weight: 500;
}

.tab-item.active .tab-text {
  color: #f3dfb2;
  font-weight: 600;
}

.tab-item.active::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 0;
  transform: translateX(-50%);
  width: 50rpx;
  height: 5rpx;
  border-radius: 999rpx;
  background: linear-gradient(
    90deg,
    rgba(237, 210, 157, 0) 0%,
    #e7c784 50%,
    rgba(231, 199, 132, 0) 100%
  );
}

.order-scroll {
  /* margin-top: 18rpx; */
}

.empty-state {
  display: flex;
  justify-content: center;
  align-items: center;
  padding-top: 300rpx;
}

.empty-text {
  color: rgba(214, 206, 194, 0.62);
  font-size: 30rpx;
}

.order-list {
  padding: 16rpx 28rpx 40rpx;
}

.order-card {
  background: linear-gradient(
    180deg,
    rgba(31, 32, 44, 0.94) 0%,
    rgba(25, 27, 39, 0.94) 100%
  );
  border: 1rpx solid rgba(255, 255, 255, 0.04);
  border-radius: 28rpx;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.03);
  padding: 22rpx 20rpx 18rpx;
  margin-bottom: 18rpx;
}

.order-card-history {
  margin-top: 6rpx;
}

.card-body {
  display: flex;
  align-items: flex-start;
}

.product-img {
  width: 148rpx;
  height: 148rpx;
  border-radius: 18rpx;
  flex-shrink: 0;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  background: #1d1c1f;
  margin-top:6rpx;
}

.product-info {
  flex: 1;
  min-width: 0;
  min-height: 146rpx;
  margin-left: 18rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.name-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.product-name {
  max-width: 100%;
  font-size: 30rpx;
  line-height: 1.45;
  color: #f0dfc5;
  font-weight: 600;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.mini-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  background: rgba(225, 193, 113, 0.17);
  border: 1rpx solid rgba(233, 195, 111, 0.38);
  color: #f0d28d;
  font-size: 18rpx;
  line-height: 1.5;
}

/* .card-order .product-desc-time {
  width: 50%;
}
.card-order .product-desc-time.fr {
  text-align: right;
} */
.product-desc {
  width: 100%;
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: rgba(204, 201, 194, 0.72);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
  text-overflow: ellipsis;
}
.product-desc-time {
  display: block;
  font-size: 26rpx;
  color: rgba(204, 201, 194, 0.72);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.product-spec {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: rgba(181, 178, 185, 0.7);
}

.price-col {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  width: 160rpx;
  min-width: 160rpx;
  margin-left: 10rpx;
  padding-top: 4rpx;
}

.status-label {
  margin-bottom: 10rpx;
  font-size: 24rpx;
  color: rgba(211, 211, 219, 0.8);
  line-height: 1.3;
}

.price-row {
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
}

.price-symbol {
  font-size: 26rpx;
  color: #e8c98d;
  font-weight: 600;
}

.price-num {
  font-size: 28rpx;
  color: #e8c98d;
  font-weight: 700;
  line-height: 1;
}

.amount {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: rgba(191, 191, 199, 0.7);
}

.card-action {
  display: flex;
  justify-content: flex-end;
  margin-top: 18rpx;
}

.confirm-btn {
  min-width: 100rpx;
  text-align: center;
  padding: 14rpx 24rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #f0d7a7 0%, #d7b679 100%);
  color: #302611;
  font-size: 26rpx;
  font-weight: 600;
}

.confirm-btn {
  min-width: 100rpx;
  text-align: center;
  padding: 14rpx 24rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #f0d7a7 0%, #d7b679 100%);
  color: #302611;
  font-size: 26rpx;
  font-weight: 600;
}

.history-divider {
  display: flex;
  align-items: center;
  padding: 26rpx 6rpx 18rpx;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background: rgba(255, 255, 255, 0.08);
}

.divider-text {
  padding: 0 20rpx;
  font-size: 28rpx;
  color: rgba(214, 206, 194, 0.72);
}

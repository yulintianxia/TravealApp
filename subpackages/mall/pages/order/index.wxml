<!-- pages/order/index.wxml -->
<wxs module="getDate" src="./state.wxs"></wxs>
<view class="order-page">
  <view class="tab-bar">
    <view class="tab-item {{value == 'all' ? 'active' : ''}}" data-value="all" bindtap="onTabClick">
      <text class="tab-text">全部</text>
    </view>
    <view class="tab-item {{value == '1' ? 'active' : ''}}" data-value="1" bindtap="onTabClick">
      <text class="tab-text">待发货</text>
    </view>
    <view class="tab-item {{value == '2' ? 'active' : ''}}" data-value="2" bindtap="onTabClick">
      <text class="tab-text">待收货</text>
    </view>
    <view class="tab-item {{value == '3' ? 'active' : ''}}" data-value="3" bindtap="onTabClick">
      <text class="tab-text">已收货</text>
    </view>
  </view>
  <scroll-view class="order-scroll" scroll-y lower-threshold="30" bindscrolltolower="onReachBottom" style="height: {{scrollHeight}}px;">
    <view wx:if="{{goodList.length === 0}}" class="empty-state">
      <text class="empty-text">暂无订单</text>
    </view>
    <view wx:else class="order-list" >
      <block wx:for="{{goodList}}"  wx:key="keyId">
        <view class="order-card" bindtap="goDetail" data-id="{{item.keyId}}" >
          <view class='order-number'>
            <view catchtap="handleCopy" data-number="{{item.orderNumber}}">
              订单号：{{item.orderNumber}} | 复制
            </view>
            <text class='order-state'>{{getDate.judgmentState(item.status)}}</text>
          </view>
          <view class="card-body">
            <image class="product-img" src="{{item.coverImage}}" mode="aspectFill"></image>
            <view class="product-info">
              <view class="name-row">
                <!-- <text class="product-name">{{item.orderNumber}}</text> -->
                <text class="product-name">{{item.goodsName}}</text>
                <text class="mini-badge" wx:if="{{item.tags.length}}">
                  <text wx:for="{{item.tags}}" wx:key="tag">{{item.name}}</text>
                </text>
              </view>
              <text class="product-desc" wx:if="{{item.description}}">{{item.description}}</text>
            </view>
            <view class="price-col">
              <!-- <text class="status-label">{{getDate.judgmentState(item.status)}}</text> -->
              <view class="price-row">
                <text class="price-symbol">¥</text>
                <text class="price-num">{{item.pointsPrice}}</text>
              </view>
              <text class="amount">x{{item.quantity}}</text>
              <text class="amount-price">¥{{item.pointsPrice * item.quantity}}</text>
            </view>
          </view>
          <view class='card-order' wx:if="{{item.deliveryTime}}">
             <view class="product-desc-time fr" catchtap="handleCopy" data-number="{{item.courierNumber}}" wx:if="{{item.courierNumber}}">
              {{item.courierCompanyName}} {{item.courierNumber}} | 复制
            </view>
            <view>
                发货时间：{{item.deliveryTime}}
            </view>
          </view>
          <view class="card-action" wx:if="{{item.status == 2 || item.status == 3}}"> 
            <view class="confirm-btn"  catchtap="orderChcek" wx:if="{{item.status == 2 }}" data-id="{{item.keyId}}">确认收货</view>
             <view class="confirm-btn" catchtap="goToComment" wx:if="{{!item.reviewed && item.status == 3}}" data-good="{{item.goodsId}}" data-id="{{item.keyId}}">
              去评价
            </view>
            <view class="confirm-btn" catchtap="goToReview" wx:if="{{item.reviewed && item.status == 3}}" data-id="{{item.goodsId}}">
              查看评价
            </view>
          </view>
        </view>
      </block>

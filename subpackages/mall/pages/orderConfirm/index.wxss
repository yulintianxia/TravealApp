page {
  background: #101010;
  color: #f5f2eb;
}

.confirm-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 36rpx 190rpx;
  background: linear-gradient(180deg, #111111 0%, #111111 58%, #1d2a35 100%);
}

.address-card,
.goods-card {
  background: #242424;
  border-radius: 24rpx;
}

.address-card {
  padding: 32rpx 36rpx 22rpx;
  margin-bottom: 48rpx;
}

.address-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.address-name {
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 600;
}

.address-phone,
.address-detail,
.default-label,
.order-note,
.remaining-row {
  color: #a0a0a0;
  font-size: 28rpx;
}

.address-phone {
  font-size: 30rpx;
}

.address-detail {
  margin-top: 20rpx;
  line-height: 1.55;
}

.address-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
}

.address-actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.address-button {
  width: 100rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 18rpx;
  color: #a7a7a7;
  font-size: 26rpx;
}

.section-title {
  display: block;
  margin: 0 24rpx 22rpx;
  color: #f5f2eb;
  font-size: 30rpx;
}

.goods-card {
  display: flex;
  padding: 28rpx 32rpx;
  margin-bottom: 18rpx;
}

.goods-image {
  width: 168rpx;
  height: 168rpx;
  flex-shrink: 0;
  background: #dedbd5;
}

.goods-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  margin-left: 26rpx;
}

.goods-name {
  color: #f4f0ea;
  font-size: 30rpx;
  line-height: 1.35;
}

.goods-meta {
  margin-top: 14rpx;
  color: #9b9b9b;
  font-size: 25rpx;
}

.goods-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
}

.goods-price,
.remaining-value {
  color: #f1d495;
  font-size: 32rpx;
}

.goods-count {
  color: #eeeeee;
  font-size: 28rpx;
}

.order-note {
  margin: 28rpx 0 0;
  text-align: right;
}

.remaining-row {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 18rpx;
  margin-top: 34rpx;
}

.confirm-bar {
  position: fixed;
  left: 36rpx;
  right: 36rpx;
  bottom: 28rpx;
  height: 112rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx 0 34rpx;
  box-sizing: border-box;
  border-radius: 24rpx;
  background: #1f1f1f;
}

.deduct-total {
  flex: 1;
  color: #9e9e9e;
  font-size: 25rpx;
  white-space: nowrap;
}

.deduct-total text {
  color: #f1d495;
  font-size: 34rpx;
}

.confirm-button {
  width: 164rpx;
  height: 74rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 38rpx;
  background: #c0a16a;
  color: #ffffff;
  font-size: 30rpx;
}

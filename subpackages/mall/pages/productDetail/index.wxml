<wxs module="getDate" src="./state.wxs"></wxs>
<view class="detail-page">
  <view class="tab-header">
    <view wx:for="{{tabs}}" wx:key="*this" class="tab-item {{activeTab === item ? 'active' : ''}}" data-tab="{{item}}" bindtap="onTabChange">
      {{item}}
    </view>
  </view>
  <view class="hero-gallery" id="anchor-product">
    <swiper class="hero-swiper" current="{{currentMediaIndex}}" indicator-dots="{{mediaList.length > 1}}" indicator-color="rgba(255, 255, 255, 0.45)" indicator-active-color="#f0d79a" bindchange="onMediaChange">
      <swiper-item wx:for="{{mediaList}}" wx:key="index">
        <image wx:if="{{item.type === 'image'}}" class="hero-image" src="{{item.url}}" mode="aspectFill"></image>
        <view wx:else class="video-wrap">
          <video id="product-video-{{index}}" class="hero-video" src="{{item.url}}" object-fit="cover" controls="{{true}}" show-center-play-btn="{{true}}" show-playback-rate="{{true}}" enable-progress-gesture="{{true}}"></video>
          <view class="speed-control" catchtap="toggleSpeedMenu">
            <text>{{videoSpeed}}x</text>
            <view wx:if="{{showSpeedMenu}}" class="speed-menu" catchtap="stopPropagation">
              <view wx:for="{{playbackRates}}" wx:key="*this" class="speed-option {{videoSpeed === item ? 'active' : ''}}" data-rate="{{item}}" catchtap="setVideoSpeed">{{item}}x</view>
            </view>
          </view>
        </view>
      </swiper-item>
    </swiper>
  </view>
  <view class='product-info-wrap'>
    <view class="product-info-block" id="anchor-product-info">
      <view class="price-row">
        <text class="price">{{product.pointsPrice}}积分{{product.goodsUnit? '/' + product.goodsUnit : ''}}
        </text>
         <text class='limitPerUser' wx:if='{{product.limitPerUser}}'>({{limitType}}/{{product.limitPerUser}}{{product.goodsUnit ? product.goodsUnit:'' }})</text>
        <text wx:if="{{purchaseLimits}}" class="purchase-limit">{{purchaseLimits}}</text>
        <text class="redeem">已兑换{{product.sales}}/{{product.stock +product.sales}}</text>
      </view>
      <view class="product-title">{{product.name}}</view>
      <view class="review-tags" wx:if="{{tags.length}}">
        <text wx:for="{{tags}}" wx:key="*this" :key='item.name'>{{item.name}}</text>
      </view>
      <view class="product-explain {{descriptionExpanded ? 'expanded' : ''}}">{{product.description || ''}}</view>
      <view wx:if="{{descriptionLong}}" class="explain-toggle" bindtap="toggleDescription">
        {{descriptionExpanded ? '收起' : '展开'}}
      </view>
    </view>
    <view class="shipping-row" bindtap="goAddressList">
      <text class="shipping-text shopping-send">发货</text>
      <text class="shipping-text">承诺{{product.deliveryHours || 48}}{{product.deliveryUnit =='hours' ? '小时':'天' }}内发货</text>
      <text class="shipping-text right">{{delivery}}</text>
      <text class="arrow">›</text>
    </view>
    <view class="review-box" id="anchor-review" bindtap="goReviewPage">
      <view class="review-title">商品评价({{totalReviews}})</view>
      <view class="review-card" wx:if="{{totalReviews>0}}" >
        <image class="review-avatar" src="{{ reviewListOne.isAnonymous == 1 &&reviewListOne.avatar ?  baseUrl + reviewListOne.avatar : '../../../../images/home/default.png'}}" mode="aspectFill"></image>
        <view class="review-content">
          <view class="review-name">{{reviewListOne.isAnonymous == 1 ? '匿名用户' : (reviewListOne.nickName || reviewListOne.createBy || '用户')}}</view>
          <view class="review-text">{{reviewListOne.content}}</view>
          <view class="review-text" wx:if="{{reviewListOne.quantity}}">
            已购：{{product.name}}{{reviewListOne.quantity }}双，发货于{{deliveryTime || ''}}前
          </view>
        </view>
      </view>
      <view class="review-card-no" wx:if="{{totalReviews === 0}}">暂无评价</view>
    </view>
    <view class="spec-block" id="anchor-detail">
      <view class="spec-title">商品详情</view>
      <view class="spec-table">
        <block wx:for="{{specs}}" wx:key="index">
          <view class="spec-row">
            <view class="spec-key">{{item.key}}</view>
            <view class="spec-val">{{item.value}}</view>
          </view>
        </block>
      </view>
    </view>
    <block wx:if="{{getDate.formatePictursList(product.pictures).length}}">
      <view class='product-detail' hover-class="none" wx:for="{{getDate.formatePictursList(product.pictures)}}" wx:key="index">
        <image src="{{item}}" mode="widthFix" />
      </view>
    </block>
  </view>
  <view class="bottom-nav">
    <view class="nav-item" bindtap="goMarket">
      <image class="nav-icon" src="/images/home/ho.png" mode="aspectFit"></image>
      <text>首页</text>
    </view>
    <view class="nav-item" bindtap="openCustomerService">
      <image class="nav-icon" src="/images/home/user.png" mode="aspectFit"></image>
      <text>客服</text>
    </view>
    <view class="nav-item cart-item" bindtap="goCart">
      <image class="nav-icon" src="/images/home/22.png" mode="aspectFit"></image>
      <text>购物车</text>
      <view class="badge" wx:if="{{cartCount > 0}}">{{cartCount}}</view>
    </view>
    <view class="nav-item" bindtap="openMicroStore">
      <image class="nav-icon" src="/images/home/dian.png" mode="aspectFit"></image>
      <text>微店</text>
    </view>
    <view class="buy-area" bindtap="addToCart">加入购物车</view>
    <view class="checkout-button" bindtap="exchange">兑换</view>
  </view>
  <view wx:if="{{showCustomerDialog}}" class="customer-overlay" bindtap="closeCustomerService">
    <view class="customer-dialog" catchtap="stopPropagation">
      <view class="customer-panel">
        <image class="customer-qr" src="{{chatImg}}" mode="aspectFit"></image>
        <view class="customer-text">添加客服微信</view>
        <view class="customer-confirm" bindtap="closeCustomerService">知道了</view>
      </view>
    </view>
  </view>
  <view wx:if="{{showExchangeDialog}}" class="customer-overlay" bindtap="closeExchangeDialog">
    <view class="exchange-dialog" catchtap="stopPropagation">
      <view class="exchange-panel">
        <view class="exchange-title">确认兑换数量</view>
        <view class="exchange-product-name">{{product.name}}</view>
        <view class="exchange-quantity-row">
          <text class="exchange-quantity-label">兑换数量</text>
          <view class="stepper">
            <view class="step-btn minus" data-type="minus" catchtap="changeExchangeQuantity">-</view>
            <view class="step-value">{{exchangeQuantity}}</view>
            <view class="step-btn plus" data-type="plus" catchtap="changeExchangeQuantity">+</view>
          </view>
        </view>
        <view class="exchange-actions">
          <view class="exchange-cancel" bindtap="closeExchangeDialog">取消</view>
          <view class="exchange-confirm" bindtap="confirmExchange">确定</view>
        </view>
      </view>
    </view>
  </view>
</view>


<view wx:if="{{showProductTop}}" class='product-top' bindtap='onTabChangeProduct'>
  <image class="nav-icon" src="/images/icons/tops.png" mode="aspectFit"></image>
</view>
page {
  background: #101010;
  color: #f5f2eb;
}

.detail-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 36rpx 180rpx;
  background: linear-gradient(180deg, #111111 0%, #111111 58%, #1d2a35 100%);
}

.state-text {
  padding-top: 240rpx;
  color: rgba(255, 255, 255, 0.6);
  font-size: 30rpx;
  text-align: center;
}
.chip {
  display: block;
  box-sizing: border-box;
  flex-shrink: 1;
  width: 100rpx;
  height: 34rpx;
  padding: 0 6rpx;
  border-radius: 10rpx;
  background: rgba(153, 145, 125, 1);
  border: 1rpx solid rgba(210, 170, 88, 0.35);
  color: rgba(247, 247, 247, 1);
  font-size: 20rpx;
  line-height: 28rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: center;
  float:right;
  margin-left:10rpx;
}
.goods-card,
.info-card {
  background: #242424;
  border-radius: 24rpx;
}

.goods-card {
  display: flex;
  padding: 28rpx 32rpx;
}

.goods-image {
  width: 168rpx;
  height: 168rpx;
  flex-shrink: 0;
  /* background: #dedbd5; */
}

.goods-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  margin-left: 26rpx;
}

.goods-name {
  display: -webkit-box;
  overflow: hidden;
  color: #f4f0ea;
  font-size: 30rpx;
  line-height: 1.4;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.goods-description,
.goods-meta {
  display: -webkit-box;
  margin-top: 12rpx;
  overflow: hidden;
  color: #9b9b9b;
  font-size: 25rpx;
  line-height: 1.4;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.goods-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
  padding-top: 16rpx;
}

.goods-price {
  color: #f1d495;
  font-size: 30rpx;
}

.goods-count {
  color: #eeeeee;
  font-size: 28rpx;
}

.section-title {
  margin: 42rpx 14rpx 20rpx;
  color: #f5f2eb;
  font-size: 30rpx;
  font-weight: 600;
}

.info-card {
  padding: 10rpx 32rpx;
}

.info-row {
  display: flex;
  align-items: center;
  min-height: 82rpx;
  gap: 20rpx;
}

.info-label {
  width: 160rpx;
  flex-shrink: 0;
  color: #a0a0a0;
  font-size: 28rpx;
}

.info-value-copy {
  display: flex;
  flex: 1;
  min-width: 0;
  align-items: center;
  justify-content: flex-end;
  gap: 14rpx;
}

.info-value {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #eeeeee;
  font-size: 27rpx;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-number,
.courier-number {
  color: #f0ece5;
}

.copy-button {
  flex-shrink: 0;
  padding: 12rpx 22rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 16rpx;
  color: #b9b9b9;
  font-size: 24rpx;
}

.address-value {
  padding: 22rpx 0 12rpx;
  color: #c6c6c6;
  font-size: 27rpx;
  line-height: 1.6;
}

.bottom-actions {
  display: flex;
  justify-content: center;
  padding-top: 48rpx;
}

.action-button {
  width: 400rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #c9a96e, #a07c3f);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
}

.confirm-popup-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.65);
}

.confirm-popup {
  width: 580rpx;
  box-sizing: border-box;
  padding: 60rpx 48rpx 44rpx;
  background: rgba(30, 35, 50, 0.95);
  border: 1rpx solid rgba(201, 182, 126, 0.15);
  border-radius: 24rpx;
}

.confirm-popup-title {
  color: #f1d495;
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
}

.confirm-popup-text {
  margin-top: 28rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 28rpx;
  line-height: 1.6;
  text-align: center;
}

.confirm-popup-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 48rpx;
}

.confirm-popup-cancel,
.confirm-popup-submit {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  font-size: 30rpx;
  text-align: center;
}

.confirm-popup-cancel {
  color: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
}

.confirm-popup-submit {
  color: #ffffff;
  font-weight: 600;
  background: linear-gradient(135deg, #c9a96e, #a07c3e);
}

/* pages/newLogin/index.wxss */

.login-page {
  min-height: 100vh;
  width: 100vw;
  background: linear-gradient(180deg, #0a0f1a 0%, #0f1b30 50%, #0b1a2e 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  font-family: PingFang SC, -apple-system, Helvetica Neue, Arial, sans-serif;
}

/* ========== Logo 区域 ========== */
.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 160rpx;
}

.logo-img {
  width: 200rpx;
  height: 200rpx;
}

.logo-brand {
  margin-top: 24rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: #c9a96e;
  letter-spacing: 8rpx;
}

.logo-since {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #c9a96e;
  letter-spacing: 6rpx;
}

/* ========== 按钮区域 ========== */
.btn-section {
  margin-top: 180rpx;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.wx-login-btn {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 560rpx;
  height: 96rpx;
  background: #07c160;
  border-radius: 16rpx;
  border: none;
  padding: 0;
  margin: 0;
  line-height: 96rpx;
}

.wx-login-wrapper {
  position: relative;
  width: 560rpx;
}

.wx-login-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 10;
}

.wx-login-btn::after {
  border: none;
}

.wx-icon {
  width: 44rpx;
  height: 44rpx;
  margin-right: 16rpx;
}

.wx-login-btn text {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
}

.phone-login-link {
  margin-top: 40rpx;
  font-size: 28rpx;
  color: #c9a96e;
  letter-spacing: 2rpx;
}

/* ========== 协议区域 ========== */
.agreement-section {
  margin-top: 60rpx;
  width: 100%;
  display: flex;
  justify-content: center;
}

.agreement-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-wrap: wrap;
  justify-content: center;
}

.agreement-check {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.35);
  margin-right: 12rpx;
  box-sizing: border-box;
  position: relative;
}

.agreement-check.checked {
  background: #c9a96e;
  border-color: #c9a96e;
}

.agreement-check.checked::after {
  content: '✓';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 20rpx;
  color: #fff;
  line-height: 1;
}

.agreement-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

.agreement-link {
  font-size: 24rpx;
  color: #5b9bd5;
}

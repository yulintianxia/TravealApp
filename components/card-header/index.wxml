<view class="card-title">{{title}}</view>
<view class="card-sub-title">{{subTitle}}</view>
<view class="discounts">
    <image src="{{staticBaseUrl+'/discounts-bg.svg'}}"></image>
    <view class="money">
        <text class="unit">¥</text>
        <text class="value">{{discountsNumber}}</text>
    </view>
    <view class="description">{{discountsDescription}}</view>
</view>

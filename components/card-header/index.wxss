.card-title {
  margin-bottom: 8rpx;
}
.discounts {
  box-sizing: border-box;
  height: 96rpx;
  padding-top: 8rpx;
  position: absolute;
  right: 22rpx;
  text-align: center;
  top: 0;
  width: 152rpx;
}
.discounts > image {
  height: 100%;
  left: 0;
  position: absolute;
  top: 0;
  width: 100%;
}
.discounts .money {
  display: inline-block;
  height: 40rpx;
  line-height: 40rpx;
  position: relative;
}
.discounts .money .unit {
  color: #de1c24;
  font-size: 22rpx;
  font-weight: 400;
  left: -2rpx;
  line-height: 46rpx;
  position: absolute;
  transform: translateX(-100%);
}
.discounts .money .value {
  color: #de1c24;
  display: inline-block;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 40rpx;
}
.discounts .description {
  color: #4f5356;
  font-size: 20rpx;
  font-weight: 400;
  line-height: 28rpx;
}

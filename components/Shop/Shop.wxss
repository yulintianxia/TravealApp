.container {
  width: 100%;
  height: 100%;
}

.address {
  padding-top: 40px;
  border-bottom: 1px solid rgb(233, 229, 229);
}

.goods {
  width: 100%;
  display: flex;
  padding: 10px;
  box-sizing: border-box;
  margin-top: 10px;
}

.goods-img {
  width: 80px;
  height: 80px;
  border-radius: 10px;
  margin-right: 30px;
}

.goods-explain {
  display: flex;
  justify-content: space-between;
  flex-direction: column;
}

.goods-explain .title {
  font-size: 12px;
  color: black;
}

.pay-point {
  color: red;
  font-size: 12px;
}

.pay-point span {
  font-weight: 600;
  font-size: 16px;
}

.footer {
  color: white;
  width: 100%;
  height: 50px;
  position: fixed;
  bottom: 0;
  font-size: 16px;
  line-height: 50px;
  margin: 0 auto;
  margin-top: 1px solid rgb(233, 229, 229);
}

.footer div {
  text-align: center;
  width: 98%;
  margin: 0 auto;
  border-radius: 14px;
  background: #FF4500;
}

.address-title {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
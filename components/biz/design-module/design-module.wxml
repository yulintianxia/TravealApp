<scroll-view class="scroll-view" scrollIntoView="{{intoViewId}}" scrollY="{{true}}" style="padding-bottom:{{paddingBottom}}; padding-top:{{!firstComponentIsMultiColumn&&!haveSwiper&&!showBack?paddingTop:0}};">
    <view class="{{item.anchorContent.id&&'anchor-class'}}" data-anchorId="{{item.anchorContent.id}}" id="ac{{item.anchorContent.id}}" wx:for="{{moduleConfig}}" wx:key="index">
        <title extModuleData="{{extModuleData[item.moduleId]||[]}}" mode="{{mode}}" moduleConfig="{{item}}" moduleData="{{moduleData[item.moduleId]||[]}}" wx:if="{{item.moduleSign==='titleModule'}}"></title>
        <separator extModuleData="{{extModuleData[item.moduleId]||[]}}" mode="{{mode}}" moduleConfig="{{item}}" moduleData="{{moduleData[index]||[]}}" wx:elif="{{item.moduleSign==='separatorModule'}}"></separator>
        <decoration-swiper extModuleData="{{extModuleData[item.moduleId]||[]}}" mode="{{mode}}" moduleConfig="{{item}}" moduleData="{{item}}" moduleId="{{item.moduleId}}" position="{{index+1}}" wx:elif="{{item.moduleSign==='sliderModule'}}"></decoration-swiper>
        <address-swiper extModuleData="{{extModuleData[item.moduleId]||[]}}" mode="{{mode}}" moduleConfig="{{item}}" moduleData="{{item}}" moduleId="{{item.moduleId}}" number="{{index}}" position="{{index+1}}" showWhite="{{showWhite}}" wx:elif="{{item.moduleSign==='miniProgramSliderModule'}}"></address-swiper>
        <hot-zone extModuleData="{{extModuleData[item.moduleId]||[]}}" mode="{{mode}}" moduleConfig="{{item}}" moduleData="{{moduleData[item.moduleId]||[]}}" position="{{index+1}}" wx:elif="{{item.moduleSign==='hotZoneModule'}}"></hot-zone>
        <image-ads extModuleData="{{extModuleData[item.moduleId]||[]}}" mode="{{mode}}" moduleConfig="{{item}}" moduleData="{{moduleData[item.moduleId]||[]}}" position="{{index+1}}" wx:elif="{{item.moduleSign==='imageAdsModule'}}"></image-ads>
        <recommend-goods androidReachBottom="{{androidReachBottom}}" bind:addPageScrollListner="addPageScrollListner" bindgetGoodsNum="getGoodsNum" extModuleData="{{extModuleData[item.moduleId]||[]}}" haveHeader="{{haveHeader}}" haveSwiper="{{haveSwiper}}" mode="{{mode}}" moduleConfig="{{item}}" moduleData="{{moduleData[index]}}" position="{{index+1}}" requestNextCategoryCount="{{requestNextCategoryCount}}" showBack="{{showBack}}" wx:elif="{{item.moduleSign==='recommendGoodsModule'}}"></recommend-goods>
        <goods bindgetGoodsNum="getGoodsNum" bindrefreshComponent="refreshComponent" extModuleData="{{extModuleData[item.moduleId]||[]}}" mode="{{mode}}" moduleConfig="{{item}}" moduleData="{{moduleData[index]}}" position="{{index+1}}" wx:elif="{{item.moduleSign==='goodsModule'}}"></goods>
        <decoration-coupon bgColor="{{bgColor}}" extModuleData="{{extModuleData[item.moduleId]||[]}}" mode="{{mode}}" moduleConfig="{{item}}" moduleData="{{moduleData[index]}}" position="{{index+1}}" wx:elif="{{item.moduleSign==='couponModule'}}"></decoration-coupon>
        <rich-text extModuleData="{{extModuleData[item.moduleId]||[]}}" mode="{{mode}}" moduleConfig="{{item}}" moduleData="{{moduleData[item.moduleId]}}" wx:elif="{{item.moduleSign==='richTextModule'}}"></rich-text>
        <news-express extModuleData="{{extModuleData[item.moduleId]||[]}}" mode="{{mode}}" moduleConfig="{{item}}" moduleData="{{moduleData[item.moduleId]}}" wx:elif="{{item.moduleSign==='newsExpressModule'}}"></news-express>
        <divider extModuleData="{{extModuleData[item.moduleId]||[]}}" mode="{{mode}}" moduleConfig="{{item}}" moduleData="{{moduleData[item.moduleId]}}" wx:elif="{{item.moduleSign==='blankModule'}}"></divider>
        <custom-goods bindgetGoodsNum="getGoodsNum" extModuleData="{{extModuleData[item.moduleId]||[]}}" mode="{{mode}}" moduleConfig="{{item}}" moduleData="{{moduleData[item.moduleId]}}" position="{{index+1}}" wx:elif="{{item.moduleSign==='storeGoodsModule'}}"></custom-goods>
        <buy-card extModuleData="{{extModuleData[item.moduleId]||[]}}" mode="{{mode}}" moduleConfig="{{item}}" moduleData="{{moduleData[item.moduleId]}}" position="{{index+1}}" wx:elif="{{item.moduleSign==='buyCardModule'}}"></buy-card>
        <product-ad bindgetGoodsNum="getGoodsNum" extModuleData="{{extModuleData[item.moduleId]||[]}}" mode="{{mode}}" moduleConfig="{{item}}" moduleData="{{moduleData[item.moduleId]}}" position="{{index+1}}" wx:elif="{{item.moduleSign==='goodsAdsImgModule'}}"></product-ad>
        <rank-goods bindgetGoodsNum="getGoodsNum" extModuleData="{{extModuleData[item.moduleId]||[]}}" mode="{{mode}}" moduleConfig="{{item}}" moduleData="{{moduleData[item.moduleId]}}" position="{{index+1}}" wx:elif="{{item.moduleSign==='rankTopModule'}}"></rank-goods>
        <series extModuleData="{{extModuleData[item.moduleId]||[]}}" mode="{{mode}}" moduleConfig="{{item}}" moduleData="{{moduleData[item.moduleId]}}" position="{{index+1}}" wx:elif="{{item.moduleSign==='seriesModule'}}"></series>
        <navigation extModuleData="{{extModuleData[item.moduleId]||[]}}" mode="{{mode}}" moduleConfig="{{item}}" moduleData="{{moduleData[item.moduleId]}}" position="{{index+1}}" wx:elif="{{item.moduleSign==='imageTextNavigationModule'}}"></navigation>
        <money-saving-calculator extModuleData="{{extModuleData[item.moduleId]||[]}}" mode="{{mode}}" moduleConfig="{{item}}" moduleData="{{moduleData[item.moduleId]}}" position="{{index+1}}" wx:elif="{{item.moduleSign==='saveMoneyCounterModule'}}"></money-saving-calculator>
        <beancurd-cube extModuleData="{{extModuleData[item.moduleId]||[]}}" mode="{{mode}}" moduleConfig="{{item}}" moduleData="{{moduleData[item.moduleId]}}" position="{{index+1}}" wx:elif="{{item.moduleSign==='tofuCubeModule'}}"></beancurd-cube>
        <timing bindclickGoodsList="onClickGoodsList" extModuleData="{{extModuleData[item.moduleId]||[]}}" mode="{{mode}}" moduleConfig="{{item}}" moduleData="{{moduleData[item.moduleId]}}" position="{{index+1}}" wx:elif="{{item.moduleSign==='seasonModule'}}"></timing>
        <classify-goods bindgetGoodsNum="getGoodsNum" extModuleData="{{extModuleData[item.moduleId]||[]}}" mode="{{mode}}" moduleConfig="{{item}}" moduleData="{{moduleData[item.moduleId]}}" position="{{index+1}}" wx:elif="{{item.moduleSign==='classifyGoodsModule'}}"></classify-goods>
        <multiple-columns extModuleData="{{extModuleData[item.moduleId]||[]}}" mode="{{mode}}" moduleConfig="{{item}}" moduleData="{{item}}" moduleId="{{item.moduleId}}" position="{{index+1}}" wx:elif="{{item.moduleSign==='multipleColumnsModule'}}"></multiple-columns>
        <comment-module bindgetGoodsNum="getGoodsNum" extModuleData="{{extModuleData[item.moduleId]||[]}}" mode="{{mode}}" moduleConfig="{{item}}" moduleData="{{moduleData[index]}}" position="{{index+1}}" wx:elif="{{item.moduleSign==='commentModule'}}"></comment-module>
        <scene-module bindgetGoodsNum="getGoodsNum" extModuleData="{{extModuleData[item.moduleId]||[]}}" mode="{{mode}}" moduleConfig="{{item}}" moduleData="{{moduleData[index]}}" position="{{index+1}}" wx:elif="{{item.moduleSign==='sceneMarketModule'}}"></scene-module>
        <view class="sticky-wrapper" style="{{isFixed?'padding:0':'padding:0 24rpx'}}" wx:elif="{{item.moduleSign==='locationModule'&&item.bizStyle.locationType==='3'}}">
            <t-sticky bindscroll="stickyScroll" offsetTop="{{offsetTop}}">
                <new-anchor currentAnchorId="{{anchorId}}" isFixed="{{isFixed}}" moduleConfig="{{item}}" position="{{index+1}}"></new-anchor>
            </t-sticky>
        </view>
        <view class="suspension-wrapper" wx:elif="{{item.moduleSign==='bottomSuspendModule'}}">
            <suspension moduleConfig="{{item}}" position="{{index+1}}"></suspension>
        </view>
        <new-calendar moduleConfig="{{item}}" moduleData="{{item}}" moduleId="{{item.moduleId}}" position="{{index+1}}" wx:elif="{{item.moduleSign==='newCalendarModule'}}"></new-calendar>
        <yellow-label-goods moduleConfig="{{item}}" moduleData="{{item}}" moduleId="{{item.moduleId}}" position="{{index+1}}" wx:elif="{{item.moduleSign==='yellowLabelModule'}}"></yellow-label-goods>
        <top-header address="{{address}}" goodNum="{{goodNum}}" moduleConfig="{{item}}" moduleData="{{item}}" moduleId="{{item.moduleId}}" position="{{index+1}}" showWhite="{{showWhite}}" wx:elif="{{item.moduleSign==='miniStoreTopModule'}}"></top-header>
        <location moduleConfig="{{item}}" moduleData="{{item}}" moduleId="{{item.moduleId}}" position="{{index+1}}" wx:elif="{{item.moduleSign==='geographicalLocationModule'}}"></location>
        <floating-window moduleConfig="{{item}}" moduleData="{{item}}" moduleId="{{item.moduleId}}" position="{{index+1}}" wx:elif="{{item.moduleSign==='floatingWindowModule'}}"></floating-window>
    </view>
    <view>
        <slot name="attach"></slot>
    </view>
</scroll-view>
<goods-animation goodsThumb="{{goodsThumb}}" id="goods-animation" pageType="decoration"></goods-animation>
<view wx:if="{{item.moduleSign==='locationModule'&&(item.bizStyle.locationType==='1'||item.bizStyle.locationType==='2')}}" wx:for="{{moduleConfig}}" wx:key="index">
    <anchor bindchange="changePadding" extModuleData="{{extModuleData[item.moduleId]||[]}}" mode="{{mode}}" moduleConfig="{{item}}" moduleData="{{moduleData[item.moduleId]}}" position="{{index+1}}" title=" {{language==='EN'?pageConfig.title.en:pageConfig.title.zh}}"></anchor>
</view>
<t-navbar background="{{showWhite?'#fff':'transparent'}}" class="custom-nav {{showWhite?'':'nav-mask'}}" delta="0" leftIcon="slot" title="slot" wx:if="{{haveSwiper}}">
    <view bind:tap="handleSelectAddress" class="nav-left" slot="left-icon" style="color: {{showWhite?'#222427':'#fff'}}">
        <text class="nav-left-icon" style="background-image:url({{showWhite?addressTopIcon:addressTopIconWhite}})"></text>
        <text class="line" style="background: {{showWhite?'#acb1b6':'#fff'}}"></text> 送至: {{address}} <text class="down-arrow" style="background-image:url({{downArrow}})"></text>
    </view>
    <view class="nav-right" slot="title">
        <view bind:tap="handleToCar" class="cart-icon" style="background-image: url({{showWhite?cartIcon:cartIconWhite}})">
            <goods-num-dot goodsNum="{{goodNum}}" goodsNumAnimationVisible="{{goodsNumAnimationVisible}}"></goods-num-dot>
        </view>
    </view>
</t-navbar>
<t-navbar background="rgba(255,255,255,{{navOpactiy}})" bind:go-back="goBack" class="immerse-nav" delta="0" leftIcon="slot" title="slot" wx:elif="{{pageConfig.externJson.styleMode==='2'&&!haveHeader}}">
    <t-icon class="left-icon-back" name="chevron-left" slot="left-icon" wx:if="{{isDecoration}}"></t-icon>
    <image class="immerse-slot-title-bg" slot="title" src="{{language==='EN'?pageConfig.externJson.titleImageEn:pageConfig.externJson.titleImage}}" wx:if="{{showTitleImage}}"></image>
    <view class="immerse-slot-title" slot="title" wx:elif="{{showTextTitle}}"> {{language==='EN'?pageConfig.title.en:pageConfig.title.zh}} </view>
</t-navbar>
<t-navbar background="#fff" bind:go-back="goBack" class="default-nav" delta="0" leftIcon="slot" title="slot" wx:elif="{{!haveSwiper&&!showBack&&!haveHeader}}">
    <t-icon class="left-icon-back" name="chevron-left" slot="left-icon" wx:if="{{isDecoration}}"></t-icon>
    <view class="slot-title" slot="title"> {{language==='EN'?pageConfig.title.en:pageConfig.title.zh}} </view>
</t-navbar>
<goods-popup bindcloseWindow="closeWindow" componentTitle="{{addCartConfig.componentTitle}}" dataList="{{addCartList}}" index="{{addCartConfig.swiperIndex}}" pageContentId="{{addCartConfig.pageContentId}}" pageModuleAdvertiserId="{{addCartConfig.pageModuleAdvertiserId}}" pageModuleId="{{addCartConfig.pageModuleId}}" pageTitle="{{addCartConfig.pageTitle}}" pageType="{{addCartConfig.pageType}}" richStoreList="{{addCartConfig.richStoreList}}" sortIndex="{{addCartConfig.sortIndex}}" tab="{{addCartConfig.tab}}" title="{{addCartConfig.title}}" visible="{{addCartPopUp}}"></goods-popup>
<wxs module="i18n" src="../../../i18n/locales.wxs"/>
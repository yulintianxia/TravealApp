.swiper-container {
  background-repeat: no-repeat;
  background-size: cover;
  overflow: hidden;
  position: relative;
}
.swiper-container .wr-swiper__content {
  margin: 0-12rpx;
}
.swiper-container.mode_1 .wr-swiper__tip {
  border-radius: 20rpx;
  bottom: 24rpx;
  font-size: 30rpx;
  font-weight: 700;
  height: 40rpx;
  line-height: 40rpx;
  right: 24rpx;
  width: 72rpx;
}
.swiper-container.mode_1 .wr-swiper__tip--bg {
  background-color: #000;
  opacity: 0.4;
}
.swiper-container.mode_2 .wr-swiper__dot--item {
  background-color: #7c7864;
  border-radius: 10rpx;
  font-size: 0;
  height: 10rpx;
  margin: 0 12rpx;
  width: 10rpx;
}
.swiper-container.mode_2 .wr-swiper__dot--active {
  background-color: #fff;
}
.swiper-container.mode_3 .wr-swiper__dot--item {
  background-color: hsla(0, 0%, 100%, 0);
  border-radius: 4rpx;
  color: #dc7e2d;
  color: #7c7864;
  margin: 0 12rpx;
}
.swiper-container.mode_3 .wr-swiper__dot--active {
  background-color: #fff;
}
.swiper-container.mode_4 .wr-swiper__direction {
  position: absolute;
  top: 50%;
  width: 100%;
}
.swiper-container.mode_4 .wr-swiper__direction--left,
.swiper-container.mode_4 .wr-swiper__direction--right {
  background-color: #000;
  border-radius: 32rpx;
  color: #fff;
  float: left;
  height: 32rpx;
  margin-left: 20rpx;
  opacity: 0.5;
  width: 32rpx;
}
.swiper-container.mode_4 .wr-swiper__direction--right {
  float: right;
  margin-right: 20rpx;
}
@import "/styles/init.wxss";
.goods-price {
  color: #fff;
  font-size: 20rpx;
}
.goods-price .integer {
  font-size: 28rpx;
}
.cart-icon {
  background-size: 44rpx 44rpx;
  display: block;
  height: 44rpx;
  margin-top: 10rpx;
  position: relative;
  width: 44rpx;
}
.cart-icon .good-num {
  background: #e5100b;
  border-radius: 16rpx;
  color: #fff;
  display: block;
  font-size: 22rpx;
  font-weight: 500;
  height: 32rpx;
  line-height: 32rpx;
  position: absolute;
  right: -16rpx;
  text-align: center;
  top: -10rpx;
  width: 32rpx;
}
.nav-left {
  font-size: 32rpx;
  line-height: 88rpx;
  overflow: hidden;
  padding-right: 40rpx;
  position: relative;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.nav-left .nav-left-icon {
  background-size: cover;
  float: left;
  height: 40rpx;
  margin-right: 32rpx;
  margin-top: 24rpx;
  width: 48rpx;
}
.nav-left .line {
  bottom: 26rpx;
  height: 36rpx;
  left: 64rpx;
  width: 2rpx;
}
.nav-left .down-arrow,
.nav-left .line {
  display: -webkit-flex;
  display: flex;
  position: absolute;
}
.nav-left .down-arrow {
  background-size: cover;
  bottom: 34rpx;
  height: 18rpx;
  right: 16rpx;
  width: 18rpx;
}
.custom-nav {
  position: fixed;
  z-index: 997;
}
.custom-nav .t-navbar__content {
  box-sizing: initial;
}
.custom-nav .t-navbar__content .t-navbar__left {
  flex: 1;
}
.custom-nav .t-navbar__content .t-navbar__center {
  flex: initial;
  height: 44rpx;
  margin-right: 30rpx;
  overflow: initial;
  position: static;
  width: 44rpx;
}
.custom-nav.nav-mask .navigation-bar__inner {
  background: linear-gradient(180deg, #000, transparent) !important;
}
.default-nav .t-navbar__content {
  box-sizing: initial;
}
.immerse-nav {
  --immerse-navbar-right: 94rpx;
}
.immerse-nav .t-navbar__content {
  box-sizing: initial;
}
.immerse-nav .t-navbar__content .t-navbar__left {
  width: var(--immerse-navbar-right) !important;
}
.immerse-nav .t-navbar__content .t-navbar__center {
  justify-content: flex-start;
  left: var(--immerse-navbar-right) !important;
  width: calc(
    100% - var(--navbar-right) - var(--immerse-navbar-right)
  ) !important;
}
.immerse-nav .t-navbar__content .t-navbar__center .immerse-slot-title-bg {
  height: 72rpx;
  width: 416rpx;
}
.immerse-nav .t-navbar__content .t-navbar__center .immerse-slot-title {
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  display: -webkit-box;
  height: 100%;
  margin-left: calc(var(--navbar-right) - var(--immerse-navbar-right));
  overflow: hidden;
  text-overflow: ellipsis;
  width: calc(100% - var(--immerse-navbar-right) * 2) !important;
  word-break: break-all;
}
.sticky-wrapper {
  box-sizing: border-box;
}
.sticky-wrapper .t-sticky__content {
  width: 100%;
}

<error-overlay autoRefresh="{{autoRefresh}}" bind:network-connect="bindNetworkConnect" bind:network-unconnect="bindNetworkUnconnect" bind:refresh="bindRefresh" customClass="error-overlay-class" refreshName="{{refreshName}}" route="{{route}}" tabbar="{{tabbar}}" zIndex="{{1000}}"></error-overlay>
<t-dialog id="t-dialog"></t-dialog>
<t-toast class="sams-t-toast" id="t-toast"></t-toast>
<auth-popup class="pop-index" id="auth-popup" phoneNeedAgree="{{phoneNeedAgree}}"></auth-popup>
<image class="fix-full skeleton-image skeleton-class" lazyLoad="false" mode="widthFix" src="{{skeletonUrl}}" wx:if="{{loading&&skeletonUrl}}"></image>
<view catchtouchmove="{{loading}}" class="fix-full loading-box loading-class" style="background-color:{{skeletonUrl?'transparent':'#fff'}}" wx:if="{{loading}}">
    <view class="swing-spinner"></view>
</view>
<view class="tabbar-line" wx:if="{{tabbar}}"></view>
<view class="empty-box fix-full empty-class" wx:if="{{emptyInfo&&emptyInfo.tip}}">
    <image class="empty-image" mode="widthFix" src="{{emptyInfo.icon}}"></image>
    <text class="empty-text">{{emptyInfo.tip}}</text>
    <button bind:tap="bindEmptyButtonTap" class="empty-button" hoverClass="empty-button-hover" wx:if="{{buttonText}}">
        {{buttonText}}
    </button>
</view>
<favorites-tip id="favorites-tip"></favorites-tip>
<view style="visibility:hidden;position:fixed;z-index:-999;width: 0;height:0">
    <canvas canvasId="tdcanvas" style="visibility:hidden;position:fixed;z-index:-999;width: 0;height:0"></canvas>
</view>
<agreement-popup id="agreement-popup" wx:if="{{isNeedAgreementPop}}"></agreement-popup>
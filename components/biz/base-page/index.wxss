.tabbar-line{background-color:#eee;bottom:0;height:1rpx;position:fixed;width:100%;z-index:9999}.pop-index{position:relative;z-index:99999}.loading-box,.skeleton-image{width:100%;z-index:999}.loading-box{justify-content:center}.empty-box,.loading-box{align-items:center;display:-webkit-flex;display:flex}.empty-box{background-color:#f5f5f5;flex-direction:column;padding-top:356rpx;z-index:10}.empty-box .empty-image{width:240rpx}.empty-box .empty-text{color:#999;font-size:28rpx;line-height:40rpx;margin:40rpx 0 60rpx}.empty-box .empty-button{border:2rpx solid #fa550f;border-radius:8rpx;color:#fa550f;display:inline-block;font-size:28rpx;font-weight:500;line-height:40rpx;margin:0 auto;padding:18rpx 106rpx}.empty-box .empty-button-hover{background-color:#fff}.fix-full{bottom:0;left:0;position:fixed;right:0;top:0}.swing-spinner{height:100vh;position:fixed;width:100vw}.swing-spinner::after,.swing-spinner::before{animation:member-loading 1.2s linear infinite;animation-delay:-.3s;background-color:#1a8fd3;content:" ";display:block;height:48rpx;left:calc(50% - 24rpx);position:fixed;top:calc(50% - 24rpx);width:48rpx}.swing-spinner::after{animation-delay:-.9s;background-color:#519526}@-webkit-keyframes member-loading{0%{opacity:1;transform:translate(0) rotate(45deg) scale(1)}25%{transform:translate(60%) rotate(45deg) scale(.66)}50%{opacity:.5;transform:translate(0) rotate(45deg) scale(0)}75%{transform:translate(-60%) rotate(45deg) scale(.66)}100%{opacity:1;transform:translate(0) rotate(45deg) scale(1)}}@keyframes member-loading{0%{opacity:1;transform:translate(0) rotate(45deg) scale(1)}25%{transform:translate(60%) rotate(45deg) scale(.66)}50%{opacity:.5;transform:translate(0) rotate(45deg) scale(0)}75%{transform:translate(-60%) rotate(45deg) scale(.66)}100%{opacity:1;transform:translate(0) rotate(45deg) scale(1)}}
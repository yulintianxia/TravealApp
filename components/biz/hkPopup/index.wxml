<t-popup closeOnOverlayClick="{{false}}" placement="center" visible="{{show}}">
    <view slot="content">
        <view class="warp {{type==='hk'?'':'mo'}}">
            <image class="tip-icon" src="{{icon}}"></image>
            <view class="title">{{showTitle}}</view>
            <view class="content">
                <block wx:if="{{type==='hk'}}">{{i18n.t('hkPopup.content',$_locale)}}</block>
                <block wx:else>{{content}}</block>
            </view>
            <view bind:tap="handleClosePopup" class="close">{{i18n.t('hkPopup.btn.switch',$_locale)}}</view>
        </view>
    </view>
</t-popup>
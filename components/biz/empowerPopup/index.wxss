.root{border-radius:24rpx 24rpx 0 0;box-sizing:border-box;overflow:hidden;padding:0 24rpx calc(env(safe-area-inset-bottom) + 12rpx);position:relative;width:100%}.root.normal-bg{background:linear-gradient(180deg,#e2f3ff,#dff1ff)}.root.normal-bg .btn{background:#0165b8;color:#fff}.root.premium-bg{background:linear-gradient(180deg,#fde6d6,#fff2e4)}.root.premium-bg .btn{background:linear-gradient(169deg,#575149,#1c1612);color:#ffe6d2}.root .header{align-items:center;color:#222427;display:-webkit-flex;display:flex;font-size:32rpx;font-weight:500;justify-content:center;min-height:108rpx;position:relative}.root .body{background-color:#fff;border-radius:24rpx;margin-top:24rpx;overflow:hidden;padding:48rpx 24rpx;position:relative;z-index:1}.root .body .agreement-line{align-items:center;display:-webkit-flex;display:flex;margin-bottom:32rpx}.root .body .agreement-line:last-child{margin:0}.root .body .agreement-line .icon-selected{height:32rpx;margin-right:12rpx;width:32rpx}.root .body .agreement-line .agreement-text{color:#4f5356;flex:1;font-size:24rpx;font-weight:400}.root .body .agreement-line .agreement-text view{display:inline}.root .body .agreement-line .agreement-text .highlight{color:#005ea6;font-weight:500;margin-left:10rpx}.root .btn{align-items:center;border-radius:16rpx;display:-webkit-flex;display:flex;font-size:32rpx;font-weight:500;height:100rpx;justify-content:center;margin-top:40rpx}.root .close-icon{height:36rpx;position:absolute;right:32rpx;top:32rpx;width:36rpx}.root .bg-icon{height:80rpx;left:32rpx;position:absolute;top:52rpx;width:146rpx}
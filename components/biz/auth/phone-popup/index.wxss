opup-body .popup-step .step3-box .step3-tit{color:#aaa;font-size:24rpx}.popup-content .popup-body .popup-other-phone{color:#5e657c;font-size:24rpx;margin-top:24rpx}.popup-content .popup-body .step3{padding-right:30rpx}.popup-content .popup-body .step3,.popup-content .pupop-but{justify-content:space-between}.popup-content .pupop-but{display:-webkit-flex;display:flex}.popup-content .pupop-but .false-but,.popup-content .pupop-but .true-but,.popup-content .pupop-but .wx-but{background:#ededed;border-radius:8rpx;color:#03c360;font-size:32rpx;height:80rpx;line-height:80rpx;text-align:center;width:330rpx}.popup-content .pupop-but .true-but,.popup-content .pupop-but .wx-but{background-color:#03c360;color:#fff}.popup-content .pupop-but .wx-but{font-weight:700;width:100%}
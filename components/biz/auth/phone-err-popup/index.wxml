<t-popup placement="center" showOverlay="false" visible="{{show}}">
    <view class="popup-content">
        <view class="popup-head">
            <text class="popup-title">{{i18n.t('orderDetail.cozyTips',$_locale)}}</text>
        </view>
        <view class="popup-body"> {{i18n.t('login.phone.errtips1',$_locale)}} <text bind:tap="callPhone" class="link-url">{{phoneNumber}}</text> {{i18n.t('login.phone.errtips2',$_locale)}} </view>
        <view bind:tap="hide" class="pupop-but">{{i18n.t('activityRules.know',$_locale)}}</view>
    </view>
</t-popup>
<t-popup placement="bottom" visible="{{showPopup}}">
    <view class="call-customer-service_popup">
        <view bind:tap="makePhoneCall" class="call-customer-service_popup_item">
            <text class=" font-size_28 phone">{{i18n.t('callPhonePopup.call',$_locale)}}  {{phoneNumber}}</text>
        </view>
        <view bind:tap="cancelPopup" class="call-customer-service_popup_item">
            <text class=" font-size_30 cancel">{{i18n.t('callPhonePopup.cancel',$_locale)}}</text>
        </view>
    </view>
</t-popup>

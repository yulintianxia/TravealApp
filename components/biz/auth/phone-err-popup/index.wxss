.popup-content{background-color:#fff;border-radius:4rpx;font-size:28rpx;padding:48rpx 0 0;width:600rpx}.popup-content .popup-head{color:#222427;font-family:PingFangSC-Regular,PingFang SC;font-size:32rpx;font-weight:600;margin-bottom:20rpx;text-align:center}.popup-content .popup-head .popup-title{text-align:center;width:100%}.popup-content .popup-body{color:#4f5356;line-height:40rpx;padding:0 48rpx 20rpx}.popup-content .pupop-but{border-top:1rpx solid #dce0e4;color:#0165b8;font-size:32rpx;padding:24rpx;text-align:center}.link-url{color:#0165b8;font-size:24rpx}.call-customer-service_popup{background-color:#f0f2f4}.call-customer-service_popup .call-customer-service_popup_item{background-color:#fff;height:100rpx;line-height:100rpx;text-align:center;width:100%}.call-customer-service_popup .call-customer-service_popup_item .phone{color:#0165b8;font-weight:400}.call-customer-service_popup .call-customer-service_popup_item .cancel{color:#222427;font-weight:400}.call-customer-service_popup .call-customer-service_popup_item:first-child{margin-bottom:12rpx}
@import "/styles/init.wxss";
@import "/styles/goodsList.wxss";
@import "/styles/design.wxss";

/* "pages/detail/index", */
:root {
  --td-switch-checked-color: #22bee5 !important;
  --td-grid-bg-color: rgba(36, 36, 36, 1);
  --td-radio-bg-color: #111111;
  --td-radio-label-checked-color: white;
  --td-radio-label-color: white;
}
/* @import "/components/biz/design-module/design-module-external.wxss"; */

/* app.wxss */
page {
  font-family:
    PingFangSC-Regular\,
    PingFang SC;
  /* 改为你想要的主题色，例如绿色 */
  --td-brand-color: #0d0e1f;
  /* 可选：修改签名板专用变量（更精细） */
  --td-sign-pen-color: #00b42a; /* 签名笔迹颜色 */
  --td-sign-btn-bg-color: #00b42a; /* 底部按钮背景色 */
  --td-radio-bg-color: #111111;
  --td-radio-label-checked-color: white;
  --td-radio-label-color: white;
}

.review-create-page .t-grid__content {
  margin-left: -4px !important;
  margin-top: -8px !important;
}
.review-create-page .t-upload__close-btn {
  right: 10px !important;
}
.multi-ellipsis {
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  display: -webkit-box;
  width: auto;
  word-break: break-all;
}
.ellipsis,
.multi-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
}
.ellipsis {
  white-space: nowrap;
}
button[disabled] {
  background-color: rgba(1, 101, 184, 0.3) !important;
  border-color: rgba(1, 101, 184, 0.3) !important;
  color: #fff !important;
}
button {
  border-radius: 0;
}
button::after {
  display: none;
}
.safe-area {
  padding-bottom: env(safe-area-inset-bottom);
}
.safe-area-inset-bottom {
  padding-bottom: env(safe-area-inset-bottom) !important;
}
.show {
  display: block;
}
.hide {
  display: none;
}
.agree-toast .wr-toast__content {
  padding: 28rpx 24rpx;
}
.left-icon-back {
  font-size: 50rpx;
}
.slot-title {
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  display: -webkit-box;
  overflow: hidden;
  padding-right: 40rpx;
  text-overflow: ellipsis;
  width: 100%;
  word-break: break-all;
}
.sams-t-toast .t-toast__content {
  max-width: 600rpx;
  min-width: 250rpx;
}
.sams-t-toast .t-toast__content .t-toast__row-text,
.sams-t-toast .t-toast__row {
  text-align: center;
}
.grayscale {
  filter: grayscale(100%);
}

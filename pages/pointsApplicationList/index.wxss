/* pages/order/order.wxss */
body,
page {
  background: #f7f7f7;
}

.order {
  height: 100vh;
}

.order .order-list {
  padding: 32rpx;
  overflow-y: auto;
}

.order .order-list::after {
  display: block;
  content: '';
  height: 12vh;
}

.order .order-list .order-item {
  position: relative;
  background: #fff;
  padding: 32rpx;
  margin-bottom: 32rpx;
  border-radius: 32rpx;
}

.order .order-list .order-item:last-child {
  margin-bottom: 0;
}

.order .order-list .order-item .order-title {
  display: flex;
  align-items: center;
  color: #000f1a;
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.order .order-list .order-title .icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: 16rpx;
}

.order .order-list .order-title .points {
  flex-grow: 1;
  text-align: right;
  font-size: 32rpx;
   color: #f2c261;
}

/* .points.pay.success {
  color: #f2c261;
}

.points.pay.wait {
  color: #22bee5;
}

.points.pay.fail {
  color: red;
} */



.order .order-list .order-item .order-dd {
  color: #7e7f80;
  font-size: 24rpx;
  margin-bottom: 8rpx;
  line-height: 36rpx;
}

.order .order-list .order-item .copy {
  position: absolute;
  bottom: 40rpx;
  right: 32rpx;
  width: 32rpx;
  height: 32rpx;
}

.blank {
  margin-top: 300rpx;
  text-align: center;
  font-size: 32rpx;
  color: #888;
}

.icon-box-img {
  margin-right: 10rpx;
}

.pay-succes {
  color: green;
}

.pay-fail {
  color: red;
}

.pay-wait {
  color: #f2c261;
}

.order-content {
  display: flex;
  align-items: center;
}

.order-right {
  width: 16+vw;
  text-align: right;
}

.order-left {
  flex-grow: 1;
}

.order-right image {
  width: 40rpx;
  height: 40rpx;
  margin-left: 16rpx;
}

.btn {
  width: 680rpx;
  height: 88rpx;
  background: #22bee5;
  color: #ffffff;
  position: fixed;
  bottom: 55rpx;
  left: 35rpx;
  border-radius: 41.5rpx;
  font-size: 36rpx;
  text-align: center;
  line-height: 88rpx;
}

/* ========== 导航栏 ========== */
.nav-bar {
  background: #0b101a;
  position: relative;
  z-index: 10;
}

.nav-bar-inner {
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-bar-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #f0f0f0;
  letter-spacing: 2rpx;
}

/* ========== 滚动区域 ========== */
.scroll-view {
  flex: 1;
}

/* ========== 列表 ========== */
.list {
  padding: 20rpx 28rpx;
  padding-bottom: 160rpx;
}

/* ========== 卡片 ========== */
.card {
  background: rgba(255, 255, 255, 0.06);
  border-radius: 24rpx;
  padding: 28rpx 28rpx 20rpx;
  margin-bottom: 24rpx;
}

.card-body {
  display: flex;
  align-items: flex-start;
}

/* 缩略图 */
.card-thumb {
  width: 130rpx;
  height: 130rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  background: rgba(255, 255, 255, 0.04);
}

.card-thumb-empty {
  display: flex;
  align-items: center;
  justify-content: center;
}

.thumb-text {
  font-size: 22rpx;
  color: #555;
}

/* 信息区 */
.card-info {
  flex: 1;
  margin-left: 24rpx;
  overflow: hidden;
  padding-top: 4rpx;
}

.card-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #e8e0d0;
  margin-bottom: 10rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.card-remark {
  font-size: 24rpx;
  color: #7a7e88;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 右侧金额+状态 */
.card-right {
  flex-shrink: 0;
  text-align: right;
  margin-left: 16rpx;
  padding-top: 4rpx;
}

.card-amount {
  font-size: 40rpx;
  font-weight: 700;
  color: #efd08b;
  font-family: 'DIN Alternate', 'PingFang SC', sans-serif;
  line-height: 1.2;
}

.card-status {
  font-size: 24rpx;
  margin-top: 8rpx;
  color: #7a7e88;
}

/* 状态颜色 */
.status-0 {
  color: #efd08b;
}

.status-1 {
  color: #7a7e88;
}

.status-2 {
  color: #e06060;
}

.status-9 {
  color: #555;
}

/* 底部日期 */
.card-footer {
  display: flex;
  justify-content: flex-end;
  margin-top: 14rpx;
}

.card-date {
  font-size: 22rpx;
  color: #5a5e68;
}

/* ========== 空状态 ========== */
.empty {
  padding-top: 36vh;
  text-align: center;
}

.empty-text {
  font-size: 28rpx;
  color: #555;
}

/* ========== 底部按钮 ========== */
.btn-wrap {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 100rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  z-index: 10;
}

.btn {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 500;
  color: #c9b67e;
  background: rgba(180, 160, 100, 0.2);
  border-radius: 44rpx;
  letter-spacing: 2rpx;
}

.btn:active {
  background: rgba(180, 160, 100, 0.35);
}
<wxs module="getDate" src="./state.wxs"></wxs>
<view class="order">
    <scroll-view class="scroll-view" scroll-y style="height:100vh" bindscrolltolower='bindscrolltolower' lower-threshold="{{20}}">
        <view class="order-list" wx:if="{{applicationList.length}}">
            <view class="order-item" wx:for="{{applicationList}}" wx:for-index="index" wx:for-item="item" :key="index">
                <view class="order-title">
                    <icon class="icon-box-img" type="success" size="20" wx:if="{{item.status==1}}"></icon>
                    <icon class="icon-box-img" type="cancel" size="20" wx:elif="{{item.status==2}}"></icon>
                    <icon class="icon-box-img" type="waiting" size="20" wx:elif="{{item.status==0}}"></icon>
                    <icon class="icon-box-img" type="clear" size="20" wx:elif="{{item.status==9}}"></icon>
                    <view class='point_state'>{{getDate.judgmentState(item.status)}}</view>
                    <!-- <view class="points pay {{item.status ==1 ? 'success': item.status ==2 ?'fail':'wait' }}">
                        {{item.points}}
                    </view> -->
                    <view class="points pay success" wx:if="{{item.status==1}}">
                        {{item.paymentMoney}}
                    </view>
                    <view class="points pay fail" wx:elif="{{item.status==2}}">
                        {{item.paymentMoney}}
                    </view>
                    <view class="points pay wait" wx:elif="{{item.status==0}}">
                        {{item.paymentMoney}}
                    </view>
                    <view class="points pay" wx:elif="{{item.status==9}}">
                        {{item.paymentMoney}}
                    </view>
                </view>
                <view class='order-content'>
                    <view class="order-left">
                        <view class="order-dd">微信昵称：{{ item.wxName}}</view>
                        <view class="order-dd">微信号：{{ item.wxNumber }}</view>
                        <view class="order-dd">联系电话：{{ item.phone }}</view>
                        <view class="order-dd">订单号：{{ item.actualPayment || '-' }}</view>
                        <view class="order-dd">实付金额：{{ item.paymentMoney || '-' }}</view>
                    </view>
                    <view class="order-right">
                        <image src="../../images/home/search.png" data-item='{{item}}' bindtap='see' wx:if="{{item.status!=2}}" mode="scaleToFill" />
                        <image src="../../images/home/edit.png" data-item='{{item}}' bindtap='edit' wx:elif="{{item.status==2}}" mode="scaleToFill" />
                        <image src="../../images/home/chexiao.png" data-id='{{item.keyId}}' bindtap='reset' wx:if="{{item.status==0}}" mode="scaleToFill" />
                    </view>
                </view>
            </view>
        </view>
        <view wx:else class="blank">暂无申请明细</view>
    </scroll-view>
    <view class="btn" bindtap="addUrl">新增积分申请</view>
</view>
/* 保留原Vue代码中的样式，适配小程序单位（px转rpx，部分调整） */
.medalwall-wrap {
  width: 100%;
  min-height: 100vh;
  background-size: cover;
  background-position: center;
}

.medalwall-header {
  width: 100%;
}

.check-tab {
  --tabs-active-color: #fff;
  --tabs-inactive-color: #ccc;
  --tabs-bottom-bar-color: #fff;
}

.medalwall-content {
  padding: 0 20rpx;
}

.medalwall-top {
  display: flex;
  gap: 20rpx;
  overflow-x: auto;
  padding: 20rpx 0;
}

.capsule {
  padding: 10rpx 20rpx;
  background: #fff;
  border-radius: 30rpx;
  white-space: nowrap;
}

.capsule.gray {
  background: #ccc;
  color: #666;
}

.medalwall-middle {
  margin-top: 20rpx;
}

.medal-list {
  height: 600rpx;
}

.medal {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx;
}

.medal .img {
  width: 300rpx;
  height: 300rpx;
  background-size: cover;
  background-position: center;
  border-radius: 10rpx;
}

.medal .img.menban {
  opacity: 0.5;
}

.medal .year {
  margin-top: 10rpx;
  font-size: 28rpx;
  color: #333;
}

.medal .title {
  margin-top: 10rpx;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.medal .tip {
  margin-top: 5rpx;
  font-size: 24rpx;
  color: #666;
}

.medal .tipTitle {
  margin-bottom: 30rpx;
}

.medal .line {
  margin-top: 20rpx;
}

.btn.solid {
  padding: 10rpx 40rpx;
  background: #0088ff;
  color: #fff;
  border-radius: 30rpx;
  font-size: 28rpx;
}

.medalwall-bottom {
  display: flex;
  justify-content: center;
  margin-top: 20rpx;
}

.tour {
  display: flex;
  gap: 10rpx;
}

.dot {
  width: 15rpx;
  height: 15rpx;
  border-radius: 50%;
  background: #ccc;
}

.dot.show {
  background: #0088ff;
}


<!--  <div class="grade" @click="orderBuys">{{originValue}}积分兑换</div>  -->

<view class="grade" wx:if="{{isBuyOrder}}" bindtap="turnGo">
勋章列表
</view>

<view class="grade" wx:elif="{{isBuy && pointsBalance >= originValue}}" bindtap="orderBuys">
{{ originValue }}积分兑换
</view>

<view class="grade grey" wx:elif="{{isBuy && pointsBalance < originValue}}">
{{ originValue }}积分（积分不足）
</view>

<view class="grade grey" wx:else>
{{ originValue }}积分（等级不够）
</view>
</view>
</view>
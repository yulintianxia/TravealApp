.medalwall-wrap {
  width: 100vw;
  /* margin-bottom: 60px; */
}

.tempaltePage {
  min-height: calc(100vh);
  width: 100vw;
  /* overflow: auto; */
}

.tempaltePage ::v-deep img {
  max-width: calc(100vw);
  max-height: calc(100vh);
  background-repeat: no-repeat;
  /* background-size: 100%; */
}

.footer {
  background: #ff4500;
  color: white;

  width: 100vw;
  height: 50px;
  position: fixed;
  bottom: 0;
  font-size: 16px;
  line-height: 50px;
}

.footer div {
  text-align: center;
}

.buyContainer {
  width: 100vw;
  height: 11.73vw;
  font-size: 5.33vw;
  font-family: PingFangSC-Regular;
  position: fixed;
  bottom: 10%;
  text-align: center;
  display: flex;
  justify-content: center;
}

.grade {
  width: 60vw;
  border: 1px solid #ffe2b8;
  border-radius: 10.67vw;
  text-align: center;
  font-weight: 400;
  letter-spacing: -0.48px;
  line-height: 11.73vw;
  height: 11.73vw;
  background: linear-gradient(90deg, #f6d7a5 0.13%, #ffefd6 54.85%, #f6d6a2);
  color: #673e27;
}
.grade.grey {
  opacity: 0.5;
}
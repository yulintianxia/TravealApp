<view class="page">
  <!-- 自定义导航栏 -->
  <!-- <view class="nav-bar" style="padding-top: {{statusBarHeight}}px; height: {{navBarHeight}}px;">
    <view class="nav-title">个人中心</view>
  </view> -->

  <scroll-view scroll-y class="scroll-area">
    <!-- 用户信息卡片 -->
    <view class="user-card">
      <image class="card-bg" bindtap="turnLevel" src="{{levelInfo.background ? BASE_URL + levelInfo.background : configbackgroundImg}}" mode="aspectFill" />


      
      <view class="card-content" bindtap="turnLevel">
        <view class="user-info-row">
         <view class='user-avatar-bg' catchtap="getUser">
          <image class="user-avatar" src="{{user.avatar ?  BASE_URL + user.avatar : '../../images/home/default.png'}}" />
            <!-- <image class="user-avatar" src="{{user.avatar ? '../../images/new': ''}}" /> -->
            <!-- <image class="user-avatar" src="{{configbackgroundImg}}" /> -->
         </view> 
          <view class="user-meta" catchtap="getUser">
            <view class="user-name-row">
              <text class="user-name">{{user.nickName || '暂无用户名'}}</text>
              <view class="vip-badge">
                <text class="vip-text">{{(levelInfo.name ? levelInfo.name +'会员' : '')  || ''}}</text>
              </view>
            </view>
            <text class="user-points">积分： <text class='real-point'>{{pointsBalance || 0}}</text>/{{pointsTotal || 0}}</text>
            <view class="checkin-row">
              <view class="vip-checkin" catchtap="goCheckin">签到</view>
            </view>
          </view>
        </view>
        <view class="more-info" catchtap="handleMoreInfo">
          <text>更多信息</text>
        </view>
      </view>
    </view>

    <!-- 订单列表 -->
    <view class="section">
      <view class="section-title">订单列表</view>
      <view class="section-card">
        <view class="grid-row">
          <view class="grid-item" wx:for="{{orderList}}" wx:key="state" bindtap="handleEntryJump" data-item="{{item}}">
            <view class="icon-circle">
              <image src="{{item.iconUrl}}" />
            </view>
            <text class="grid-label">{{item.title}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 会员权益 -->
    <view class="section">
      <view class="section-title">会员权益</view>
      <view class="section-card">
        <view class="grid-row">
          <view class="grid-item" wx:for="{{topList}}" wx:key="url" bindtap="handleJumpUrl" data-url="{{item.url}}">
            <view class="icon-circle">
              <image src="{{item.iconUrl}}" />
            </view>
            <text class="grid-label">{{item.title}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 我的工具 -->
    <view class="section">
      <view class="section-title">我的工具</view>
      <view class="section-card">
        <view class="grid-row">
          <view class="grid-item" wx:for="{{toolsData}}" wx:key="title" bindtap="handleTool" data-item="{{item}}">
            <view class="icon-circle">
              <image src="{{item.iconUrl}}" />
            </view>
            <text class="grid-label">{{item.title}}</text>
          </view>
        </view>
      </view>
    </view>

    <view style="height: 120rpx;"></view>
  </scroll-view>
  <!-- 功能未上线弹窗 -->
<view class="tip-mask" wx:if="{{showTip}}" bindtap="closeTip">
  <view class="tip-dialog" catchtap="">
    <view class="tip-text">功能即将上线，敬请期待！</view>
    <view class="tip-btn" bindtap="closeTip">知道了</view>
  </view>
</view>
</view>


<!-- 公众号二维码弹窗 -->
<view class="tip-mask" wx:if="{{showQrCode}}" bindtap="closeQrPopup">
  <view class="tip-dialog" catchtap="">
    <image class="qr-image" src="{{chatImg}}" mode="aspectFit" />
    <view class="qr-label">添加客服微信</view>
    <view class="tip-btn" bindtap="closeQrPopup">知道了</view>
  </view>
</view>
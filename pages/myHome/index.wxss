page {
  background: #0a0e1a;
  height: 100%;
  color: #c9b67e;
}

/* ===== 导航栏 ===== */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #0a0e1a;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 2rpx;
}

/* ===== 滚动区域 ===== */
.scroll-area {
  height: 100vh;
  box-sizing: border-box;
}

/* ===== 用户信息卡片 ===== */
.user-card {
  position: relative;
  margin: 0rpx 24rpx 0;
  height: 380rpx;
  border-radius: 24rpx;
  overflow: hidden;
}

.card-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;

}

.card-content {
  position: relative;
  z-index: 1;
  height: 100%;
  padding: 40rpx 26rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.user-info-row {
  display: flex;
  align-items: center;
}

.user-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  /* border: 4rpx solid rgba(201, 182, 126, 0.5); */
  flex-shrink: 0;
  display:flex;
  justify-content: center;
  align-items: center;
  margin-left: 10rpx;
  margin-top: 8rpx;
}

.user-avatar-bg {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background-image: url("data:image/png;base64,粘贴这里...");
  background-size: cover;
  background-position: center;
}

.user-meta {
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.user-name-row {
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
}

.user-name {
  display: inline-block;
  max-width: 260rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
  margin-right: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.vip-badge {
  display: inline-flex;
  align-items: center;
  height: 40rpx;
  flex-shrink: 0;
}

.vip-text {
  font-size: 22rpx;
  color: rgba(249, 226, 172, 1);
  font-weight: 500;
}

.vip-checkin {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 84rpx;
  height: 40rpx;
  padding: 0 16rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(249, 226, 172, 0.55);
  background: rgba(201, 169, 110, 0.2);
  font-size: 22rpx;
  color: #fff3cd;
  font-weight: 600;
}

.checkin-row {
  display: flex;
  margin-top: 12rpx;
}

.user-points {
  font-size: 26rpx;
  color: rgba(160, 160, 160, 1);
  margin-top: 12rpx;
}

.more-info {
  position: absolute;
  top: 40rpx;
  right: 32rpx;
  font-size: 24rpx;
  /* color: rgba(255, 255, 255, 0.7); */
  color: #C9BA91;
}

.real-point{
  color:white;
}
/* ===== 通用区块 ===== */
.section {
  margin: 24rpx 24rpx 0;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color:  rgba(160, 160, 160, 1);
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}

.section-card {
  background: rgba(255, 255, 255, 0.06);
  border-radius: 24rpx;
  padding:24rpx;
  border: 1rpx solid rgba(201, 182, 126, 0.12);
}

/* ===== 网格布局 ===== */
.grid-row {
  display: flex;
  /* justify-content: space-around; */
  align-items: center;
  flex-wrap: wrap;
}

.grid-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 25%;
  margin-bottom: 28rpx;
}

.icon-circle {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(201, 182, 126, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(201, 182, 126, 0.08);
  margin-bottom: 16rpx;
}

.icon-circle image {
  width: 48rpx;
  height: 48rpx;
}

.grid-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  text-align: center;
}

.user-avatar-bg {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background-image: url("data:image/png;base64,");
  background-size: cover;
  background-position: center;
}

/* ===== 功能提示弹窗 ===== */
.tip-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.65);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tip-dialog {
  width: 580rpx;
  background: rgba(30, 35, 50, 0.95);
  border-radius: 24rpx;
  border: 1rpx solid rgba(201, 182, 126, 0.15);
  padding: 80rpx 48rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.tip-text {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.85);
  text-align: center;
  margin-bottom: 60rpx;
  line-height: 1.6;
}

.tip-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: linear-gradient(135deg, #c9a96e, #a07c3e);
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: white;
}

/* ===== 二维码弹窗 ===== */
.qr-image {
  width: 320rpx;
  height: 320rpx;
  border-radius: 12rpx;
  background: #ffffff;
  margin-bottom: 24rpx;
}

.qr-label {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.85);
  text-align: center;
  margin-bottom: 48rpx;
}
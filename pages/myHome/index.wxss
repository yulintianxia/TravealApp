}

.levle-remark {
  margin-top: 26rpx;
  font-size: 18px;
  font-weight: 600;
  font-family: Verdana, Geneva, Tahoma, sans-serif;
  font-style: italic;
}

.position-icon-right {
  position: absolute;
  top: 64rpx;
  right: 15%;
}

.logo_img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-left: 10rpx;
}
.level_img {
  display: flex;
  justify-content: space-between;
  margin-top: 26rpx;
  margin-right: 30rpx;
}


.level_explain {
  display: flex;
  flex-direction: column;
  justify-content: space-around;
}

.level-point {
   font-size: 12px;
   margin-top:20rpx;
}

.versionPoint {
  font-size: 12px;
   display: flex;
   justify-content: space-between;
   align-items: center;
   margin-top: 20rpx;
   line-height: 50rpx;
}

.versionPoint image {
   width: 60rpx;

<view class="no-level-page">
  <!-- 顶部等级卡片 -->
  <view class="level-card" style="background-image: url({{backGroundImg}})">
    <view class="level-card-overlay"></view>
    <view class="level-card-content">
      <view class="level-tag">当前等级</view>
      <view class="level-name">{{currentLevel.name || '新晋会员'}} V{{currentLevelIndex}}</view>
      <view class="level-quote">{{currentLevel.remark || ''}}</view>
    </view>
  </view>

  <!-- 积分排名 -->
  <view class="rank-section" bindtap="turnTop">
    <image class="rank-icon" src="{{rankIcon}}" mode="aspectFit"></image>
    <text class="rank-label">积分排名：</text>
    <text class="rank-value">第{{top}}名</text>
  </view>

  <!-- 当前积分和进度条 -->
  <view class="progress-section">
    <view class="points-info">
      <text class="points-label">当前积分</text>
      <text class="points-value">{{pointsTotal}}</text>
    </view>

    <!-- 进度条 -->
    <view class="progress-bar-wrap">
      <view class="progress-bar">
        <view class="progress-fill" style="width: {{progressPercent}}%"></view>
        <view class="progress-indicator" style="left: {{progressPercent}}%">
          <view class="indicator-dot"></view>
          <view class="indicator-arrow">▼</view>
        </view>
        <!-- 等级节点 -->
        <view wx:for="{{levelList}}" wx:key="index" class="progress-node" style="left: {{index / (levelList.length - 1) * 100}}%">
          <view class="node-dot {{currentLevelIndex >= index ? 'node-active' : ''}}"></view>
        </view>
      </view>
    </view>

    <!-- 等级图标列表 -->
    <view class="level-icon-list">
      <view wx:for="{{levelList}}" wx:key="index" class="level-icon-item">
        <image class="level-icon-img {{currentLevelIndex >= index ? 'icon-active' : 'icon-inactive'}}" src="{{levelIconList[index] || (item.mountain ? BASE_URL + item.mountain : '')}}" mode="aspectFit"></image>
        <text class="level-icon-points">{{item.pointsStart}}</text>
      </view>
    </view>
  </view>

  <!-- 可享权益 -->
  <view class="rights-section">
    <view class="rights-header">
      <view class="rights-title">
        <text class="rights-title-text">可享权益</text>
        <text class="rights-count">2项</text>
      </view>
      <view class="rights-more" bindtap="showRightsPopup">
        <text>升级可享更多权益</text>
        <text class="rights-arrow">›</text>
      </view>
    </view>
    <view class="rights-list">
      <view class="rights-item" bindtap="turnBadgePage">
        <view class="rights-icon-wrap">
          <image class="rights-icon" src="{{rightsBadgeIcon}}" mode="aspectFit"></image>
        </view>
        <text class="rights-name">勋章</text>
      </view>
      <view class="rights-item" bindtap="turnGiftPage">
        <view class="rights-icon-wrap">
          <image class="rights-icon" src="{{rightsGiftIcon}}" mode="aspectFit"></image>
        </view>
        <text class="rights-name">商品</text>
      </view>
    </view>
  </view>
</view>

<!-- ========== 权益体系弹窗：居中弹出 ========== -->
<!-- 半透明遮罩，点击关闭 -->
<view class="popup-mask {{showPopup ? 'popup-mask-show' : ''}}" bindtap="hideRightsPopup"></view>

<!-- 居中弹窗卡片 -->
<view class="popup-dialog {{showPopup ? 'popup-dialog-show' : ''}}">

  <!-- 内容区 -->
  <view class="popup-dialog-body">

    <view class="popup-title">正莲会员等级权益体系（V1-V7 正式版）</view>

    <scroll-view scroll-y class="popup-scroll">

      <view class="popup-section">
        <view class="popup-section-title">总则（所有会员通用）</view>
      </view>

      <view class="popup-section">
        <view class="popup-section-sub">1. 等级定义</view>
        <view class="popup-text">· 会员等级分为：V1 白泽、V2 螣蛇、V3 陆吾、V4 麒麟、V5 凤凰、V6 四灵、V7 应龙。</view>
        <view class="popup-text">· 等级依据近12个月实际支付金额评定，每月自动更新；升级后立即生效，降级后权益同步调整。</view>
      </view>

      <view class="popup-section">
        <view class="popup-section-sub">2. 优惠规则</view>
        <view class="popup-text">· 折扣、会员券、活动价不可叠加使用，同一订单仅享受最优一项。</view>
        <view class="popup-text">·「现货产品」指店铺明码标价、可直接下单的成品；「定制产品」指私人定制、改制、专属设计类产品；「特殊产品」指孤品、收藏级、寺院结缘款。</view>
      </view>

      <view class="popup-section">
        <view class="popup-section-sub">3. 服务范围</view>
        <view class="popup-text">· 会员权益仅限本人使用，不可转让。</view>
        <view class="popup-text">· 正莲保留最终解释权，权益内容可能随活动调整，以官网公示为准。</view>
      </view>

    </scroll-view>

    <view class="popup-btn" bindtap="hideRightsPopup">知道了</view>

  </view>
</view>


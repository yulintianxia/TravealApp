<view class="medalwall-wrap">
  <view class="medalwall-header" style="text-align: center">
    <view class="tempaltePage" wx:html="{{htmlTempalte}}"></view>
  </view>

  <view class="buyContainer">
    <view 
      class="grade" 
      wx:if="{{isBuyOrder}}" 
      bindtap="turnGo"
    >
      勋章列表
    </view>
    <view 
      class="grade" 
      wx:elif="{{isBuy && pointsBalance >= originValue}}" 
      bindtap="orderBuys"
    >
      {{ originValue }}积分兑换
    </view>
    <view 
      class="grade grey" 
      wx:elif="{{isBuy && pointsBalance < originValue}}"
    >
      {{ originValue }}积分（积分不足）
    </view>
    <view class="grade grey" wx:else>
      {{ originValue }}积分（等级不够）
    </view>
  </view>

  <!-- 地址选择弹窗 -->
  <van-dialog
    show="{{showDialogData}}"
    title="选择地址"
    bind:confirm="payGood"
    bind:cancel="cancel"
    bind:close="cancel"
    show-cancel-button
  >
    <van-address-list
      value="{{addressId}}"
      add-button-text="确定"
      list="{{addrsssList}}"
      show-add-button="{{false}}"
      default-tag-text="默认"
      bind:select="selectAddress"
    />
  </van-dialog>
</view>
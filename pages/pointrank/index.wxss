/* ========== 全局 ========== */
page {
  height: 100%;
  background: #0b101a;
}

.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #080c14 0%, #111b2e 100%);
  font-family: PingFang SC, -apple-system, Helvetica Neue, Arial, sans-serif;
  color: #fff;
}

/* ========== 导航栏 ========== */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(8, 12, 20, 0.92);
}

.nav-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #f5f7fb;
  letter-spacing: 2rpx;
}

/* ========== 滚动区 ========== */
.main-scroll {
  height: 100vh;
  box-sizing: border-box;
}

/* ========== 顶部视觉 ========== */
.hero {
  position: relative;
  width: 100%;
  height: 580rpx;
  overflow: hidden;
}

.hero-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

/* 顶部两侧深色弧形，模拟设计图圆弧遮罩 */
.hero-arc {
  position: absolute;
  top: -300rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 200%;
  height: 400rpx;
  border-radius: 0 0 50% 50%;
  background: #080c14;
  z-index: 1;
}

/* 底部渐变消融 */
.hero-fade {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 240rpx;
  background: linear-gradient(180deg, rgba(8, 12, 20, 0) 0%, #0b101a 100%);
  z-index: 2;
}

.hero-stamp {
  position: absolute;
  top: 140rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 20rpx;
  color: rgba(239, 208, 139, 0.7);
  border: 1rpx solid rgba(239, 208, 139, 0.5);
  padding: 4rpx 14rpx;
  border-radius: 4rpx;
  letter-spacing: 4rpx;
  z-index: 3;
}

.hero-title {
  position: absolute;
  bottom: 108rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 60rpx;
  font-weight: 800;
  color: #efd08b;
  letter-spacing: 6rpx;
  text-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.55);
  z-index: 3;
  white-space: nowrap;
}

.hero-sub {
  position: absolute;
  bottom: 68rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 22rpx;
  color: rgba(231, 197, 124, 0.85);
  letter-spacing: 4rpx;
  z-index: 3;
}

/* ========== Top3 领奖台 ========== */
.podium {
  display: flex;
  justify-content: center;
  align-items: flex-end;
  margin: 20rpx 24rpx 0;
  position: relative;
  z-index: 5;
}

.podium-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  border-radius: 24rpx;
  padding-bottom: 20rpx;
  box-sizing: border-box;
}

.col-1 {
  width: 156rpx;
  min-height: 320rpx;
  background: linear-gradient(180deg, rgba(239, 208, 139, 0.18) 0%, rgba(239, 208, 139, 0.03) 100%);
  /* border: 1rpx solid rgba(239, 208, 139, 0.22); */
  margin: 60rpx 58rpx;
  padding-top: 18rpx;
  z-index: 2;
  border-radius: 24px 24px 0px 0px;
}

.col-2 {
  width: 156rpx;
  min-height: 310rpx;
  background: linear-gradient(180deg, rgba(237, 155, 121, 0.18) 0%, rgba(237, 155, 121, 0.03) 100%);
  /* border: 1rpx solid rgba(237, 155, 121, 0.22); */
  padding-top: 14rpx;
  border-radius: 24px 24px 0px 0px;
}

.col-3 {
  width: 156rpx;
  min-height: 310rpx;
  background: linear-gradient(180deg, rgba(183, 214, 204, 0.18) 0%, rgba(183, 214, 204, 0.03) 100%);
  /* border: 1rpx solid rgba(183, 214, 204, 0.22); */
  padding-top: 14rpx;
  border-radius: 24px 24px 0px 0px;
}


.frame-avatar {
  width: 120rpx;
  width: 120rpx;
}

/* 头像装饰环 */
.frame {
  border-radius: 50%;
  padding: 6rpx;
  box-sizing: border-box;
  position: relative;
  /* margin-top:-60rpx; */
}

.col-1 .frame {
  width: 134rpx;
  height: 134rpx;
  margin-top: -80rpx;
}

.col-2 .frame,
.col-3 .frame {
  width: 114rpx;
  height: 114rpx;
  margin-top:-56rpx;
}

.frame-gold {
  background-color: conic-gradient(#f7e1a8, #ce9f56, #f7e1a8, #b8882e, #f7e1a8);
  box-shadow: 0 0 20rpx rgba(239, 208, 139, 0.4);
}

.frame-copper {
  background: conic-gradient(#f1b28a, #c17350, #f1b28a, #a65c38, #f1b28a);
  box-shadow: 0 0 16rpx rgba(237, 155, 121, 0.35);
}

.frame-jade {
  background: conic-gradient(#b8dfd1, #6d9e8e, #b8dfd1, #5a8878, #b8dfd1);
  box-shadow: 0 0 16rpx rgba(183, 214, 204, 0.35);
}

.frame-avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: block;
}

/* 名次数字 */
.podium-rank {
  display: block;
  line-height: 1;
  font-weight: 800;
  margin-top: 12rpx;
}

.podium-rank-1 {
  font-size: 38rpx;
  color: #f1cd84;
}

.podium-rank-2 {
  font-size: 38rpx;
  color: #ed9b79;
}

.podium-rank-3 {
  font-size: 38rpx;
  color: #b0cfbf;
}

/* 昵称 */
.podium-nick {
  display: block;
  margin: 10rpx 0;
  max-width: 180rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-weight: 500;
}

.podium-nick-1 {
  font-size: 26rpx;
  color: #efd08b;
/* width: 180rpx; */
  /* font-weight: 700; */
}

.podium-nick-2 {
  font-size: 26rpx;
  color: #ec9b78;
  /* width: 180rpx; */
}

.podium-nick-3 {
  font-size: 26rpx;
  color: #b0cfbf;
  /* width: 180rpx; */
}

/* 积分 */
.podium-score {
  display: block;
  margin-top: 6rpx;
  line-height: 1;
  font-weight: 700;
}

.podium-score-1 {
  font-size: 44rpx;
  color: #f2cf88;
}

.podium-score-2 {
  font-size: 38rpx;
  color: #ee9c7a;
}

.podium-score-3 {
  font-size: 38rpx;
  color: #b0cfbf;
}

/* ========== 排名列表 ========== */
.list-wrap {
  margin: 28rpx 28rpx 0;
}

.list-row {
  display: flex;
  align-items: center;
  height: 120rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.list-row:last-child {
  border-bottom: none;
}

/* 高亮行（当前用户，设计图中第6名加粗放大） */
.list-row-hl {
  height: 132rpx;
}

/* 序号 */
.list-idx {
  width: 56rpx;
  font-size: 30rpx;
  color: rgba(230, 234, 240, 0.6);
  font-weight: 400;
  text-align: center;
  flex-shrink: 0;
}

.list-idx-hl {
  font-size: 38rpx;
  color: #d9cb98;
  font-weight: 700;
}

/* 列表头像 + 装饰环 */
.list-avatar-ring {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  padding: 3rpx;
  margin-left: 12rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  background: conic-gradient(rgba(183, 172, 140, 0.5),
      rgba(140, 130, 100, 0.3),
      rgba(183, 172, 140, 0.5),
      rgba(140, 130, 100, 0.3),
      rgba(183, 172, 140, 0.5));
  box-sizing: border-box;
}

.list-avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: block;
}

/* 昵称 */
.list-name {
  flex: 1;
  font-size: 28rpx;
  color: rgba(228, 232, 238, 0.72);
  font-weight: 400;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.list-name-hl {
  font-size: 32rpx;
  color: #d9cb98;
  font-weight: 700;
}

/* 积分 */
.list-score-box {
  display: flex;
  align-items: baseline;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.list-score {
  font-size: 32rpx;
  color: #d6ca9f;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.list-score-hl {
  font-size: 36rpx;
  color: #efd08b;
  font-weight: 800;
}

.list-unit {
  font-size: 22rpx;
  color: rgba(228, 232, 238, 0.5);
  margin-left: 8rpx;
}
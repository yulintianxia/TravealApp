.frame-avatar {
  width: 120rpx;
  width: 120rpx;
}

/* 头像装饰环 */
.frame {
  border-radius: 50%;
  box-sizing: border-box;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: visible;
  z-index: 4;
}

.col-1 .frame {
  width: 134rpx;
  height: 134rpx;
  margin-top: -80rpx;
}

.col-2 .frame,
.col-3 .frame {
  width: 114rpx;
  height: 114rpx;
  margin-top: -56rpx;
}

.frame-gold {
  background: transparent;
  box-shadow: none;
}

.frame-copper {
  background: transparent;
  box-shadow: none;
}

.frame-jade {
  background: transparent;
  box-shadow: none;
}

.frame-crown {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 2;
  pointer-events: none;
}

.frame-avatar {
  width: 72%;
  height: 72%;
  border-radius: 50%;
  display: block;
  z-index: 1;
}

/* 名次数字 */
.podium-rank {
  display: block;
  line-height: 1;
  font-weight: 800;
  margin-top: 12rpx;
  position: relative;
  z-index: 4;
}

.podium-rank-1 {
  font-size: 38rpx;
  color: #f1cd84;
}

.podium-rank-2 {
  font-size: 38rpx;
  color: #ed9b79;
}

.podium-rank-3 {
  font-size: 38rpx;
  color: #b0cfbf;
}

/* 昵称 */
.podium-nick {
  display: block;
  margin: 10rpx 0;
  max-width: 180rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-weight: 500;
  position: relative;
  z-index: 4;
}

.podium-nick-1 {
  font-size: 26rpx;
  color: #efd08b;
  /* width: 180rpx; */
  /* font-weight: 700; */
}

.podium-nick-2 {
  font-size: 26rpx;
  color: #ec9b78;
  /* width: 180rpx; */
}

.podium-nick-3 {
  font-size: 26rpx;
  color: #b0cfbf;
  /* width: 180rpx; */
}

/* 积分 */
.podium-score {
  display: block;
  margin-top: 6rpx;
  line-height: 1;
  font-weight: 700;
  position: relative;
  z-index: 4;
}

@keyframes star-twinkle {
  0%,
  100% {
    opacity: 0.28;
    transform: scale(0.55);
  }

  45% {
    opacity: 1;
    transform: scale(1.18);
  }

  70% {
    opacity: 0.65;
    transform: scale(0.9);
  }
}

@keyframes particle-float {
  0% {
    opacity: 0;
    transform: translate3d(0, 20rpx, 0) scale(0.55);
  }

  20% {
    opacity: 0.85;
  }

  65% {
    opacity: 0.48;
    transform: translate3d(0, -16rpx, 0) scale(1);
  }

  100% {
    opacity: 0;
    transform: translate3d(0, -38rpx, 0) scale(1.12);
  }
}

@keyframes halo-breathe {
  0%,
  100% {
    opacity: 0.34;
    transform: translateX(-50%) scale(0.94);
  }

  50% {
    opacity: 0.78;
    transform: translateX(-50%) scale(1.08);
  }
}

.podium-score-1 {
  font-size: 44rpx;
  color: #f2cf88;
}

.podium-score-2 {
  font-size: 38rpx;
  color: #ee9c7a;
}

.podium-score-3 {
  font-size: 38rpx;
  color: #b0cfbf;
}


/* ========== 全局 ========== */
page {
  height: 100%;
  background: #0b101a;
}

.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #080c14 0%, #111b2e 100%);
  font-family:
    PingFang SC,
    -apple-system,
    Helvetica Neue,
    Arial,
    sans-serif;
  color: #fff;
}

/* ========== 导航栏 ========== */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(8, 12, 20, 0.92);
}

.nav-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #f5f7fb;
  letter-spacing: 2rpx;
}

/* ========== 滚动区 ========== */
.main-scroll {
  height: 100vh;
  box-sizing: border-box;
}

.podium-top-mask {
  display: none;
}

.podium-top-mask-fixed {
  display: block;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background: linear-gradient(
    180deg,
    rgba(9, 14, 24, 0.98) 0%,
    rgba(13, 22, 36, 0.95) 100%
  );
  z-index: 28;
  pointer-events: none;
}

/* ========== 顶部视觉 ========== */
.hero {
  position: relative;
  width: 100%;
  height: 480rpx;
  overflow: hidden;
  border-radius: 0 0 60rpx 60rpx;
}

.hero-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* 左侧圆弧形深色遮罩 */
.hero-arc-left {
  position: absolute;
  top: -180rpx;
  left: -120rpx;
  width: 240rpx;
  height: 360rpx;
  border-radius: 50%;
  background: #080c14;
  z-index: 1;
}

/* 右侧圆弧形深色遮罩 */
.hero-arc-right {
  position: absolute;
  top: -180rpx;
  right: -120rpx;
  width: 240rpx;
  height: 360rpx;
  border-radius: 50%;
  background: #080c14;
  z-index: 1;
}

/* 底部渐变消融 */
.hero-fade {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 280rpx;
  background: linear-gradient(
    180deg,
    transparent 0%,
    rgba(8, 12, 20, 0.6) 60%,
    #0b101a 100%
  );
  z-index: 2;
}

/* 文字整体容器，绝对定位到图片底部 */
.hero-text-wrap {
  position: absolute;
  bottom: 60rpx;
  left: 0;
  right: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 3;
}

.hero-stamp {
  font-size: 22rpx;
  color: rgba(239, 208, 139, 0.85);
  border: 1rpx solid rgba(239, 208, 139, 0.55);
  padding: 4rpx 18rpx;
  border-radius: 4rpx;
  letter-spacing: 4rpx;
  margin-bottom: 12rpx;
}

.hero-title {
  font-size: 72rpx;
  font-weight: 800;
  color: #efd08b;
  letter-spacing: 8rpx;
  text-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.7);
  white-space: nowrap;
  margin-bottom: 8rpx;
}

.hero-sub {
  font-size: 24rpx;
  color: rgba(231, 197, 124, 0.8);
  letter-spacing: 6rpx;
}

/* ========== Top3 领奖台 ========== */
.podium-wrap {
  position: relative;
  margin: 0 24rpx 0;
  z-index: 5;
  height:322rpx;
  box-sizing: border-box;
}

.podium-wrap-fixed {
  background: linear-gradient(
    180deg,
    rgba(10, 16, 27, 0.96) 0%,
    rgba(14, 24, 39, 0.92) 100%
  );
}

.podium {
  display: flex;
  justify-content: center;
  align-items: flex-end;
  position: relative;
  margin: 0;
  z-index: 5;
}

.podium-fixed {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  box-sizing: border-box;
  padding: 8rpx 24rpx 0rpx;
  background: linear-gradient(
    180deg,
    rgba(10, 16, 27, 0.98) 0%,
    rgba(14, 24, 39, 0.94) 58%,
    rgba(16, 28, 45, 0.9) 100%
  );
  z-index: 30;
  /* margin-bottom: 10rpx; */
}

.podium-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  overflow: visible;
  border-radius: 24rpx;
  padding-bottom: 20rpx;
  box-sizing: border-box;
}

.rank-halo {
  position: absolute;
  top: -104rpx;
  left: 50%;
  transform: translateX(-50%);
  border-radius: 50%;
  pointer-events: none;
  z-index: 1;
  animation: halo-breathe 2.8s ease-in-out infinite;
}

.rank-halo-1 {
  width: 196rpx;
  height: 196rpx;
  background: radial-gradient(circle, rgba(255, 226, 153, 0.52) 0%, rgba(255, 226, 153, 0.2) 40%, rgba(255, 226, 153, 0) 76%);
}

.rank-halo-2 {
  width: 166rpx;
  height: 166rpx;
  background: radial-gradient(circle, rgba(246, 171, 130, 0.48) 0%, rgba(246, 171, 130, 0.16) 42%, rgba(246, 171, 130, 0) 76%);
  animation-delay: 0.35s;
}

.rank-halo-3 {
  width: 166rpx;
  height: 166rpx;
  background: radial-gradient(circle, rgba(189, 223, 211, 0.5) 0%, rgba(189, 223, 211, 0.18) 42%, rgba(189, 223, 211, 0) 76%);
  animation-delay: 0.7s;
}

.effect-layer {
  position: absolute;
  left: 0;
  right: 0;
  pointer-events: none;
}

.effect-stars {
  top: -90rpx;
  bottom: 62rpx;
  z-index: 2;
}

.effect-particles {
  top: 0;
  bottom: 48rpx;
  z-index: 2;
}

.fx-star,
.fx-particle {
  position: absolute;
  border-radius: 999rpx;
}

.fx-star {
  animation: star-twinkle 2.4s ease-in-out infinite;
}

.fx-star-1 {
  background: radial-gradient(circle, rgba(255, 251, 228, 1) 0%, rgba(249, 227, 159, 0.72) 58%, rgba(249, 227, 159, 0) 100%);
  box-shadow: 0 0 16rpx rgba(252, 224, 129, 0.72);
}

.fx-star-2 {
  background: radial-gradient(circle, rgba(255, 244, 233, 1) 0%, rgba(247, 185, 154, 0.68) 58%, rgba(247, 185, 154, 0) 100%);
  box-shadow: 0 0 14rpx rgba(240, 163, 130, 0.66);
}

.fx-star-3 {
  background: radial-gradient(circle, rgba(242, 253, 249, 1) 0%, rgba(188, 221, 211, 0.7) 58%, rgba(188, 221, 211, 0) 100%);
  box-shadow: 0 0 14rpx rgba(176, 207, 191, 0.62);
}

.fx-particle {
  animation: particle-float 3.6s linear infinite;
}

.fx-particle-1 {
  background: radial-gradient(circle, rgba(255, 244, 199, 0.95) 0%, rgba(255, 224, 135, 0.46) 68%, rgba(255, 224, 135, 0) 100%);
}

.fx-particle-2 {
  background: radial-gradient(circle, rgba(255, 233, 220, 0.92) 0%, rgba(236, 158, 125, 0.42) 68%, rgba(236, 158, 125, 0) 100%);
}

.fx-particle-3 {
  background: radial-gradient(circle, rgba(235, 250, 246, 0.92) 0%, rgba(176, 207, 191, 0.42) 68%, rgba(176, 207, 191, 0) 100%);
}


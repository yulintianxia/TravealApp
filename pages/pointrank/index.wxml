<view class="page">
  <!-- 自定义导航栏 -->
  <!-- <view class="nav-bar" style="padding-top:{{statusBarHeight}}px;height:{{navBarHeight}}px;">
    <text class="nav-title">排行</text>
  </view> -->

  <scroll-view class="main-scroll" scroll-y style="padding-top:{{statusBarHeight + navBarHeight}}px;">

    <!-- 顶部视觉大图 -->
    <view class="hero">
      <image class="hero-bg" src="../../images/home/v1-bg-new.png" mode="aspectFill"/>
      <!-- 顶部左右弧形遮罩 -->
      <view class="hero-arc"></view>
      <!-- 底部渐变融入背景 -->
      <view class="hero-fade"></view>
      <view class="hero-stamp">正莲出品</view>
      <view class="hero-title">乘龙护楼</view>
      <view class="hero-sub">MAGIC PALACE</view>
    </view>

    <!-- Top3 排名 -->
    <view class="podium">
      <!-- 第2名 -->
      <view class="podium-col col-2">
        <view class="frame frame-copper">
          <image class="frame-avatar" src="{{topSecond.avatar ? BASE_URL + topSecond.avatar : defaultPerson}}" mode="aspectFill"/>
        </view>
        <text class="podium-rank podium-rank-2">2</text>
        <text class="podium-nick podium-nick-2">{{topSecond.nickName || '--'}}</text>
        <text class="podium-score podium-score-2">{{topSecond.pointsBalance || 0}}</text>
      </view>

      <!-- 第1名 -->
      <view class="podium-col col-1">
        <view class="frame frame-gold">
          <image class="frame-avatar" src="{{topFirst.avatar ? BASE_URL + topFirst.avatar : defaultPerson}}" mode="aspectFill"/>
        </view>
        <text class="podium-rank podium-rank-1">1</text>
        <text class="podium-nick podium-nick-1">{{topFirst.nickName || '--'}}</text>
        <text class="podium-score podium-score-1">{{topFirst.pointsBalance || 0}}</text>
      </view>

      <!-- 第3名 -->
      <view class="podium-col col-3">
        <view class="frame frame-jade">
          <image class="frame-avatar" src="{{topThird.avatar ? BASE_URL + topThird.avatar : defaultPerson}}" mode="aspectFill"/>
        </view>
        <text class="podium-rank podium-rank-3">3</text>
        <text class="podium-nick podium-nick-3">{{topThird.nickName || '--'}}</text>
        <text class="podium-score podium-score-3">{{topThird.pointsBalance || 0}}</text>
      </view>
    </view>

    <!-- 第4名起的列表 -->
    <view class="list-wrap">
      <view
        class="list-row {{index + 4 == 6 ? 'list-row-hl' : ''}}"
        wx:for="{{dataList}}"
        wx:key="index"
      >
        <text class="list-idx {{index + 4 == 6 ? 'list-idx-hl' : ''}}">{{index + 4}}</text>
        <view class="list-avatar-ring">
          <image class="list-avatar" src="{{item.avatar ? BASE_URL + item.avatar : defaultPerson}}" mode="aspectFill"/>
        </view>
        <text class="list-name">{{item.nickName || '--'}}</text>
        <view class="list-score-box">
          <text class="list-score">{{item.pointsBalance || 0}}</text>
          <text class="list-unit">积分</text>
        </view>
      </view>
    </view>

    <view style="height:120rpx;"></view>
  </scroll-view>
</view>
<view class="container">
  <view class="topLeadersList-container">
    <view class='view-2'>
      <view>
        <image src="{{dataTopList[1].avatar ? BASE_URL + dataTopList[1].avatar:defaultPerson}}" mode="scaleToFill" />
      </view>
      <view class='nickname'>{{dataTopList[1].nickName}}</view>
      <view class='view-2-pillar view-pillar'>
        <view>{{dataTopList[1].pointsBalance}}</view>
        <view>2</view>
      </view>
    </view>
    <view class='view-1'>
      <view>
        <image src="{{dataTopList[0].avatar ? BASE_URL + dataTopList[0].avatar:defaultPerson}}" mode="scaleToFill" />
      </view>
      <view class='nickname'>{{dataTopList[0].nickName}}</view>
      <view class='view-1-pillar view-pillar '>
        <view>{{dataTopList[0].pointsBalance}}</view>
        <view>1</view>
      </view>
    </view>
    <view class='view-3'>
      <view>
        <image src="{{dataTopList[2].avatar ? BASE_URL + dataTopList[2].avatar:defaultPerson}}" mode="scaleToFill" />
      </view>
      <view class='nickname'>{{dataTopList[2].nickName}}</view>
      <view class='view-3-pillar view-pillar'>
        <view>{{dataTopList[2].pointsBalance}}</view>
        <view>3</view>
      </view>
    </view>
  
  </view>
  <!-- <view class="rank-item user-people">
    <view class="rank-img">
      <image src="{{user.avatar ? user.avatar:defaultPerson }}"></image>
    </view>
    <view class='rank-point'>
      <view class="rank-name">{{user.nickName ? user.nickName: user.phonenumber}}</view>
      <view class="rank-price">
        积分：
        <text class='grade'>{{user.pointsBalance}}</text>
      </view>
    </view>
    <view class="rank-uv">
      <view>第 {{user.top}} 名</view>
      <image src="../../images/home/{{user.top}}.png" />
    </view>
  </view> -->
  <scroll-view class="scroll-view" scroll-y>
    <view class="rank_block">
      <view class="rank-item" wx:for="{{dataList}}" wx:key="item">
        <view class='rank-index'>
          {{index + 4}}
        </view>
        <view class="rank-img">
          <image src='{{item.avatar ? BASE_URL+ item.avatar: "../../images/home/default.png"}}' />
        </view>
        <view class='rank-point'>
          <view class="rank-name">{{item.nickName}}</view>
          <!-- <view class="rank-price">
            积分：
            <text class='grade'>{{item.pointsBalance}}</text>
          </view> -->
        </view>
        <view class="rank-uv">
            <text class='grade'>{{item.pointsBalance}}</text>
        </view> 
        <!-- <view class="rank-uv" wx:if="{{item.top<=3}}">
          <view>第 {{item.top}} 名</view>
          <image src="../../images/home/{{item.top}}.png" />
        </view> -->
      </view>
    </view>
  </scroll-view>
</view>
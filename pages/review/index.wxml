<view class="review-page">


  <view class="filter-bar">
    <view
      wx:for="{{filters}}"
      wx:key="value"
      class="filter-item {{activeFilter === item.value ? 'active' : ''}}"
      data-value="{{item.value}}"
      bindtap="onFilterChange"
    >
      {{item.label}}
    </view>
  </view>

  <view class="review-list">
    <view wx:for="{{reviews}}" wx:key="id" class="review-item">
      <view class="review-top">
        <view class="review-user-wrap">
          <image class="review-avatar" src="{{item.avatar || '../../images/new/16.png'}}" mode="aspectFill"></image>
          <text class="review-user">{{item.user || item.createBy || '用户'}}</text>
        </view>
        <text class="review-date">{{item.date || item.createTime || '刚刚'}}</text>
      </view>

      <view class="review-content-box">
        <view class="review-main">
          <view class="review-text">{{item.content || item.text || '暂无评价内容'}}</view>
          <view class="review-extra" wx:if="{{item.extra}}">{{item.extra}}</view>
        </view>
      </view>

      <view wx:if="{{item.images && item.images.length > 0}}" class="review-images">
        <image
          wx:for="{{item.images}}"
          wx:key="*this"
          class="review-image"
          src="{{item}}"
          mode="aspectFill"
        ></image>
      </view>
    </view>

    <view wx:if="{{!reviews.length && !loading}}" class="empty-state">暂无评价</view>
    <view wx:if="{{loading}}" class="list-footer">加载中...</view>
    <view wx:elif="{{noMore && reviews.length}}" class="list-footer">没有更多了</view>
  </view>
</view>

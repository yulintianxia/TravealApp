page {
  background: #090d13;
  color: #f5f2eb;
  font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

.review-page {
  min-height: 100vh;
  background: #0a0d12;
  padding: 0 20rpx 100rpx;
  box-sizing: border-box;
}

.review-header {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 110rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.header-title {
  display: block;
  text-align: center;
  font-size: 38rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.96);
  letter-spacing: 2rpx;
}

.header-actions {
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.action-dots {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  width: 90rpx;
  height: 34rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.08);
}

.action-dots text {
  display: block;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.8);
}

.action-indicator {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 0 0 4rpx rgba(255, 255, 255, 0.08);
}

.filter-bar {
  display: flex;
  gap: 60rpx;
  margin: 38rpx 0 32rpx 58rpx;
  padding: 0;
  font-size: 24rpx;
}

.filter-item {
  flex: 0 0 128rpx;
  height: 62rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: #202020;
  border: 2rpx solid #3b3b3b;
  color: #969696;
  font-size: 24rpx;
  white-space: nowrap;
  box-sizing: border-box;
}

.filter-item:first-child {
  flex-basis: 128rpx;
}

.filter-item.active {
  color: #f5f5f5;
  border-color: #454545;
  background: #202020;
}

.review-list {
  display: flex;
  flex-direction: column;
  gap: 34rpx;
  padding: 12rpx 32rpx 0;
}

.review-item {
  padding: 0;
}

.review-row {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.review-avatar {
  width: 82rpx;
  height: 82rpx;
  border-radius: 0;
  /* background: #d9d9d9; */
  flex-shrink: 0;
  margin-top: 4rpx;
}

.review-main {
  flex: 1;
  min-width: 0;
}

.review-user-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.review-user {
  color: rgba(153, 153, 153, 1);
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.4;
}

.review-date {
  color: rgba(255, 255, 255, 0.52);
  font-size: 20rpx;
  white-space: nowrap;
  line-height: 1.4;
}

.review-date-row {
  display: flex;
  justify-content: flex-end;
  margin-top: 12rpx;
}

.review-text {
  color: #f0ece7;
  font-size: 28rpx;
  line-height: 1.6;
  margin-bottom: 8rpx;
}

.review-extra {
  color: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
  line-height: 1.6;
  margin-bottom: 12rpx;
}

.review-images {
  display: flex;
  gap: 10rpx;
  overflow: hidden;
  margin-top: 18rpx;
}

.review-image {
  width: 108rpx;
  height:  108rpx;
  border-radius: 0;
  background: #1d1f22;
  flex-shrink: 0;
}

.empty-state {
  text-align: center;
  padding: 80rpx 0;
  color: rgba(255,255,255,0.6);
  font-size: 26rpx;
}

.list-footer {
  text-align: center;
  padding: 18rpx 0 0;
  color: rgba(255,255,255,0.5);
  font-size: 22rpx;
}

<!-- pages/login/login.wxml -->
<view class="dark-page">
    <view class="dark-container">
        <!-- Logo 区域：LOGIN 和 REGISTER 显示 -->
        <view class="logo-container" wx:if="{{type != 'CHANGEPWD'}}">
            <image src="../../images/home/logo.png" mode="scaleToFill" class="login_logo" />
        </view>

        <!-- ========== 登录模式 ========== -->
        <block wx:if="{{type =='LOGIN'}}">
            <view class="dark-form">
                <view class="dark-input-row">
                    <text class="dark-label">号码：</text>
                    <input class="dark-input" placeholder-style="color:rgba(255,255,255,0.3)" placeholder="请输入手机号" maxlength="{{phoneLength}}" value="{{username}}" bindinput="bindPhone" />
                </view>
                <view class="dark-input-row">
                    <text class="dark-label">密码：</text>
                    <input class="dark-input" placeholder-style="color:rgba(255,255,255,0.3)" placeholder="请输入密码" maxlength="{{codeLength}}" value="{{password}}" type="password" bindinput="bindPassword" />
                </view>
                <view class="dark-input-row">
                    <text class="dark-label">手机号：</text>
                    <input class="dark-input" placeholder-style="color:rgba(255,255,255,0.3)" placeholder="请输入手机号" maxlength="11" value="{{phoneNumber}}" type="number" bindinput="onPhoneInput" />
                </view>
                <view class="dark-input-row">
                    <text class="dark-label">验证码：</text>
                    <input class="dark-input dark-code-input" placeholder-style="color:rgba(255,255,255,0.3)" placeholder="输入验证码" value="{{code}}" type="number" maxlength="6" bindinput="onPhoneInput" />
                    <view class="dark-code-btn" bindtap='sendCode'>{{isSend ? '倒计时' + (times >= 10 ? times : '0'+ times) +'S':'发送验证码'}}</view>
                </view>
                <!-- <view class="input-btn">
                    <view class='register-view'>
                        <view class='register' bindtap="register">注册</view>
                        <button class='register register-view-button' open-type="getPhoneNumber" bindgetphonenumber="oneClicklogin" type="primary">
                            一键登录
                        </button>
                    </view>
                </view> -->
            </view>
            <view class="dark-btn-wrap">
                <view class="dark-btn" bindtap="login">登录</view>
            </view>
        </block>

        <!-- ========== 注册模式 ========== -->
        <block wx:elif="{{type =='REGISTER'}}">
            <view class="dark-form">
                <view class="dark-input-row">
                    <text class="dark-label">号码：</text>
                    <input class="dark-input" placeholder-style="color:rgba(255,255,255,0.3)" placeholder="请输入手机号" maxlength="{{phoneLength}}" value="{{username}}" bindinput="bindPhone" />
                </view>
                <view class="dark-input-row">
                    <text class="dark-label">昵称：</text>
                    <input class="dark-input" placeholder-style="color:rgba(255,255,255,0.3)" placeholder="请输入昵称" value="{{nickName}}" bindinput="bingNickName" />
                </view>
                <view class="dark-input-row">
                    <text class="dark-label">密码：</text>
                    <input class="dark-input" placeholder-style="color:rgba(255,255,255,0.3)" placeholder="请输入密码" maxlength="{{codeLength}}" value="{{password}}" type="password" bindinput="bindPassword" />
                </view>
                <view class="dark-input-row">
                    <text class="dark-label">手机号：</text>
                    <input class="dark-input" placeholder-style="color:rgba(255,255,255,0.3)" placeholder="请输入手机号" maxlength="11" value="{{phoneNumber}}" type="number" bindinput="onPhoneInput" />
                </view>
                <view class="dark-input-row">
                    <text class="dark-label">验证码：</text>
                    <input class="dark-input dark-code-input" placeholder-style="color:rgba(255,255,255,0.3)" placeholder="输入验证码" value="{{code}}" type="number" maxlength="6" bindinput="onPhoneInput" />
                    <view class="dark-code-btn" bindtap='sendCode'>{{isSend ? '倒计时' + (times >= 10 ? times : '0'+ times) +'S':'发送验证码'}}</view>
                </view>
                <view class="input-btn">
                    <view class='register-view'>
                        <view class='register' bindtap="checkLogin">去登陆</view>
                    </view>
                    <view bindtap="registerBtn" class="login-btn submit">注册</view>
                </view>
            </view>
        </block>

        <!-- ========== 修改密码模式 ========== -->
        <block wx:elif="{{type =='CHANGEPWD'}}">
            <view class="changepwd-avatar-wrap">
                <image class="changepwd-avatar" src="{{avatar}}" mode="aspectFill" />
                <text class="changepwd-nickname">{{nickName}}</text>
            </view>
            <view class="dark-form">
                <text class="changepwd-section-title">修改密码</text>
                <view class="dark-input-row">
                    <text class="dark-label">旧密码：</text>
                    <input class="dark-input" placeholder-style="color:rgba(255,255,255,0.3)" placeholder="请输入旧密码" value="{{oldPassword}}" data-key='oldPassword' bindinput="bindOld" />
                </view>
                <view class="dark-input-row">
                    <text class="dark-label">新密码：</text>
                    <input class="dark-input" placeholder-style="color:rgba(255,255,255,0.3)" placeholder="请输入新密码" value="{{newPassword}}" data-key='newPassword' bindinput="bindNew" />
                </view>
                <view class="dark-input-row">
                    <text class="dark-label">验证码：</text>
                    <input class="dark-input dark-code-input" placeholder-style="color:rgba(255,255,255,0.3)" placeholder="输入验证码" value="{{code}}" type="number" maxlength="6" bindinput="onPhoneInput" />
                    <view class="dark-code-btn" bindtap='sendCode'>{{isSend ? '倒计时' + (times >= 10 ? times : '0'+ times) +'S':'发送验证码'}}</view>
                </view>
            </view>
            <view class="dark-btn-wrap">
                <view class="dark-btn" bindtap="submitPwd">确定</view>
            </view>
        </block>
    </view>
</view>
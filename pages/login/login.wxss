/* ========== 统一暗色主题 ========== */
.dark-page {
  min-height: 100vh;
  width: 100vw;
  background: linear-gradient(180deg, #0a0f1a 0%, #0f1b30 50%, #0b1a2e 100%);
  font-family: PingFang SC, -apple-system, Helvetica Neue, Arial, sans-serif;
}

.dark-container {
  overflow: hidden;
  padding-bottom: 200rpx;
}

/* Logo */
.dark-page .logo-container {
  margin: 88rpx auto;
  text-align: center;
}

.dark-page .logo-container .login_logo {
  width: 144rpx;
  height: 144rpx;
  border-radius: 50%;
}

/* 表单区域 */
.dark-form {
  padding: 0 48rpx;
  margin-top: 20rpx;
}

/* 输入行 */
.dark-input-row {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
  height: 88rpx;
}

.dark-label {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
  width: 100rpx;
  flex-shrink: 0;
  letter-spacing: 1rpx;
}

.dark-input {
  flex: 1;
  height: 68rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #ffffff;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.dark-code-input {
  flex: 1;
  margin-right: 16rpx;
}

.dark-code-btn {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #e2c57a;
  padding: 0 16rpx;
  height: 80rpx;
  line-height: 80rpx;
  white-space: nowrap;
}

/* 操作按钮行（注册 / 一键登录 / 去登陆）- 保持原有样式 */
.dark-form .input-btn {
  width: 100%;
}

.dark-form .input-btn .login-btn {
  width: 100%;
  height: 88rpx;
  border: none;
  outline: none;
  border-radius: 16rpx;
  line-height: 88rpx;
  color: #b1b2b2;
  opacity: 1;
  margin: 28rpx auto;
  text-align: center;
  background: #f0f0f0;
}

.dark-form .input-btn .login-btn.submit {
  background: #22bee5;
  color: white;
}

/* 底部按钮 */
.dark-btn-wrap {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  padding: 20rpx 100rpx 68rpx;
  box-sizing: border-box;
  z-index: 100;
  background: linear-gradient(180deg, rgba(15, 27, 48, 0) 0%, rgba(15, 27, 48, 0.95) 40%);
}

.dark-btn {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 4rpx;
  background: linear-gradient(135deg, #e2c57a 0%, #c9a356 100%);
  border-radius: 44rpx;
  box-shadow: 0 8rpx 24rpx rgba(201, 163, 86, 0.3);
}

.dark-btn:active {
  opacity: 0.85;
}

/* ========== 修改密码模式 - 头像区域 ========== */
.changepwd-avatar-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0 48rpx;
}

.changepwd-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(201, 182, 126, 0.5);
  box-shadow: 0 0 24rpx rgba(201, 182, 126, 0.25);
}

.changepwd-nickname {
  margin-top: 20rpx;
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 500;
  letter-spacing: 2rpx;
}

.changepwd-section-title {
  display: block;
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.85);
  font-weight: 600;
  margin-bottom: 36rpx;
  letter-spacing: 2rpx;
}

.input-btn .register {
  margin-right: 0rpx;
  height: 30px !important;
  line-height: 30px !important;
}

.register-view {
  display: flex;
  justify-content: flex-end;
  text-align: left;
  font-size: 12px;
  color: #22bee5;
  height: 30px !important;
  box-sizing: border-box;
}

.register-view-button {
  height: 30px !important;
  background: transparent !important;
  font-size: 12px;
  color: #22bee5 !important;
  display: inline-block;
  margin-left: 0px;
  margin-right: 60rpx;
}
.login-page {
  background: #f7f7f7;
  min-height: 100vh;
  width: 100vw;
}
.login-page .login-container {
  overflow: hidden;
}
.login-page .login-container .logo-container {
  margin: 88rpx auto;
  text-align: center;
}
.login-page .login-container .logo-container .login_logo {
  width: 144rpx;
  height: 144rpx;
  border-radius: 50%;
}
.login-page .login-container .text-container {
  margin: 120rpx auto 112rpx;
  text-align: center;
}
.login-page .login-container .text-container view {
  height: 72rpx;
  font-size: 48rpx;
  font-family: PingFang SC-Medium, PingFang SC;
  color: #000f1a;
  line-height: 72rpx;
}
.login-page .login-container .input-container {
  width: 100%;
}
.login-page .login-container .input-container .input-view {
  margin: 0 auto;
  width: 590rpx;
}
.login-page .login-container .input-container .input-view .phone-input {
  width: 590rpx;
  /* height: 44rpx; */
  background: #ffffff;
  border-radius: 16rpx;
  opacity: 1;
  padding: 20rpx 0 20rpx 32rpx;
  color: #000f1a;
  margin-bottom: 32rpx;
  box-sizing: border-box;
}
.login-page
  .login-container
  .input-container
  .input-view
  .phone-input.password-input {
  width: 386rpx;
  padding-right: 172rpx;
}
.login-page .login-container .input-container .password-input-view {
  position: relative;
  z-index: 0;
}
.login-page .login-container .input-container .password-input-view .code {
  position: absolute;
  height: 42rpx;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 42rpx;
  top: 22rpx;
  right: 32rpx;
  z-index: 50;
}
.login-page
  .login-container
  .input-container
  .password-input-view
  .code.disabled {
  color: #b1b2b2;
}
.login-page .login-container .input-container .password-input-view .code.abled {
  color: #22bee5;
}
.login-page .login-container .input-container .login-btn {
  width: 590rpx;
  height: 88rpx;
  border: none;
  outline: none;
  border-radius: 16rpx;
  line-height: 88rpx;
  color: #b1b2b2;
  opacity: 1;
  margin: 28rpx auto;
  text-align: center;
  background: #f0f0f0;
}
.login-page .login-container .input-container .login-btn.submit {
  background: #22bee5;
  color: white;
}
.login-page .login-container .agreement-container {
  margin: 0 auto;
  width: 590rpx;
}
.login-page .login-container .agreement-container > view {
  display: flex;
  font-size: 24rpx;
  color: #b1b2b2;
}
.login-page .login-container .agreement-container .agerement-user {
  justify-content: center;
}
.login-page .login-container .agreement-container .agerement-user text {
  color: #22bee5;
}
.login-page .login-container .agreement-container .check-img {
  width: 32rpx;
  height: 32rpx;
  margin-right: 6rpx;
}
.login-page .login-container .login-extra-container {
  margin: 338rpx auto 0;
  text-align: center;
  font-size: 24rpx;
  font-weight: 400;
  color: #b1b2b2;
  line-height: 36rpx;
}
.login-page .login-container .login-extra-container .weixin-img-container {
  height: 88rpx;
  width: 88rpx;
  background-color: #f0f0f0;
  border-radius: 50%;
  margin: 28rpx auto 0;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 170rpx;
}
.login-page
  .login-container
  .login-extra-container
  .weixin-img-container
  .phone-btn {
  border: none;
  outline: none;
  cursor: none;
}
.login-page
  .login-container
  .login-extra-container
  .weixin-img-container
  .phone-btn::after {
  border: none;
  outline: none;
}
.login-page .login-container .login-extra-container .quick-btn-wrap .quick-btn {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 490rpx;
  height: 88rpx;
  margin: 28rpx auto 0;
  background: rgba(34, 190, 229, 0.15);
  color: #22bee5;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 16rpx;
  border: 0;
}
.login-page
  .login-container
  .login-extra-container
  .quick-btn-wrap
  .quick-btn::after {
  border: 0;
}
.login-page .login-container .login-extra-container image {
  width: 48rpx;
  height: 48rpx;
}
.login-page .login-container .login-extra-container .extra-login {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  top: 4rpx;
}
.login-page .login-container .login-extra-container .extra-login:before {
  margin-right: 10rpx;
}
.login-page .login-container .login-extra-container .extra-login:after {
  margin-left: 10rpx;
}
.login-page .login-container .login-extra-container .extra-login:before,
.login-page .login-container .login-extra-container .extra-login:after {
  content: "";
  display: block;
  width: 50rpx;
  height: 2rpx;
  background: #b1b2b2;
}

.input-btn .register {
 margin-right:16rpx;
}

.register-view {
  display: flex;
  justify-content: flex-end;
  text-align: left;
  margin-right: 12vw;
  font-size: 12px;
  color: #22bee5;
}
page, .page-bg {
  background: #0a0e1a;
  min-height: 100vh;
  color: #c9b67e;
  font-family: PingFangSC, Arial, sans-serif;
}

.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #0a0e1a;
  height: 88rpx;
}
.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
  letter-spacing: 2rpx;
}
.nav-bar-btns {
  position: absolute;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  align-items: center;
}
.nav-dot {
  width: 8rpx;
  height: 8rpx;
  background: #fff;
  border-radius: 50%;
  margin-right: 8rpx;
  opacity: 0.5;
}
.nav-circle {
  width: 24rpx;
  height: 24rpx;
  border: 2rpx solid #fff;
  border-radius: 50%;
  margin-left: 8rpx;
  opacity: 0.7;
}

.card-swiper {
  margin-top: 120rpx;
  width: 100vw;
  white-space: nowrap;
  overflow-x: scroll;
  height: 320rpx;
}
.card-list {
  display: flex;
  flex-direction: row;
  align-items: center;
}
.member-card {
  width: 700rpx;
  height: 320rpx;
  margin-right: 32rpx;
  border-radius: 32rpx;
  background-size: cover;
  background-position: center;
  position: relative;
  overflow: hidden;
  display: inline-block;
}
.card-content {
  position: relative;
  z-index: 1;
  height: 100%;
  padding: 40rpx 32rpx;
  box-sizing: border-box;
}
.card-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
.level-badge {
  background: #c9b67e;
  color: #fff;
  border-radius: 8rpx;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  margin-right: 12rpx;
}
.level-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
  margin-right: 8rpx;
}
.level-v {
  font-size: 28rpx;
  color: #ffe5a0;
  font-weight: 700;
}
.card-quote {
  color: #fff;
  font-size: 22rpx;
  margin: 24rpx 0 0 0;
  opacity: 0.9;
}
.card-deer {
  position: absolute;
  right: 32rpx;
  bottom: 0;
  width: 220rpx;
  height: 220rpx;
}

.level-progress {
  margin: 32rpx 32rpx 0 32rpx;
  background: transparent;
  position: relative;
}
.level-label {
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}
.progress-bar {
  width: 100%;
  height: 8rpx;
  background: #23262f;
  border-radius: 8rpx;
  margin: 8rpx 0 16rpx 0;
  position: relative;
}
.progress-inner {
  height: 100%;
  background: linear-gradient(90deg, #ffe5a0, #c9b67e);
  border-radius: 8rpx;
  transition: width 0.3s;
}
.level-icons {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-top: 16rpx;
}
.level-icon {
  width: 48rpx;
  height: 48rpx;
  opacity: 0.7;
  transition: transform 0.5s;
}
.level-icon.active {
  opacity: 1;
  /* 动画由js控制 */
}

.member-stats {
  margin: 32rpx 24rpx 0 24rpx;
  background: rgba(255,255,255,0.06);
  border-radius: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 0;
}
.stat-item {
  flex: 1;
  text-align: center;
}
.stat-value {
  font-size: 32rpx;
  color: #ffe5a0;
  font-weight: 700;
}
.stat-label {
  font-size: 20rpx;
  color: #c9b67e;
  margin-top: 8rpx;
}

.section-title {
  margin: 40rpx 32rpx 0 32rpx;
  font-size: 28rpx;
  color: #fff;
  font-weight: 600;
}
.section-count {
  font-size: 20rpx;
  color: #c9b67e;
  margin-left: 8rpx;
}
.rights-card {
  margin: 24rpx 24rpx 0 24rpx;
  background: rgba(255,255,255,0.06);
  border-radius: 24rpx;
  display: flex;
  padding: 32rpx 0;
  justify-content: flex-start;
}
.right-item {
  flex: none;
  width: 160rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 32rpx;
}
.right-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 2rpx solid #c9b67e;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}
.right-icon image {
  width: 48rpx;
  height: 48rpx;
}
.right-title {
  color: #fff;
  font-size: 22rpx;
  margin-top: 4rpx;
}
<view class="market-page">


  <view class="hero-zone">
    <view class="hero-year">2026</view>
    <view class="hero-vertical">
      <text>五星树玉</text>
    </view>
    <image class="hero-image" src="{{bannerImage}}" mode="aspectFill"></image>
  </view>

  <view class="tab-bar">
    <view
      wx:for="{{tabs}}"
      wx:key="*this"
      class="tab-item {{activeTab === item.value ? 'active' : ''}}"
      data-tab="{{item.value}}"
      bindtap="onTabChange"
    >
      {{item.label}}
    </view>
  </view>

  <block wx:if="{{activeTab === 'reviews'}}">
    <view class="review-wrap">
      <view class="review-filters">
        <view
          wx:for="{{reviewFilters}}"
          wx:key="*this"
          class="review-filter {{activeReviewFilter === item.value ? 'active' : ''}}"
          data-filter="{{item}}"
          bindtap="onReviewFilterChange"
        >
          {{item}}
        </view>
      </view>

      <view class="review-list">
        <view wx:for="{{reviews}}" wx:key="id" class="review-item">
          <view class="review-head">
            <image class="review-avatar" src="{{item.avatar}}" mode="aspectFill"></image>
            <view class="review-user">{{item.user}}</view>
          </view>

          <view class="review-content-box">
            <view class="review-main">
              <view class="review-text">{{item.content}}</view>
              <view class="review-extra">{{item.extra}}</view>
            </view>
            <view class="review-date">{{item.date}}</view>
          </view>
          <view wx:if="{{item.images && item.images.length > 0}}" class="review-images">
            <image
              wx:for="{{item.images}}"
              wx:key="*this"
              class="review-image"
              src="{{item}}"
              mode="aspectFill"
            ></image>
          </view>
        </view>
      </view>
    </view>
  </block>

  <block wx:else>
    <view class="market-content">
      <view class="market-sidebar">
        <view
          wx:for="{{categories}}"
          wx:key="*this"
          class="sidebar-item {{activeCategory === item.key ? 'active' : ''}}"
          data-category="{{item.key}}"
          bindtap="onCategoryChange"
        >
          {{item.label}}
        </view>
      </view>

      <view class="market-products">
        <view class="product-grid">
          <view
            wx:for="{{products}}"
            wx:key="id"
            class="product-card"
            data-id="{{item.keyId || item.id}}"
            bindtap="goToDetail"
          >
            <image class="product-thumb" src="{{item.mainPicture}}" mode="aspectFill"></image>
            <view class="product-name">{{item.name}}</view>
            <view class="product-tags">
              <text class="chip" wx:for="{{item.tags}}" wx:key="*this">{{item.name}}</text>
            </view>
            <view class="product-price">
              <image class="price-dot" src="../../images/home/points.png" mode="aspectFit"></image>
              <text>{{item.pointsPrice}}积分/副</text>
            </view>
          </view>
        </view>

        <view class="list-footer" wx:if="{{products.length}}">
          <text wx:if="{{loading}}">加载中...</text>
          <text wx:elif="{{noMore}}">没有更多了</text>
        </view>
      </view>
    </view>
  </block>

</view>

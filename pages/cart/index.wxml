<view class="cart-page">
  <view class="cart-header">
    <view class="header-back" bindtap="goBack">‹</view>
    <view class="header-title">购物车</view>
    <view class="header-actions">
      <view class="action-dots">
        <text></text>
        <text></text>
        <text></text>
      </view>
      <view class="action-indicator" bindtap="openCustomerService"></view>
    </view>
  </view>

  <view class="cart-list">
    <block wx:for="{{cartList}}" wx:key="id">
      <view class="cart-item">
        <view class="checkbox {{selectedIds.indexOf(item.id) !== -1 ? 'checked' : ''}}" data-id="{{item.id}}" bindtap="toggleSelect">
          <text wx:if="{{selectedIds.indexOf(item.id) !== -1}}">✓</text>
        </view>

        <view class="product-image-wrap">
          <image class="product-image" src="{{item.image}}" mode="aspectFill"></image>
        </view>

        <view class="product-info">
          <view class="product-name">{{item.name}}</view>
          <view class="product-meta">{{item.size}} {{item.material}}</view>
          <view class="product-amount-row">
            <view class="product-price">{{item.price}}积分/副</view>
            <view class="stepper">
              <view class="step-btn minus" data-id="{{item.id}}" data-type="minus" bindtap="changeCount">-</view>
              <view class="step-value">{{item.count}}</view>
              <view class="step-btn plus" data-id="{{item.id}}" data-type="plus" bindtap="changeCount">+</view>
            </view>
          </view>
        </view>
      </view>
    </block>
  </view>

  <view class="bottom-bar">
    <view class="select-all" bindtap="toggleSelectAll">
      <view class="checkbox {{selectedAll ? 'checked' : ''}}">
        <text wx:if="{{selectedAll}}">✓</text>
      </view>
      <text>全选</text>
    </view>

    <view class="summary">
      <text>总计：</text>
      <text class="summary-value">{{totalPoints}}积分</text>
    </view>

    <view class="checkout-button" bindtap="checkout">结算</view>
  </view>

  <view class="tip-mask" wx:if="{{showQrCode}}" bindtap="closeQrPopup">
    <view class="tip-dialog" catchtap="">
      <image class="qr-image" src="{{chatImg}}" mode="aspectFit" />
      <view class="qr-label">添加客服微信</view>
      <view class="tip-btn" bindtap="closeQrPopup">知道了</view>
    </view>
  </view>
</view>

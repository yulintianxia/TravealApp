<view class="cart-page">
  <view class="cart-list">
    <block wx:for="{{cartList}}" wx:key="id">
      <view class="cart-item">
        <view class="item-selector">
          <view
            class="checkbox {{item.isSelected ? 'checked' : ''}}"
            data-index="{{index}}"
            catchtap="toggleSelect">
            <text wx:if="{{item.isSelected}}">✓</text>
          </view>
        </view>
        <view class="product-image-wrap">
          <image class="product-image" src="{{item.goodsPicture}}" mode="aspectFill"></image>
        </view>

        <view class="product-info">
          <view class="product-title-row">
            <view class="product-name">{{item.goodsName}}</view>
            <view class="delete-btn" data-index="{{index}}" data-id="{{item.keyId}}" catchtap="deleteItem">删除</view>
          </view>
          <view class="product-meta">{{item.size}} {{item.material}}</view>
          <view class="product-amount-row">
            <view class="product-price">{{item.pointsPrice}}积分/副</view>
            <view class="stepper">
              <view class="step-btn minus" data-index="{{index}}" data-type="minus" data-id="{{item.keyId}}" catchtap="changeCount">-</view>
              <view class="step-value">{{item.quantity}}</view>
              <view class="step-btn plus" data-index="{{index}}" data-type="plus" data-id="{{item.keyId}}" catchtap="changeCount">+</view>
            </view>
          </view>
        </view>
      </view>
    </block>
  </view>

  <view class="bottom-bar">
    <view class="select-all" bindtap="toggleSelectAll">
      <view class="checkbox {{selectedAll ? 'checked' : ''}}">
        <text wx:if="{{selectedAll}}">✓</text>
      </view>
      <text>全选</text>
    </view>

    <view class="summary">
      <text>总计：</text>
      <text class="summary-value">{{totalPoints}}积分</text>
    </view>
    <view class="checkout-button" bindtap="checkout">兑换</view>
  </view>
</view>

/* pages/address/index.wxss */
page {
  background: #0d0d1a;
  height: 100%;
}

.page-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #1a1a2e 0%, #0d0d1a 100%);
  padding-bottom: 180rpx;
}

.content {
  padding: 0 32rpx;
}

/* 区域标题 */
.section-title {
  font-size: 28rpx;
  color: #c9a96e;
  padding: 24rpx 0 20rpx 0;
}

.section-divider {
  height: 1rpx;
  background: rgba(255, 255, 255, 0.1);
  margin-bottom: 36rpx;
}

/* 表单项 */
.form-item {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}

.form-label {
  font-size: 28rpx;
  color: #e0d5c1;
  width: 150rpx;
  flex-shrink: 0;
}

.form-input-wrap {
  flex: 1;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 12rpx;
  padding: 22rpx 24rpx;
}

.form-input-wrap input,
.form-input-wrap .textarea-class {
  font-size: 28rpx;
  color: #ffffff;
  width: 100%;
}

.textarea-class {
  min-height: 40rpx;
  width: 100%;
}

.phcolor {
  color: #666666;
  font-size: 28rpx;
}

/* 标签行 */
.label-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0 36rpx 0;
}

.label-title {
  font-size: 28rpx;
  color: #e0d5c1;
  width: 120rpx;
  flex-shrink: 0;
}

.label-list {
  display: flex;
  gap: 24rpx;
  flex-wrap: wrap;
}

.label-tag {
  padding: 10rpx 36rpx;
  font-size: 26rpx;
  color: #999999;
  border: 1rpx solid #555555;
  border-radius: 8rpx;
  background: transparent;
}

.label-active {
  background: #c9a96e !important;
  color: #1a1a2e !important;
  border-color: #c9a96e !important;
  font-weight: bold;
}

/* 默认地址 */
.default-section {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 20rpx 0;
}

.default-left {
  flex: 1;
}

.default-title {
  font-size: 28rpx;
  color: #c9a96e;
  margin-bottom: 10rpx;
}

.default-desc {
  font-size: 24rpx;
  color: #888888;
}

.default-right {
  flex-shrink: 0;
  padding-top: 4rpx;
}

/* 保存按钮 */
.save-btn {
  position: fixed;
  bottom: 60rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 520rpx;
  height: 88rpx;
  background: linear-gradient(135deg, #c9a96e 0%, #b8944d 100%);
  color: #1a1a2e;
  font-size: 34rpx;
  font-weight: bold;
  text-align: center;
  line-height: 88rpx;
  border-radius: 44rpx;
  letter-spacing: 4rpx;
}

.save-btn:active {
  opacity: 0.85;
}
/* pages/addressList/index.wxss */
page {
  background: #0d0d1a;
  height: 100%;
}

.page-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #1a1a2e 0%, #0d0d1a 100%);
  padding-bottom: 160rpx;
}

.content {
  padding: 0 24rpx;
}

/* ========== 地址卡片 ========== */
.address-card {
  background: rgba(255, 255, 255, 0.08);
  border-radius: 16rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
}

/* 卡片头部：姓名 + 手机 */
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.card-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #ffffff;
}

.card-phone {
  font-size: 30rpx;
  color: #ffffff;
}

/* 地址详情 */
.card-address {
  font-size: 26rpx;
  color: #999999;
  line-height: 1.6;
  margin-bottom: 28rpx;
}

/* 卡片底部 */
.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
}

.card-footer-left {
  display: flex;
  align-items: center;
}

.default-label {
  font-size: 24rpx;
  color: #999999;
  margin-right: 12rpx;
}

.default-dot {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: #444444;
  transition: background 0.3s;
}

.default-dot.dot-active {
  background: #c9a96e;
}

.card-footer-right {
  display: flex;
  gap: 20rpx;
}

.card-btn {
  padding: 8rpx 28rpx;
  font-size: 24rpx;
  color: #cccccc;
  border: 1rpx solid #555555;
  border-radius: 8rpx;
  background: transparent;
}

.card-btn:active {
  opacity: 0.7;
}

.card-btn-delete {
  color: #cccccc;
  border-color: #555555;
}

/* ========== 空状态 ========== */
.empty-tip {
  text-align: center;
  padding-top: 200rpx;
  color: #666666;
  font-size: 28rpx;
}

/* ========== 底部新增按钮 ========== */
.add-btn {
  position: fixed;
  bottom: 60rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 520rpx;
  height: 88rpx;
  background: linear-gradient(135deg, #c9a96e 0%, #b8944d 100%);
  color: #1a1a2e;
  font-size: 34rpx;
  font-weight: bold;
  text-align: center;
  line-height: 88rpx;
  border-radius: 44rpx;
  letter-spacing: 4rpx;
}

.add-btn:active {
  opacity: 0.85;
}
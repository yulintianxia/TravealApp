page {
    background: #f7f5f2;
}

.store-page {
    min-height: 100vh;
    overflow: hidden;
    color: #171514;
    background: #f7f5f2;
}

.store-hero {
    position: relative;
    height: 900rpx;
    overflow: hidden;
    background:
        radial-gradient(circle at 14% 18%, rgba(255, 255, 255, 0.15) 0 4rpx, transparent 5rpx),
        radial-gradient(circle at 76% 30%, rgba(255, 255, 255, 0.12) 0 3rpx, transparent 4rpx),
        linear-gradient(135deg, #9b6c3b 0%, #d3aa75 42%, #70502f 100%);
}

.store-hero::after {
    content: "";
    position: absolute;
    left: -5%;
    right: -5%;
    bottom: -90rpx;
    height: 190rpx;
    background: #f7f5f2;
    border-radius: 50% 50% 0 0;
    transform: rotate(-4deg);
}

.hero-copy {
    position: absolute;
    left: 72rpx;
    top: 250rpx;
    z-index: 2;
    display: flex;
    flex-direction: column;
    color: #fffdf9;
}

.hero-kicker {
    order: 2;
    margin-top: 20rpx;
    font-size: 25rpx;
    letter-spacing: 2rpx;
}

.hero-title {
    font-size: 80rpx;
    font-weight: 700;
    line-height: 1;
}

.hero-subtitle {
    order: 3;
    margin-top: 28rpx;
    font-size: 40rpx;
    letter-spacing: 4rpx;
}

.phone-preview {
    position: absolute;
    top: 90rpx;
    right: -115rpx;
    z-index: 3;
    width: 520rpx;
    height: 920rpx;
    padding: 34rpx 18rpx;
    box-sizing: border-box;
    border: 10rpx solid #f7f7f7;
    border-radius: 72rpx;
    background: #24191b;
    box-shadow: -12rpx 18rpx 30rpx rgba(44, 25, 12, 0.25);
    transform: rotate(-2deg);
}

.phone-speaker {
    position: absolute;
    top: 16rpx;
    left: 205rpx;
    width: 100rpx;
    height: 14rpx;
    border-radius: 10rpx;
    background: #111;
}

.phone-screen {
    height: 100%;
    padding: 38rpx 18rpx 20rpx;
    box-sizing: border-box;
    background: #fff;
    border-radius: 48rpx;
}

.phone-nav, .shop-profile, .shop-tabs {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.phone-nav { color: #4b3231; font-size: 28rpx; }
.phone-search { padding: 8rpx 34rpx; border-radius: 24rpx; background: #f1eeee; color: #947b79; font-size: 18rpx; }
.shop-profile { justify-content: flex-start; margin-top: 38rpx; gap: 18rpx; }
.shop-profile image { width: 70rpx; height: 70rpx; border-radius: 50%; background: #a52f37; }
.shop-name { display: block; font-size: 25rpx; font-weight: 600; }
.shop-sales { display: block; margin-top: 8rpx; color: #999; font-size: 18rpx; }
.shop-tabs { margin-top: 42rpx; color: #999; font-size: 20rpx; }
.shop-tabs text:first-child { color: #222; font-weight: 600; border-bottom: 4rpx solid #222; padding-bottom: 10rpx; }
.phone-product { margin-top: 28rpx; padding: 24rpx; border-radius: 18rpx; background: #f7fafb; color: #766f6b; font-size: 25rpx; }
.product-art { height: 170rpx; margin-bottom: 22rpx; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 36rpx; background: linear-gradient(135deg, #eee8dd, #bd9b77); }
.product-count { display: block; margin-top: 10rpx; color: #bbb; font-size: 20rpx; }

.qr-panel {
    position: relative;
    z-index: 4;
    margin-top: -20rpx;
    padding: 20rpx 40rpx 120rpx;
    text-align: center;
    background: #f7f5f2;
}

.qr-frame { width: 560rpx; max-width: 100%; margin: 0 auto; padding: 24rpx; box-sizing: border-box; background: #fff; }
.store-qr { width: 100%; height: 520rpx; display: block; }
.qr-caption { margin-top: 28rpx; font-size: 34rpx; letter-spacing: 1rpx; }
.qr-tip { margin-top: 14rpx; color: #999; font-size: 23rpx; }
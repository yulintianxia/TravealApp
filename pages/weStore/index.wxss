page {
    background: #f7f5f2;
}

.store-page {
    min-height: 100vh;
    overflow: hidden;
    color: #171514;
    background: #f7f5f2;
}

.store-hero {
    position: relative;
    height: 900rpx;
    overflow: hidden;
    background:
        radial-gradient(circle at 14% 18%, rgba(255, 255, 255, 0.15) 0 4rpx, transparent 5rpx),
        radial-gradient(circle at 76% 30%, rgba(255, 255, 255, 0.12) 0 3rpx, transparent 4rpx),
        linear-gradient(135deg, #9b6c3b 0%, #d3aa75 42%, #70502f 100%);
}

.store-hero::after {
    content: "";
    position: absolute;
    left: -5%;
    right: -5%;
    bottom: -90rpx;
    height: 190rpx;
    background: #f7f5f2;
    border-radius: 50% 50% 0 0;
    transform: rotate(-4deg);
}

.hero-copy {
    position: absolute;
    left: 72rpx;
    top: 200rpx;
    z-index: 2;
    display: flex;
    flex-direction: column;
    color: #fffdf9;
}

.hero-kicker {
    order: 2;
    margin-top: 20rpx;
    font-size: 25rpx;
    letter-spacing: 2rpx;
}

.hero-title {
    font-size: 70rpx;
    font-weight: 700;
    line-height: 1;
}

.hero-subtitle {
    order: 3;
    margin-top: 28rpx;
    font-size: 30rpx;
    letter-spacing: 4rpx;
}

.phone-preview {
    position: absolute;
    top: 70rpx;
    right: 10rpx;
    z-index: 3;
    width: 500rpx;
    line-height: 0;
    /* transform: rotate(-2deg); */
}

.phone-image {
    width: 100%;
    display: block;
}

.qr-panel {
    position: relative;
    z-index: 4;
    margin-top: -20rpx;
    padding: 20rpx 40rpx 120rpx;
    text-align: center;
    background: #f7f5f2;
}

.qr-frame { width: 560rpx; max-width: 100%; margin: 0 auto; padding: 24rpx; box-sizing: border-box; background: #fff; }
.store-qr { width: 100%; height: 520rpx; display: block; }
.qr-caption { margin-top: 28rpx; font-size: 34rpx; letter-spacing: 1rpx; }
.qr-tip { margin-top: 14rpx; color: #999; font-size: 23rpx; }
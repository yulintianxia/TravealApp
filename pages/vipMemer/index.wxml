<view class='vip_page'>
    <view class='container' style='background-image: url({{backGroundImg}})'>
        <view class='swiper-container transitionDuration'>
            <swiper autoplay="{{false}}" bindchange="swiperChange" current="{{current}}" class="swiper-card-box" duration="{{500}}" indicatorDots="{{false}}" snapToEdge="{{true}}">
                <swiper-item class='swiper-card-item' wx:for="{{levelList}}" wx:key="index">
                    <view class='container_header'>
                        <view class='vip_title'>{{item.name}}</view>
                        <!-- <view class='vip_date'>有效期至{{item.time}}</view> -->
                        <view class='vip_date'>{{item.remark}}</view>
                    </view>
                    <view class='peak-box'>
                        <view class='peak-list'>
                            <view class="peak-list-item transitionDuration_5 {{current == index  ? 'currentList':'noCurrentList'}}">
                                <view class="peak-content transitionDuration_5">
                                    <view class="peak-content transitionDuration_5">
                                        <view class="peak-content_base peak_img {{current == index ? 'currentActive transitionDuration_5':''}}" style="background-image: url({{item.mountain ? BASE_URL + item.mountain: imgUrl}});"></view>
                                        <view class='cloud cur cloud0'>
                                            <image src="/photo/1.png" />
                                        </view>
                                        <view class='cloud cur cloud1'>
                                            <image src="{{baseImageUrl}} + /photo/2.png" />
                                        </view>
                                        <view class='cloud cur cloud2'>
                                            <image src="{{baseImageUrl}} + /photo/3.png" />
                                        </view>
                                    </view>
                                </view>
                            </view>
                            <view class="line webp">
                                <view bindtap='swiperPre' wx:if='{{current>0}}' class="item transitionDuration_5 {{current > 0 ?'prev1':''}}">
                                    V{{index}}
                                </view>
                                <view class="item transitionDuration_5  {{current == index ? 'current':''}}">
                                    V{{index + 1}}
                                </view>
                                <view bindtap='swiperNext' wx:if='{{current + 1 < levelList.length}}' class="item  transitionDuration_5 {{current + 1 <= levelList.length ? 'next1':''}}">
                                    V{{index+2}}
                                </view>
                            </view>
                        </view>
                    </view>
                    <view class='peak-box-card' catchtouchmove="catchtouchmove">
                        <view class='peak-box-card-title'>可享2项权益</view>
                        <view class='peak-box-card-list'>
                            <view bindtap='turnBadgePage'>
                                <view>
                                    <image src="../../images/home/grade.png"></image>
                                </view>
                                <view>徽章</view>
                            </view>
                            <view bindtap='turnGiftPage'>
                                <view>
                                    <image src="../../images/home/gift.png"></image>
                                </view>
                                <view>商品</view>
                            </view>
                        </view>
                    </view>
                </swiper-item>
            </swiper>
            <view class='level-container'>
                <view class='level_list'>
                    <view bindtap='turnHome'>
                        <view class='level_point'>{{pointsStart}}</view>
                        <view>等级所需积分</view>
                    </view>
                    <view bindtap='turnPoint'>
                        <view class='level_point'>{{pointsBalance}}</view>
                        <view>我的积分</view>
                    </view>
                      <view bindtap='turnHome'>
                        <view class='level_point'>排名: {{top}}</view>
                        <view>个人中心</view>
                    </view>
                    <view class='img-list-wrap-container' bindtap='turnMyBadge'>
                        <view class='img-list-wrap level_point'>
                            <image src="../../images/home/vergrade.png" mode="scaleToFill" />
                            <text>{{medalCount}}</text>
                        </view>
                        <view>我的勋章</view>
                    </view>
                  
                </view>
            </view>
        </view>
    </view>
</view>
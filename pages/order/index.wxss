/* pages/order/index.wxss */
page {
    background: rgb(117, 116, 116);
}

.custom-tabs {
    margin-bottom: 32rpx;
}

.scroll-y {
    background: #f7f7f7;
    height: 100vh;
}

.no-list {
    width: 100%;
    height: 100vh;
}

.no-list image {
    width: 100%;
    height: 100%;
}

/* 内容 */
.con_first {
    width: 96%;
    padding: 20rpx;
    background-color: #fff;
    border-radius: 20rpx;
    /* background-color:red; */
    text-align: center;
    margin: 20rpx auto 0;
}

.turn-pay {
    flex: 1;
    text-align: end;
}

.list-top {
    display: flex;
    margin-bottom: 20rpx;
}

.good-view {
    display: flex;
    margin-bottom: 16rpx;
}

.good-view image {
    width: 130rpx;
    height: 130rpx;
    border-radius: 20rpx;
}

.good-view-content {
    margin-left: 20rpx;
    margin-left: 20rpx;
    /* margin-top: 10rpx; */
    align-items: center;
    display: flex;
}

.total {
    flex: 1;
    margin-top: 10rpx;
    text-align: right;
}

.pay-price {
    flex: 1;
    text-align: end;
}


.list-bottom {
    border-top: 1px solid rgb(233, 229, 229);

    width: 100%;
    height: 70rpx;
}

.con_zise {
    border: 1px solid red;
    padding: 6rpx 18rpx;
    border-radius: 100rpx;
    display: inline-block;
    margin-top: 16rpx;
    color:red;
}

.con_zise.check-stat {
    border: 1px solid red;
    color: red;
}

.commodityPrice {
    color:red;
    font-weight: 600;
    font-size: 15px;
}
.order-num {
    margin-top: 26rpx;
}

.good-view-content view {
     font-size: 15px;
     font-weight: 600;
}

.blank {
    margin-top: 300rpx;
    text-align: center;
    font-size: 32rpx;
    color: #888;
  }
.pay-time-flex {
    justify-content: space-between;
    align-items: center;
}

.pay-time-flex .pay-time {
    font-size: 26rpx;
}
.pay-botttom {
    padding-bottom: 10rpx;
}

.turn-order>text{
    color:grey;
}
.order-num>text{
       color:grey;
}
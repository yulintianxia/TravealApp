/* pages/order/index.wxss */
page {
  background: #0d0e1f;
}

/* ========== Tab Bar ========== */
.tab-bar {
  display: flex;
  background: #0d0e1f;
  padding: 12rpx 0 0;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0 16rpx;
  position: relative;
}

.tab-text {
  font-size: 30rpx;
  color: #5a5a6a;
  font-weight: 400;
}

.tab-item.active .tab-text {
  color: #e8d5b5;
  font-weight: 600;
}

.tab-line {
  width: 40rpx;
  height: 4rpx;
  background: #c9a55a;
  border-radius: 2rpx;
  margin-top: 10rpx;
}

/* ========== Scroll & Empty ========== */
.order-scroll {
  background: #0d0e1f;
}

.empty-state {
  display: flex;
  justify-content: center;
  align-items: center;
  padding-top: 300rpx;
}

.empty-text {
  color: #5a5a6a;
  font-size: 30rpx;
}

/* ========== Order List ========== */
.order-list {
  padding: 16rpx 24rpx 40rpx;
}

/* ========== Order Card ========== */
.order-card {
  background: #1a1b2e;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  border-left: 6rpx solid #c9a55a;
}

.card-body {
  display: flex;
  align-items: flex-start;
}

/* Product Image */
.product-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

/* Product Info */
.product-info {
  flex: 1;
  margin-left: 20rpx;
  overflow: hidden;
  min-height: 160rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.name-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-bottom: 8rpx;
}

.product-name {
  font-size: 32rpx;
  color: #e8d5b5;
  font-weight: 600;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.product-desc {
  font-size: 24rpx;
  color: #8a8a9a;
  display: block;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-spec {
  font-size: 22rpx;
  color: #6a6a7a;
  display: block;
  margin-top: 6rpx;
}

/* Price Column */
.price-col {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
  margin-left: 16rpx;
  padding-top: 8rpx;
}

.price-row {
  display: flex;
  align-items: baseline;
}

.price-symbol {
  font-size: 26rpx;
  color: #c9a55a;
  font-weight: 600;
}

.price-num {
  font-size: 36rpx;
  color: #c9a55a;
  font-weight: 700;
  line-height: 1;
}

.amount {
  font-size: 26rpx;
  color: #8a8a9a;
  margin-top: 8rpx;
}

/* Card Footer */
.card-footer {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
}

.status-text {
  font-size: 26rpx;
  color: #8a8a9a;
}

/* Card Action (确认收货) */
.card-action {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #2a2b3e;
}

.confirm-btn {
  font-size: 26rpx;
  color: #c9a55a;
  border: 1rpx solid #c9a55a;
  padding: 12rpx 40rpx;
  border-radius: 40rpx;
}

/* ========== History Divider ========== */
.history-divider {
  display: flex;
  align-items: center;
  padding: 48rpx 20rpx 32rpx;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background: #2a2b3e;
}

.divider-text {
  font-size: 26rpx;
  color: #5a5a6a;
  padding: 0 28rpx;
}
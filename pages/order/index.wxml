<!-- pages/order/index.wxml -->
<wxs module="getDate" src="./state.wxs"></wxs>

<view class="order-page">
  <!-- Tab Bar -->
  <view class="tab-bar">
    <view class="tab-item {{value == 'all' ? 'active' : ''}}" data-value="all" bindtap="onTabClick">
      <text class="tab-text">全部</text>
      <view class="tab-line" wx:if="{{value == 'all'}}"></view>
    </view>
    <view class="tab-item {{value == '1' ? 'active' : ''}}" data-value="1" bindtap="onTabClick">
      <text class="tab-text">待发货</text>
      <view class="tab-line" wx:if="{{value == '1'}}"></view>
    </view>
    <view class="tab-item {{value == '2' ? 'active' : ''}}" data-value="2" bindtap="onTabClick">
      <text class="tab-text">待收货</text>
      <view class="tab-line" wx:if="{{value == '2'}}"></view>
    </view>
    <view class="tab-item {{value == '3' ? 'active' : ''}}" data-value="3" bindtap="onTabClick">
      <text class="tab-text">已收货</text>
      <view class="tab-line" wx:if="{{value == '3'}}"></view>
    </view>
  </view>

  <!-- Order List -->
  <scroll-view
    class="order-scroll"
    scroll-y
    lower-threshold="30"
    bindscrolltolower="onReachBottom"
    style="height: {{scrollHeight}}px;"
  >
    <!-- 空状态 -->
    <view wx:if="{{goodList.length === 0}}" class="empty-state">
      <text class="empty-text">暂无订单</text>
    </view>

    <view wx:else class="order-list">
      <!-- 当前订单（全部 tab 时排除已收货，其他 tab 显示全部） -->
      <block wx:for="{{goodList}}" wx:key="keyId">
        <view class="order-card" wx:if="{{value != 'all' || item.status != 3}}">
          <view class="card-body">
            <image class="product-img" src="{{BASE_URL + item.commodityPicture}}" mode="aspectFill"></image>
            <view class="product-info">
              <view class="name-row">
                <text class="product-name">{{item.commodityName}}</text>
              </view>
              <text class="product-desc" wx:if="{{item.commodityDesc}}">{{item.commodityDesc}}</text>
              <text class="product-spec" wx:if="{{item.commoditySpec}}">【{{item.commoditySpec}}】</text>
            </view>
            <view class="price-col">
              <view class="price-row">
                <text class="price-symbol">¥</text>
                <text class="price-num">{{item.commodityPrice}}</text>
              </view>
              <text class="amount">x{{item.commodityAmount}}</text>
            </view>
          </view>
          <view class="card-footer">
            <text class="status-text">{{getDate.judgmentState(item.status)}}</text>
          </view>
          <view class="card-action" wx:if="{{item.status == 2}}">
            <view class="confirm-btn" bindtap="orderChcek" data-id="{{item.keyId}}">确认收货</view>
          </view>
        </view>
      </block>

      <!-- 历史订单分隔线（仅全部 tab 且存在已收货订单时显示） -->
      <block wx:if="{{value == 'all' && getDate.hasStatusInList(goodList, 3)}}">
        <view class="history-divider">
          <view class="divider-line"></view>
          <text class="divider-text">历史订单</text>
          <view class="divider-line"></view>
        </view>

        <block wx:for="{{goodList}}" wx:key="keyId">
          <view class="order-card" wx:if="{{item.status == 3}}">
            <view class="card-body">
              <image class="product-img" src="{{BASE_URL + item.commodityPicture}}" mode="aspectFill"></image>
              <view class="product-info">
                <view class="name-row">
                  <text class="product-name">{{item.commodityName}}</text>
                </view>
                <text class="product-desc" wx:if="{{item.commodityDesc}}">{{item.commodityDesc}}</text>
                <text class="product-spec" wx:if="{{item.commoditySpec}}">【{{item.commoditySpec}}】</text>
              </view>
              <view class="price-col">
                <view class="price-row">
                  <text class="price-symbol">¥</text>
                  <text class="price-num">{{item.commodityPrice}}</text>
                </view>
                <text class="amount">x{{item.commodityAmount}}</text>
              </view>
            </view>
            <view class="card-footer">
              <text class="status-text">{{getDate.judgmentState(item.status)}}</text>
            </view>
          </view>
        </block>
      </block>
    </view>
  </scroll-view>
</view>
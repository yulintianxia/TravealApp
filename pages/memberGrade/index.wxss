  flex-direction: row;
  align-items: center;
  margin-bottom: 24rpx;
}

.level-tag {
  display: inline-block;
  background: linear-gradient(137.27deg, rgba(255, 202, 162, 0.85) 0%, rgba(225, 188, 122, 0.85) 100%);
  color: #fff;
  font-size: 22rpx;
  padding: 8rpx 24rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.level-name {
  font-size: 28rpx;
  font-weight: 700;
  /* color: #e8d5a3; */

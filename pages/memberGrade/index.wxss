/* pages/memberGrade/index.wxss */

.member-grade-page {
  min-height: 100vh;
  background-color: #1a1a2e;
  padding-bottom: 120rpx;
}

/* ========== 顶部卡片轮播（卡片折叠） ========== */
.card-stack-container {
  position: relative;
  width: 100%;
  height: 460rpx;
  /* margin-top: 20rpx; */
}

/* 后面露出的下一张卡片：宽度不变，向右偏移 */
.card-peek {
  position: absolute;
  top: 10rpx;
  left: 50%;
  transform: translateX(calc(-50% + 12rpx));
  width: 686rpx;
  height: 400rpx;
  z-index: 0;
  border-radius: 24rpx;
  overflow: hidden;
  transition: all 0.35s ease;
}

.card-peek-bg {
  width: 100%;
  height: 100%;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  background-color: #2a2a4a;
  border-radius: 24rpx;
}

.card-peek-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(20, 20, 40, 0.65);
  border-radius: 24rpx;
}

/* 当前卡片 swiper */
.card-swiper {
  position: relative;
  width: 100%;
  height: 460rpx;
  z-index: 1;
}

.card-slide {
  padding: 20rpx 32rpx 0;
  box-sizing: border-box;
  height: 100%;
}

.card-bg {
  position: relative;
  width: 100%;
  height: 400rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  background-color: #2a2a4a;
}

.card-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(0, 0, 0, 0.45) 0%, rgba(0, 0, 0, 0.1) 60%, rgba(0, 0, 0, 0) 100%);
}

/* 高于用户等级的锁定蒙版 */
.card-lock-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(20, 20, 40, 0.55);
  z-index: 3;
}

.card-body {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  height: 100%;
  padding: 40rpx;
  box-sizing: border-box;
}

.card-left {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
}

.card-top-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 44rpx;
}

.card-tag {
  display: inline-block;
  background: linear-gradient(135deg, #c9a96e, #a07c3f);
  color: #fff;
  font-size: 22rpx;
  padding: 6rpx 20rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.card-title {
  font-size: 36rpx;
  font-weight: 700;
  color: white;
}

.card-level {
  font-size: 32rpx;
  font-weight: 700;
  color: #e8d5a3;
}

.card-quote {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  line-height: 1.6;
  max-width: 360rpx;
}

.card-right {
  width: 280rpx;
  height: 320rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.card-beast-img {
  width: 280rpx;
  height: 320rpx;
}

/* ========== 进度条区域 ========== */
.progress-section {
  width: 640rpx;
  margin: 0rpx auto 0;
}

/* LV指示器行：与神兽图标列表相同布局 */
.progress-indicator-wrap {
  display: flex;
  justify-content: space-between;
  width: 100%;
  padding: 0 4rpx;
  box-sizing: border-box;
}

.progress-indicator-slot {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  height: 56rpx;
}

.progress-indicator-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.progress-lv-label {
  font-size: 22rpx;
  color: #e8d5a3;
  font-weight: 600;
  line-height: 1;
}

.progress-lv-arrow {
  font-size: 18rpx;
  color: #e8d5a3;
  line-height: 1;
  margin-top: 2rpx;
}

.progress-bar-wrap {
  position: relative;
  padding: 8rpx 0 16rpx;
}

.progress-bar {
  position: relative;
  height: 8rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 4rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #c9a96e, #e8d5a3);
  /* background-color: #E5E5E; */
  border-radius: 4rpx;
  transition: width 0.4s ease;
}

/* ========== 神兽图标列表 ========== */
.beast-icon-list {
  display: flex;
  justify-content: space-between;
  width: 640rpx;
  margin: 24rpx auto 0;
  padding: 0 4rpx;
}

.beast-icon-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.beast-icon-img {
  width: 72rpx;
  height: 72rpx;
  transition: all 0.3s ease;
}

.beast-icon-img.beast-active {
  opacity: 1;
  transform: scale(1.15);
  /* filter: drop-shadow(0 0 8rpx rgba(232, 213, 163, 0.7)); */
}

.beast-icon-img.beast-passed {
  opacity: 0.8;
}

.beast-icon-img.beast-inactive {
  opacity: 0.3;
  filter: grayscale(0.6);
}

/* ========== 神兽弹窗 ========== */
.beast-popup {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.beast-popup-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  opacity: 0;
  transition: opacity 0.25s ease;
}

.beast-popup-mask.show {
  opacity: 1;
}

.beast-popup-content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 620rpx;
  transform: translateY(40rpx) scale(0.95);
  opacity: 0;
  transition: all 0.28s ease;
}

.beast-popup-content.show {
  transform: translateY(0) scale(1);
  opacity: 1;
}

/* 上方大神兽图 */
.beast-popup-hero {
  width: 580rpx;
  height: 400rpx;
  border-radius: 24rpx;
  overflow: hidden;
  position: relative;
  z-index: 2;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.35);
}

.beast-popup-hero-img {
  width: 100%;
  height: 100%;
}

/* 下方信息卡片：与神兽图重叠 */
.beast-popup-info {
  width: 580rpx;
  /* margin-top: -80rpx; */
  /* padding: 0rpx 0rpx 24rpx; */
  box-sizing: border-box;
  background: rgba(30, 30, 46, 0.97);
  border-radius: 48rpx;
  position: relative;
  z-index: 100;
  /* box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.5); */
}

/* 卡片背景小图 */
.beast-popup-card-bg {
  position: relative;
  width: 100%;
  height: 280rpx;
  border-radius: 16rpx;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  background-color: #1a1a2e;
  border: 2rpx solid rgba(201, 169, 110, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.beast-popup-card-text {
  position: relative;
  z-index: 2;
  text-align: center;
  padding: 16rpx;
}

.beast-popup-sparkle {
  font-size: 22rpx;
  color: rgba(232, 213, 163, 0.45);
  margin-bottom: 8rpx;
}

.beast-popup-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 16rpx;
  letter-spacing: 2rpx;
}

.beast-popup-time {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.65);
}
.beast-popup-time-color{
  color: red !important;
}

/* 弹窗蒙版（高于用户等级） */
.beast-popup-lock-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(20, 20, 40, 0.55);
  border-radius: 24rpx;
  z-index: 3;
}

.beast-popup-lock-mask.small {
  border-radius: 16rpx;

}

.beast-popup-card-bg-wrap {
  position: relative;
  width: 100%;
  overflow: hidden;
  border-radius: 16rpx;
  margin-top:-50rpx;
}

.beast-popup-btn {
  width: 400rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  margin-top: 44rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #c9a96e, #a07c3f);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

/* ========== 升级弹窗文字 ========== */
.upgrade-popup-congrats {
  font-size: 36rpx;
  font-weight: 700;
  color: #e8d5a3;
  margin-bottom: 12rpx;
}

.upgrade-popup-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.65);
  margin-bottom: 16rpx;
}

/* ========== 数据统计 ========== */
.stats-section {
  display: flex;
  justify-content: space-between;
  width: 686rpx;
  margin: 40rpx auto 0;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 20rpx;
  padding: 32rpx 24rpx;
  box-sizing: border-box;
}

.stats-item {
  flex: 1;
  text-align: center;
}

.stats-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #e8d5a3;
  margin-bottom: 8rpx;
  font-family: "DIN Alternate", "Helvetica Neue", sans-serif;
}

.stats-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
}

/* ========== 可享权益 ========== */
.rights-section {
  width: 686rpx;
  margin: 36rpx auto 0;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 24rpx;
  padding: 32rpx;
  box-sizing: border-box;
}

.rights-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 36rpx;
}

.rights-title-wrap {
  display: flex;
  align-items: baseline;
}

.rights-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
}

.rights-count {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.4);
  margin-left: 12rpx;
}

.rights-more {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: rgba(249,226,172,1);
}

.rights-arrow {
  font-size: 32rpx;
  margin-left: 4rpx;
  color: rgba(255,255,255,0.5);
}

.rights-list {
  display: flex;
  gap: 36rpx;
}

.rights-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.rights-icon-wrap {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(201, 169, 110, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
  background: rgba(201, 169, 110, 0.08);
}

.rights-icon {
  width: 52rpx;
  height: 52rpx;
}

.rights-name {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* ================================================================
   无等级页面样式 (levelMember)
   ================================================================ */

.no-level-page {
  min-height: 100vh;
  background-color: #1a1a2e;
  padding-bottom: 120rpx;
}

/* 顶部等级卡片 */
.level-card {

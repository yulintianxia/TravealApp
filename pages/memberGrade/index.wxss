}

.nl-rights-name {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
}

/* ================================================================
   权益体系弹窗
   ================================================================ */

.popup-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.6);
  backdrop-filter: blur(6px);
  z-index: 200;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s ease;
}

.popup-mask.popup-mask-show {
  opacity: 1;
  pointer-events: auto;
}

.popup-dialog {
  position: fixed;
  top: 50%;
  left: 50%;
  width: 600rpx;
  height: 1128rpx;
  transform: translate(-50%, -50%) scale(0.88);
  z-index: 201;
  border-radius: 28rpx;
  overflow: hidden;
  background: #1c1c28;
  display: flex;
  flex-direction: column;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.28s ease, transform 0.28s cubic-bezier(0.34, 1.3, 0.64, 1);
}

.popup-dialog.popup-dialog-show {
  opacity: 1;
  pointer-events: auto;
  transform: translate(-50%, -50%) scale(1);
}

.popup-dialog-body {
  display: flex;
  flex-direction: column;
  flex: 1;
  overflow: hidden;
  padding: 0 40rpx;
}

.popup-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
  text-align: left;
  padding: 36rpx 0 24rpx;
  line-height: 1.6;
  flex-shrink: 0;
}

.popup-scroll {
  height: 800rpx;
  flex-shrink: 0;
}

.popup-section {
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(255,255,255,0.07);
}

.popup-section:last-child {
  border-bottom: none;
}

.popup-section-title {
  font-size: 28rpx;
  font-weight: 500;
  color: rgba(255,255,255,0.75);
  line-height: 1.7;
}

.popup-section-sub {
  font-size: 28rpx;
  font-weight: 500;
  color: rgba(255,255,255,0.75);
  margin-bottom: 12rpx;
  line-height: 1.6;
}

.popup-text {
  font-size: 26rpx;
  color: rgba(255,255,255,0.48);
  line-height: 1.9;
  margin-bottom: 4rpx;
}

.popup-btn {
  flex-shrink: 0;
  align-self: center;
  width: 336rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: #c9a76a;
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 6rpx;
  margin: 24rpx 0 40rpx;
}

/* ===== 功能提示弹窗 ===== */
.tip-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.65);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tip-dialog {
  width: 580rpx;
  background: rgba(30, 35, 50, 0.95);
  border-radius: 24rpx;
  border: 1rpx solid rgba(201, 182, 126, 0.15);
  padding: 80rpx 48rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.tip-text {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.85);
  text-align: center;
  margin-bottom: 60rpx;
  line-height: 1.6;
}

.tip-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;

  max-width: 450rpx;
}

/* 积分排名 */
.rank-section {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 27rpx auto 0;
  padding: 16rpx 0;
}

.rank-icon {
  width: 24rpx;
  height: 24rpx;
  margin-right: 8rpx;
}

.rank-label {
  font-size: 28rpx;
  color: rgba(255,255,255,0.6);
}

.rank-value {
  font-size: 34rpx;
  font-weight: 700;
  color: #e8d5a3;
}

/* 积分进度区域 */
.nl-progress-section {
  width: 640rpx;
  margin: 20rpx auto 0;
}

.points-info {
  display: flex;
  align-items: baseline;
  /* margin-bottom: 16rpx; */
  margin-left:-16rpx;
}

.points-label {
  font-size: 24rpx;
  color: rgba(255,255,255,0.5);
  margin-right: 12rpx;
}

.points-value {
  font-size: 24rpx;
  font-weight: 700;
  color: #e8d5a3;
}

.nl-progress-bar-wrap {
  position: relative;
  padding: 40rpx 0 20rpx;
}

.nl-progress-bar {
  position: relative;
  height: 8rpx;
  background: rgba(255,255,255,0.15);
  border-radius: 4rpx;
}

.nl-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #c9a96e, #e8d5a3);
  border-radius: 4rpx;
  transition: width 0.5s ease;
}

.nl-progress-indicator {
  position: absolute;
  top: -36rpx;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: left 0.5s ease;
}

.nl-indicator-dot {
  width: 16rpx;
  height: 16rpx;
  background: #e8d5a3;
  border-radius: 50%;
  box-shadow: 0 0 12rpx rgba(232,213,163,0.6);
}

.nl-indicator-arrow {
  font-size: 18rpx;
  color: #e8d5a3;
  margin-top: -6rpx;
}

.nl-progress-node {
  position: absolute;
  top: 50%;
  transform: translate(-50%, -50%);
}

.nl-node-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.3);
}

.nl-node-dot.nl-node-active {
  background: #e8d5a3;
}

/* 等级图标列表 */
.level-icon-list {
  display: flex;
  justify-content: space-between;
  margin-top: 24rpx;
  padding: 0 4rpx;
}

.level-icon-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.level-icon-img {
  width: 72rpx;
  height: 72rpx;
  margin-bottom: 12rpx;
}

.level-icon-img.icon-active {
  opacity: 1;
}

.level-icon-img.icon-inactive {
  opacity: 0.35;
  filter: grayscale(0.5);
}

.level-icon-points {
  font-size: 22rpx;
  color: rgba(255,255,255,0.5);
}

/* 可享权益（无等级版） */
.nl-rights-section {
  width: 686rpx;
  margin: 48rpx auto 0;
  background: rgba(255,255,255,0.06);
  border-radius: 24rpx;
  padding: 32rpx;
  box-sizing: border-box;
}

.nl-rights-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 36rpx;
}

.nl-rights-title {
  display: flex;
  align-items: baseline;
}

.nl-rights-title-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
}

.nl-rights-count {
  font-size: 24rpx;
  color: rgba(255,255,255,0.4);
  margin-left: 12rpx;
}

.nl-rights-more {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: rgba(249,226,172,1);
}

.nl-rights-arrow {
  font-size: 32rpx;
  margin-left: 4rpx;
  color: rgba(255,255,255,0.5);
}

.nl-rights-list {
  display: flex;
  gap: 36rpx;
}

.nl-rights-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.nl-rights-icon-wrap {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(201,169,110,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;

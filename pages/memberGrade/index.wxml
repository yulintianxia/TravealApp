<!-- ========== 有等级：memberGrade 界面 ========== -->
<view wx:if="{{hasLevel}}" class="member-grade-page">

  <!-- 顶部卡片轮播（卡片折叠堆叠） -->
  <view class="card-stack-container">
    <view wx:if="{{hasNextLevel}}" class="card-peek">
      <view class="card-peek-bg" style="background-image: url({{nextLevelBg}})">
        <view class="card-peek-mask"></view>
      </view>
    </view>
    <swiper
      class="card-swiper"
      autoplay="{{false}}"
      bindchange="swiperChange"
      current="{{current}}"
      duration="{{400}}"
      indicator-dots="{{false}}"
      previous-margin="0rpx"
      next-margin="0rpx"
      circular="{{false}}"
      easing-function="easeInOutCubic"
    >
      <swiper-item wx:for="{{levelList}}" wx:key="index">
        <view class="card-slide" bindtap="onCurrentCardTap">
          <view class="card-bg" style="background-image: url({{BASE_URL}}{{item.background}})">
            <view class="card-overlay"></view>
            <view wx:if="{{index > myLevelIndex}}" class="card-lock-mask"></view>
            <view class="card-body">
              <view class="card-left">
                <view class="card-top-row">
                  <view class="card-tag">当前等级</view>
                  <view class="card-title">{{item.name}} <text class="card-level">V{{index + 1}}</text></view>
                </view>
                <view class="card-quote">{{item.remark}}</view>
              </view>
              <!-- <view class="card-right">
                <image class="card-beast-img" src="{{item.mountain ? BASE_URL + item.mountain : ''}}" mode="aspectFit"></image>
              </view> -->
            </view>
          </view>
        </view>
      </swiper-item>
    </swiper>

    <view class="card-swiper-indicator" wx:if="{{levelList.length > 1}}">
      <view
        wx:for="{{levelList}}"
        wx:key="index"
        class="card-swiper-dot {{current == index ? 'active' : ''}}"
      ></view>
    </view>
  </view>

  <!-- 等级指示器 + 进度条 -->
  <view class="progress-section">
    <view class="progress-indicator-wrap">
      <view wx:for="{{levelList}}" wx:key="index" class="progress-indicator-slot">
        <view wx:if="{{current == index}}" class="progress-indicator-inner">
          <view class="progress-lv-label">LV{{current + 1}}</view>
          <view class="progress-lv-arrow">▼</view>
        </view>
      </view>
    </view>
    <view class="progress-bar-wrap">
      <view class="progress-bar">
        <view class="progress-fill" style="width: {{progressPercent}}%"></view>
      </view>
    </view>
  </view>

  <!-- 神兽图标列表 -->
  <view class="beast-icon-list">
    <view wx:for="{{levelList}}" wx:key="index" class="beast-icon-item" bindtap="onBeastIconTap" data-index="{{index}}">
      <view wx:if="{{current == index}}" class="beast-fireworks">
        <view class="beast-spark s1"></view>
        <view class="beast-spark s2"></view>
        <view class="beast-spark s3"></view>
        <view class="beast-spark s4"></view>
        <view class="beast-spark s5"></view>
        <view class="beast-spark s6"></view>
      </view>
      <image
        class="beast-icon-img {{current == index ? 'beast-active' : (current > index ? 'beast-passed' : 'beast-inactive')}}"
        src="../../images/icons/{{index + 1}}-{{current == index || myLevelIndex == index ? 'on' : 'off'}}.png"
        mode="aspectFit"
      ></image>
    </view>
  </view>

  <!-- 数据统计区域 -->
  <view class="stats-section">
    <view class="stats-item" bindtap="turnTop">
      <view class="stats-value">{{pointsStart}}</view>
      <view class="stats-label">所需积分</view>
    </view>
    <view class="stats-item" bindtap="turnPoint">
      <view class="stats-value">{{pointsBalance}}</view>
      <view class="stats-label">当前积分</view>
    </view>
    <view class="stats-item" bindtap="turnTop">
      <view class="stats-value">{{top}}</view>
      <view class="stats-label">排名</view>
    </view>
    <view class="stats-item" bindtap="turnBadge">
      <view class="stats-value">{{medalCount}}</view>
      <view class="stats-label">我的勋章</view>
    </view>
  </view>

  <!-- 可享权益 -->
  <view class="rights-section">
    <view class="rights-header">
      <view class="rights-title-wrap">
        <text class="rights-title">可享权益</text>
        <text class="rights-count">2项</text>
      </view>
      <view class="rights-more" bindtap="showRightsPopup">
        <text>升级可享更多权益</text>
        <text class="rights-arrow">›</text>
      </view>
    </view>
    <view class="rights-list">
      <view class="rights-item" bindtap="turnBadgePage">
        <view class="rights-icon-wrap">
          <image class="rights-icon" src="{{rightsBadgeIcon}}" mode="aspectFit"></image>
        </view>
        <text class="rights-name">勋章</text>
      </view>
      <view class="rights-item" bindtap="turnGiftPage">
        <view class="rights-icon-wrap">
          <image class="rights-icon" src="{{rightsGiftIcon}}" mode="aspectFit"></image>
        </view>
        <text class="rights-name">商品</text>
      </view>
       <!-- <view class="rights-item" bindtap="showUpgradePopup">
        <view class="rights-icon-wrap">
          <image class="rights-icon" src="{{rightsGiftIcon}}" mode="aspectFit"></image>
        </view>
        <text class="rights-name">升级</text>
      </view> -->
    </view>
  </view>

</view>

<!-- ========== 无等级：levelMember 界面 ========== -->
<view wx:else class="no-level-page">

  <!-- 顶部等级卡片 -->
  <view class="level-card" style="background-image: url({{backGroundImgOrigin}})">
    <view class="level-card-overlay"></view>
    <view class="level-card-content">
      <view class="level-top-row">
        <view class="level-tag">当前等级</view>
        <view class="level-name">新晋会员<text class='level-name-v'> V0</text></view>
      </view>
      <view class="level-quote">{{rearkOrgin || ''}}</view>
    </view>
  </view>

  <!-- 积分排名 -->
  <view class="rank-section" bindtap="turnTop">
    <image class="rank-icon" src="{{rankIcon}}" mode="aspectFit"></image>
    <text class="rank-label">积分排名：</text>
    <text class="rank-value">第{{top}}名</text>
  </view>

  <!-- 当前积分和进度条 -->
  <view class="nl-progress-section">
    <view class="points-info">
      <text class="points-label">当前积分</text>
      <text class="points-value">{{pointsTotal}}</text>
    </view>
    <view class="nl-progress-bar-wrap">
      <view class="nl-progress-bar">
        <view class="nl-progress-fill" style="width: {{noLevelProgressPercent}}%"></view>
        <view class="nl-progress-indicator" style="left: {{noLevelProgressPercent}}%">
          <!-- <view class="nl-indicator-dot"></view> -->
          <view class="nl-indicator-arrow">▼</view>
        </view>
        <view wx:for="{{levelList}}" wx:key="index" class="nl-progress-node" style="left: {{index / (levelList.length - 1) * 100}}%">
          <view class="nl-node-dot {{currentLevelIndex >= index ? 'nl-node-active' : ''}}"></view>
        </view>
      </view>
    </view>
    <!-- 等级图标列表（可点击，触发神兽弹窗） -->
    <view class="level-icon-list">
      <view wx:for="{{levelList}}" wx:key="index" class="level-icon-item" data-index="{{index}}" bindtap="onBeastIconTap">
        <image class="level-icon-img icon-inactive" src="../../images/icons/{{index + 1}}-off.png" mode="aspectFit"></image>
        <text class="level-icon-points">{{item.pointsStart}}</text>
      </view>
    </view>
  </view>

  <!-- 可享权益 -->
  <view class="nl-rights-section">
    <view class="nl-rights-header">
      <view class="nl-rights-title">
        <text class="nl-rights-title-text">可享权益</text>
        <text class="nl-rights-count">2项</text>
      </view>
      <view class="nl-rights-more" bindtap="showRightsPopup">
        <text>升级可享更多权益</text>
        <text class="nl-rights-arrow">›</text>
      </view>
    </view>
    <view class="nl-rights-list">
      <view class="nl-rights-item" bindtap="turnBadgePage">
        <view class="nl-rights-icon-wrap">
          <image class="nl-rights-icon" src="{{rightsBadgeIcon}}" mode="aspectFit"></image>
        </view>
        <text class="nl-rights-name">勋章</text>
      </view>
      <view class="nl-rights-item" bindtap="turnGiftPage">
        <view class="nl-rights-icon-wrap">
          <image class="nl-rights-icon" src="{{rightsGiftIcon}}" mode="aspectFit"></image>
        </view>
        <text class="nl-rights-name">商品</text>
      </view>
    </view>
  </view>

</view>

<!-- ========== 共享：神兽弹窗 ========== -->
<view wx:if="{{showBeastPopup}}" class="beast-popup">
  <view class="beast-popup-mask {{showBeastPopupAnim ? 'show' : ''}}" bindtap="closeBeastPopup"></view>
  <view class="beast-popup-content {{showBeastPopupAnim ? 'show' : ''}}">
    <view class="beast-popup-hero">
      <image class="beast-popup-hero-img" src="{{popupLevel.mountain ? BASE_URL + popupLevel.mountain : ''}}" mode="aspectFill"></image>
      <view wx:if="{{popupIndex > myLevelIndex}}" class="beast-popup-lock-mask"></view>
    </view>
    <view class="beast-popup-info">
      <view class="beast-popup-card-bg-wrap">
        <view class="beast-popup-card-bg" style="background-image: url(https://zhenglian.vip/dotm/zl_images/vip_bg_image.png)">
          <view class="beast-popup-card-text">
            <!-- <view class="beast-popup-sparkle">✦</view> -->
            <view class="beast-popup-title">{{popupLevel.name}} V{{popupIndex + 1}}</view>
            <!-- <view class="beast-popup-time">获得时间：2025/12/25 20:50</view> -->
          </view>
        </view>
        <view wx:if="{{popupIndex > myLevelIndex}}" class="beast-popup-lock-mask small"></view>
      </view>
    </view>
    <view class="beast-popup-btn" bindtap="closeBeastPopup">知道了</view>
  </view>
</view>


<!-- ========== 共享：神兽弹窗分数差距 ========== -->
<view wx:if="{{showGapPopup}}" class="beast-popup">
  <view class="beast-popup-mask {{showBeastPopupAnim ? 'show' : ''}}" bindtap="closeBeastPopup"></view>
  <view class="beast-popup-content {{showBeastPopupAnim ? 'show' : ''}}">
    <view class="beast-popup-hero">
      <image class="beast-popup-hero-img" src="{{popupLevel.mountain ? BASE_URL + popupLevel.mountain : ''}}" mode="aspectFill"></image>
      <view wx:if="{{popupIndex > myLevelIndex}}" class="beast-popup-lock-mask"></view>
    </view>
    <view class="beast-popup-info">
      <view class="beast-popup-card-bg-wrap">
        <view class="beast-popup-card-bg" style="background-image: url(https://zhenglian.vip/dotm/zl_images/vip_bg_image.png)">
          <view class="beast-popup-card-text">
            <!-- <view class="beast-popup-sparkle">✦</view> -->
            <view class="beast-popup-title">{{popupLevel.name}} V{{popupIndex + 1}}</view>
            <view class="beast-popup-time beast-popup-time-color">还差积分升级{{gap}}</view>
          </view>
        </view>
        <view wx:if="{{popupIndex > myLevelIndex}}" class="beast-popup-lock-mask small"></view>
      </view>
    </view>
    <view class="beast-popup-btn" bindtap="closeBeastPopup">知道了</view>
  </view>
</view>

<!-- ========== 共享：升级弹窗 ========== -->
<view wx:if="{{showUpgradePopup}}" class="beast-popup">
  <view class="beast-popup-mask {{showUpgradePopupAnim ? 'show' : ''}}" bindtap="closeUpgradePopup"></view>
  <view class="beast-popup-content {{showUpgradePopupAnim ? 'show' : ''}}">
    <view class="beast-popup-hero">
      <image class="beast-popup-hero-img" src="{{currentLevel.mountain ? BASE_URL + currentLevel.mountain : ''}}" mode="aspectFill"></image>
    </view>
    <view class="beast-popup-info">
      <view class="beast-popup-card-bg-wrap">
        <view class="beast-popup-card-bg" style="background-image: url(https://zhenglian.vip/dotm/zl_images/vip_bg_image.png)">
          <view class="beast-popup-card-text">
            <view class="upgrade-popup-congrats">恭喜升级！</view>
            <view class="upgrade-popup-desc">您已经成功升级为</view>
            <view class="beast-popup-title">{{currentLevel.name}} V{{currentLevelIndex + 1}}</view>
          </view>
        </view>
      </view>
    </view>
    <view class="beast-popup-btn" bindtap="closeUpgradePopup">知道了</view>
  </view>
</view>

<!-- 功能未上线弹窗 -->
<view class="tip-mask" wx:if="{{showTip}}" bindtap="closeTip">
  <view class="tip-dialog" catchtap="">
    <view class="tip-text">功能即将上线，敬请期待！</view>
    <view class="tip-btn" bindtap="closeTip">知道了</view>
  </view>
</view>


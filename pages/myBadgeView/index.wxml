<view class="medalwall-wrap" style="background-image: url({{bgImg}});">
  <view class="medalwall-header" style="padding-top: 20px;text-align: center;">
    <!-- 原 van-tabs 注释保留，小程序可替换为官方 picker 或自定义 tab -->
  </view>
  <view class="medalwall-content" style="padding-top: 20px;">
    <view class="medalwall-middle">
      <!-- 小程序 swiper 替代原 Swiper 组件 -->
      <swiper 
        class="medal-list" 
        id="medal-list"
        indicator-dots="{{true}}" 
        indicator-active-color="#fff"
        autoplay="{{true}}" 
        interval="5000" 
        duration="500"
        bindchange="onSlideChange"
        previous-margin="50rpx"
        next-margin="50rpx"
      >
        <block wx:for="{{ImgLists}}" wx:key="index">
          <swiper-item class="">
            <view class="medal">
              <view 
                class="img {{reallevelId == levelId ? '' : 'menban'}}"
                style="background-image: url({{BASE_URL + item.mainPicture}});"
              >
              </view>
              <view class="year">{{item.year}}</view>
              <view class="title">
                {{item.name}} {{item.pointsPrice}}
              </view>
              <view class="tip">{{item.explains}}</view>
              <view class="tip tipTitle">{{item.remark}}</view>
              <view class="line">
                <button class="btn solid" bindtap="turnDetail" data-item="{{item}}">查看详情</button>
              </view>
            </view>
          </swiper-item>
        </block>
      </swiper>
    </view>
    <view class="medalwall-bottom">
      <view class="tour">
        <block wx:for="{{ImgLists}}" wx:key="index">
          <view class="dot {{index == checkIndex ? 'show' : ''}}"></view>
        </block>
      </view>
    </view>
  </view>
</view>
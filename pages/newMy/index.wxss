/* 全局样式 */
page {
  background-color: #f5f5f5;
  height: 100%;
  font-family: PingFangSC-Regular, sans-serif;
}

/* 个人中心容器 */
.personal-center {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

/* 顶部背景 */
.top-bg {
  position: relative;
  height: 400rpx;
  background: linear-gradient(135deg, #19A0F0 0%, #0066CC 100%);
  border-radius: 0 0 24rpx 24rpx;
  overflow: hidden;
}

.bg-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0.2;
}

/* 用户信息 */
.user-info {
  position: relative;
  z-index: 1;
  padding: 80rpx 32rpx 40rpx;
  color: white;
}

.avatar-section {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  margin-right: 24rpx;
}

.user-details {
  flex: 1;
}

.user-name {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
  display: block;
}

.user-level {
  font-size: 24rpx;
  opacity: 0.9;
}

/* 积分信息 */
.points-section {
  display: flex;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 12rpx;
  padding: 24rpx;
  backdrop-filter: blur(10rpx);
}

.points-item {
  flex: 1;
  text-align: center;
}

.points-value {
  font-size: 36rpx;
  font-weight: 700;
  display: block;
  margin-bottom: 8rpx;
}

.points-label {
  font-size: 20rpx;
  opacity: 0.8;
}

/* 功能列表 */
.function-list {
  flex: 1;
  padding: 32rpx 24rpx;
  margin-top: -24rpx;
}

/* 功能区块 */
.function-section {
  background: white;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.section-more {
  font-size: 24rpx;
  color: #999;
}

/* 功能网格 */
.function-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  padding: 32rpx 0;
}

.function-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
  transition: transform 0.2s ease;
}

.function-item:active {
  transform: scale(0.95);
}

.function-icon {
  width: 64rpx;
  height: 64rpx;
  margin-bottom: 16rpx;
}

.function-name {
  font-size: 22rpx;
  color: #333;
  text-align: center;
}

/* 退出登录按钮 */
.logout-section {
  padding: 0 24rpx 40rpx;
}

.logout-btn {
  width: 100%;
  height: 88rpx;
  background-color: white;
  border: 1rpx solid #e0e0e0;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #666;
  font-weight: 500;
  transition: all 0.2s ease;
}

.logout-btn:active {
  background-color: #f5f5f5;
  color: #333;

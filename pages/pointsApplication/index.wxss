page {
  background: #0b101a;
  height: 100vh;
}

.page {
  height: 100vh;
  background: #0b101a;
}

/* ===== 导航栏 ===== */
.nav-bar {
  background: #0b101a;
  position: relative;
  z-index: 10;
}

.nav-inner {
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #f0f0f0;
  letter-spacing: 2rpx;
}

/* ===== 滚动区 ===== */
.scroll-area {
  box-sizing: border-box;
}

/* ===== 表单 ===== */
.form {
  padding: 16rpx 32rpx;
  padding-bottom: 200rpx;
}

/* ===== 表单行 ===== */
.form-row {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
}

.form-label {
  width: 160rpx;
  flex-shrink: 0;
  font-size: 28rpx;
  color: #b0a898;
  font-weight: 500;
}

.label-no-req {
  color: #b0a898;
}

.req {
  color: #e04545;
  font-size: 30rpx;
  margin-left: 4rpx;
}

/* ===== 输入框 ===== */
.form-value {
  flex: 1;
  min-width: 0;
}

.form-input {
  width: 100%;
  height: 88rpx;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 16rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #e8e0d0;
}

.form-ph {
  color: #4e5566;
  font-size: 28rpx;
}

/* ===== 选择平台 ===== */
.form-select {
  height: 88rpx;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 16rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.form-select-text {
  font-size: 28rpx;
  color: #e8e0d0;
}

.arrow-icon {
  width: 32rpx;
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.arrow-down {
  display: inline-block;
  width: 16rpx;
  height: 16rpx;
  border-right: 3rpx solid #5a5e68;
  border-bottom: 3rpx solid #5a5e68;
  transform: rotate(45deg);
  margin-top: -6rpx;
}

/* ===== 区块型（上传/备注） ===== */
.form-block {
  margin-bottom: 32rpx;
}

.form-block .form-label {
  margin-bottom: 24rpx;
}

/* ===== 上传区 ===== */
.upload-area {
  --td-upload-add-bg-color: rgba(255, 255, 255, 0.06);
  --td-upload-add-icon-color: #5a5e68;
  --td-upload-add-color: #5a5e68;
  --td-upload-border-radius: 16rpx;
}

/* ===== 文本域 ===== */
.textarea-wrap {
  position: relative;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  min-height: 200rpx;
  font-size: 28rpx;
  color: #e8e0d0;
  background: transparent;
  line-height: 1.6;
}

.textarea-count {
  text-align: right;
  font-size: 24rpx;
  color: #4e5566;
  margin-top: 12rpx;
}

/* ===== 底部按钮 ===== */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 120rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  z-index: 10;
}

.btn {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #3a3122;
  background: linear-gradient(135deg, #d9c58e, #c0a86a);
  border-radius: 44rpx;
  letter-spacing: 2rpx;
}

.btn:active {
  opacity: 0.85;
}

.btn-disabled {
  background: #3a3a3a;
  color: #666;
}
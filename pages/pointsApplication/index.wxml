<!-- pages/my/my-add-address/index.wxml -->
<view class="page">
  <!-- 自定义导航栏 -->
  <!-- <view class="nav-bar" style="padding-top:{{statusBarHeight}}px">
    <view class="nav-inner">
      <view class="nav-title">积分申请</view>
    </view>
  </view> -->

  <scroll-view class="scroll-area" scroll-y style="height:calc(100vh - {{statusBarHeight + 44}}px)">
    <view class="form">

      <!-- 微信昵称 -->
      <view class="form-row">
        <view class="form-label">微信昵称<text class="req">*</text></view>
        <view class="form-value">
          <input
            class="form-input"
            placeholder="请输入您的微信昵称"
            placeholder-class="form-ph"
            value="{{wxName}}"
            disabled="{{isRead}}"
            bindblur="bindName"
          />
        </view>
      </view>

      <!-- 微信号 -->
      <view class="form-row">
        <view class="form-label">微信号<text class="req">*</text></view>
        <view class="form-value">
          <input
            class="form-input"
            placeholder="请输入您的微信号"
            placeholder-class="form-ph"
            value="{{wxNumber}}"
            disabled="{{isRead}}"
            bindblur="bindNumber"
          />
        </view>
      </view>

      <!-- 联系电话 -->
      <view class="form-row">
        <view class="form-label">联系电话<text class="req">*</text></view>
        <view class="form-value">
          <input
            class="form-input"
            placeholder="请输入您的联系电话"
            placeholder-class="form-ph"
            type="number"
            maxlength="11"
            value="{{phone}}"
            disabled="{{isRead}}"
            bindblur="bindPhone"
          />
        </view>
      </view>

      <!-- 选择平台 -->
      <view class="form-row" bindtap="onPlatformPicker">
        <view class="form-label">选择平台<text class="req">*</text></view>
        <view class="form-value form-select">
          <text class="form-select-text {{platformText ? '' : 'form-ph'}}">{{platformText || '请选择平台'}}</text>
          <view class="arrow-icon" wx:if="{{!isRead}}">
            <text class="arrow-down"></text>
          </view>
        </view>
      </view>

      <!-- 订单号 -->
      <view class="form-row">
        <view class="form-label">订单号<text class="req">*</text></view>
        <view class="form-value">
          <input
            class="form-input"
            placeholder="请输入您的订单号"
            placeholder-class="form-ph"
            type="number"
            value="{{actualPayment}}"
            disabled="{{isRead}}"
            bindblur="bindOrder"
          />
        </view>
      </view>

      <!-- 实付金额 -->
      <view class="form-row">
        <view class="form-label">实付金额<text class="req">*</text></view>
        <view class="form-value">
          <input
            class="form-input"
            placeholder="请输入您的实付金额"
            placeholder-class="form-ph"
            type="digit"
            value="{{paymentMoney}}"
            disabled="{{isRead}}"
            bindblur="bindMoney"
          />
        </view>
      </view>

      <!-- 上传图片 -->
      <view class="form-block">
        <view class="form-label">上传图片<text class="req">*</text></view>
        <view class="upload-area">
          <t-upload
            disabled="{{isRead}}"
            max="{{4}}"
            media-type="{{['image']}}"
            files="{{orderPhotoList}}"
            bind:add="handleAdd"
            bind:remove="handleRemove"
          />
        </view>
      </view>

      <!-- 备注信息 -->
      <view class="form-block">
        <view class="form-label label-no-req">备注信息</view>
        <view class="textarea-wrap">
          <textarea
            class="form-textarea"
            placeholder="请输入您的备注信息"
            placeholder-class="form-ph"
            value="{{remark}}"
            disabled="{{isRead}}"
            maxlength="500"
            bindblur="bindText"
          />
          <view class="textarea-count">{{remark.length || 0}}/500</view>
        </view>
      </view>

    </view>
  </scroll-view>

  <!-- 底部按钮 -->
  <view class="footer">
    <view class="btn {{isRead ? 'btn-disabled' : ''}}" bindtap="submit">提交</view>
  </view>
</view>

<!-- 平台选择器 -->
<t-picker
  visible="{{visible}}"
  value="{{purchasePlatform}}"
  data-key="platform"
  keys="{{keys}}"
  title="选择平台"
  cancelBtn="取消"
  confirmBtn="确认"
  usingCustomNavbar
  bindchange="onPickerChange"
  bindpick="onColumnChange"
  bindcancel="onPickerCancel"
>
  <t-picker-item options="{{platforms}}">
  </t-picker-item>
</t-picker>
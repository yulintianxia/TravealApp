<!-- pages/my/my-add-address/index.wxml -->
<view class="redact-address">
    <view class="input-container">
        <view class="input-example">
            <t-input placeholder="请输入您的微信昵称" disabled="{{isRead}}" value="{{wxName}}" bindblur="bindName">
                <view slot="label" class="custom-label">微信昵称</view>
            </t-input>
        </view>
        <view class="input-example">
            <t-input placeholder="请输入您的微信号" disabled="{{isRead}}" value="{{wxNumber}}" bindblur="bindNumber">
                <view slot="label" class="custom-label">微信号</view>
            </t-input>
        </view>
        <view class="input-example">
            <t-input placeholder="请输入您的联系电话" disabled="{{isRead}}" value="{{phone}}" type='number' bindblur="bindPhone" maxlength="11">
                <view slot="label" class="custom-label">联系电话</view>
            </t-input>
        </view>
        <view class="input-example">
            <t-cell t-class-center="custom-label" title="选择平台" arrow="{{!isRead}}" hover note="{{platformText}}" bind:click="onPlatformPicker" />
        </view>
        <view class="input-example">
            <t-input placeholder="请输入您的订单号"  disabled="{{isRead}}" value="{{actualPayment}}" bindblur='bindOrder' type='number'>
                <view slot="label" class="custom-label">订单号</view>
            </t-input>
        </view>
        <view class="input-example">
            <t-input placeholder="请输入您的实付金额" type='digit' disabled="{{isRead}}" value="{{paymentMoney}}" bindblur='bindMoney' type='number'>
                <view slot="label" class="custom-label">实付金额</view>
            </t-input>
        </view>
        <view class="input-example input-cell">
            <view class='input-upload-container'>
                <view class='custom-label custtom-lable-title'>上传图片(最多5张)</view>
                <view class='input-upload-img-container'>
                    <t-upload disabled="{{isRead}}" max="{{5}}" media-type="{{['video','image']}}" files="{{orderPhotoList}}" bind:add="handleAdd" bind:remove="handleRemove" />
                </view>
            </view>
        </view>
        <view class="input-example input-cell">
            <t-textarea label="" disabled="{{isRead}}" value="{{remark}}" bindblur='bindText' maxlength="500" placeholder="请输入您的备注(最多500字)" disableDefaultPadding="{{true}}" autosize="{{autosize}}" bind:line-change="onLineChange" />
        </view>
    </view>
</view>
<view class="btn {{isRead?'btngrey':''}}" bindtap="submit">申请</view>
<t-picker visible="{{visible}}" value="{{purchasePlatform}}" data-key="platform" keys="{{keys}}" title="选择平台" cancelBtn="取消" confirmBtn="确认" usingCustomNavbar bindchange="onPickerChange" bindpick="onColumnChange" bindcancel="onPickerCancel">
    <t-picker-item options="{{platforms}}" >
            <view wx:if="{{option.dictLabel}}" slot="label-suffix--{{index}}" class="label-suffix">
                <t-tag size="small" theme="primary">{{option.dictLabel}}</t-tag>
            </view>
    </t-picker-item>
</t-picker>
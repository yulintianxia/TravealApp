<!-- pages/setting/setting.wxml -->
<view class="page">
  <!-- 自定义导航栏 -->
  <!-- <view class="nav-bar" style="padding-top:{{statusBarHeight}}px;height:{{navBarHeight}}px;">
    <text class="nav-title">设置</text>
  </view> -->

  <view class="content" style="padding-top:20px;">

    <!-- 修改头像 -->
    <view class="cell" bindtap="handlePopup">
      <text class="cell-label">修改头像</text>
      <view class="cell-right">
        <image class="cell-avatar" src="{{image}}" mode="aspectFill"/>
        <text class="cell-arrow">›</text>
      </view>
    </view>

    <!-- 修改昵称 -->
    <view class="cell" hover-class="cell-hover" bindtap="handleNicknamePopup">
      <text class="cell-label">修改昵称</text>
      <view class="cell-right">
        <text class="cell-value">{{nickName || '未设置'}}</text>
        <text class="cell-arrow">›</text>
      </view>
    </view>

    <!-- 修改密码 -->
    <!-- <navigator class="cell" url="/pages/newLogin/index?type=CHANGEPWD" hover-class="cell-hover">
      <text class="cell-label">修改密码</text>
      <text class="cell-arrow">›</text>
    </navigator> -->

    <!-- 地址管理 -->
    <view class="cell" hover-class="cell-hover" bindtap="handleAddressManage">
      <text class="cell-label">地址管理</text>
      <text class="cell-arrow">›</text>
    </view>

  </view>

  <!-- 底部退出按钮 -->
  <view class="btn-wrap">
    <view class="btn-logout" bindtap="logoutHandler">退出登录</view>
  </view>

  <!-- 头像上传弹窗（设计稿样式） -->
  <view wx:if="{{visible}}" class="avatar-modal-mask" bindtap="handleMaskTap">
    <view class="avatar-modal" catchtap="stopPropagation">
      <view class="avatar-modal-close" bindtap="onClose">✕</view>

      <view class="avatar-select-wrap" bindtap="handleChooseAvatar">
        <image class="avatar-preview" src="{{previewAvatar}}" mode="aspectFill" binderror="handleImageError" />
        <view class="avatar-plus">+</view>
      </view>

      <view class="avatar-action-row">
        <button
          class="avatar-action-btn avatar-action-btn-secondary"
          open-type="chooseAvatar"
          bindchooseavatar="handleChooseWechatAvatar"
        >获取微信头像</button>
        <button
          class="avatar-action-btn avatar-action-btn-primary"
          bindtap="handleConfirmUpload"
          disabled="{{uploading}}"
        >{{uploading ? '上传中...' : '上传头像'}}</button>
      </view>
    </view>
  </view>

  <view wx:if="{{nicknameVisible}}" class="avatar-modal-mask" bindtap="onNicknameClose">
    <view class="avatar-modal nickname-modal" catchtap="stopPropagation">
      <view class="avatar-modal-close" bindtap="onNicknameClose">✕</view>
      <view class="nickname-modal-title">修改昵称</view>
      <input
        class="nickname-input"
        type="nickname"
        maxlength="20"
        value="{{nickNameInput}}"
        focus="{{nicknameInputFocus}}"
        placeholder="请输入昵称"
        placeholder-class="nickname-input-placeholder"
        bindinput="handleNicknameInput"
        bindconfirm="handleNicknameKeyboardConfirm"
      />
      <button class="avatar-action-btn avatar-action-btn-secondary nickname-wechat-btn" bindtap="handleGetWechatNickname">
        使用微信昵称快捷填充
      </button>
      <view class="avatar-action-row nickname-action-row">
        <button class="avatar-action-btn avatar-action-btn-secondary" bindtap="onNicknameClose">取消</button>
        <button
          class="avatar-action-btn avatar-action-btn-primary"
          bindtap="handleNicknameConfirm"
          data-source="button"
          disabled="{{nicknameSubmitting}}"
        >{{nicknameSubmitting ? '提交中...' : '确定'}}</button>
      </view>
    </view>
  </view>
</view>
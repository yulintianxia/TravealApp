<!-- pages/setting/setting.wxml -->
<view class='container'>
    <t-cell-group theme="card">
        <t-cell title="修改头像" hover bind:tap="handlePopup">
            <t-avatar class="avatar-example" slot="right-icon" image="{{image}}" />
        </t-cell>
        <t-cell title="修改密码" jump-type='navigateTo' url='/pages/login/login?type=CHANGEPWD' hover arrow />
        <t-cell title="地址管理" jump-type='navigateTo' url='/pages/addressList/index' arrow />
        <!-- <t-cell title="积分明细" jump-type='navigateTo' url='/pages/point/index' arrow />
        <t-cell title="排行榜" jump-type='navigateTo' url='/pages/pointrank/index' arrow /> -->
    </t-cell-group>
    <t-popup visible="{{visible}}" bind:visible-change="onVisibleChange" placement="bottom">
        <view class="block">
            <t-icon t-class="close-btn close-btn-icon" name="close-circle" size="50rpx" color="#555" bind:tap="onClose" />
            <view class="upload-container">
                <t-upload mediaType="{{['image']}}" max="{{1}}" files="{{fileList}}" bind:add="handleAdd" bind:remove="handleRemove"></t-upload>
            </view>
        </view>
    </t-popup>
    <view class="logout-wrap">
        <button bindtap="logoutHandler" class="logout">退出登录</button>
    </view>
</view>
/* pages/setting/setting.wxss */
.container {
  background: #f7f7f7;
  width: 100vw;
  padding-top: 30rpx;
  height: 100vh;
}

.avatar {
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  overflow: hidden;
}

.block {
  width: 100vw;
  height: 150px;
  background: var(--td-bg-color-container);
  border-top-left-radius: 16rpx;
  border-top-right-radius: 16rpx;
}

.header {
  display: flex;
  align-items: center;
  height: 116rpx;
}

.title {
  flex: 1;
  text-align: center;
  font-weight: 600;
  font-size: 36rpx;
  color: var(--td-text-color-primary);
}

.btn {
  font-size: 32rpx;
  padding: 32rpx;
}

.btn--cancel {
  color: var(--td-text-color-secondary);
}

.btn--confirm {
  color: #0052d9;
}

.upload-container {
   text-align: center;
   margin:0 auto;
   height: 120px;
}
.close-btn-icon {
  color: #555;
  font-size: 44rpx;
  /* text-align: right; */
  /* float: right; */
  display: flex;
  justify-content: flex-end;
  margin-top: 25rpx;
  margin-right: 25rpx;
}

.block--top,
.block--bottom {
  width: 100vw;
  height: 150px;
}

.logout-wrap {
  padding-bottom: 65rpx;
  padding-top: 40rpx;
  position: fixed;
  width: 100%;
  margin: 0 atuo;
  bottom: 5%;
}

.logout {
  border-color: #aaa;
  border-radius: 8rpx;
  color: white;
  font-size: 30rpx;
  text-align: center;
  width: 280rpx;
  background: #0086f6;
}
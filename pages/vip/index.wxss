  position: relative;
}
.nav-tabs .tabs-item {
  color: #f0f2f4;
  font-size: 36rpx;
  line-height: 40rpx;
  margin-left: 48rpx;
  transition: 0.15s;
}
.nav-tabs .bottom-line,
.nav-tabs .bottom-old-line {
  animation-duration: 0.2s;
  animation-fill-mode: forwards;
  animation-timing-function: ease-in-out;
  background: linear-gradient(270deg, #deb89e, #fbe3cf);
  border-radius: 3rpx;
  bottom: -18rpx;
  height: 6rpx;
  left: 104rpx;
  position: absolute;
  width: 73rpx;
}
.nav-tabs .bottom-line .black-bottom-line,
.nav-tabs .bottom-old-line .black-bottom-line {
  background-color: #000;
  border-radius: 3rpx;
  height: 100%;
  left: 0;
  position: absolute;
  top: 0;
  width: 100%;
  z-index: 99;
}
.animationOff .bottom-line,
.animationOff .bottom-old-line {
  animation-duration: 0s;
}
.group-a.nav-tabs-primary .bottom-old-line {
  animation-name: ordinary-to-primary;
}
.group-a.nav-tabs-ordinary .bottom-old-line {
  animation-name: primary-to-ordinary;
}
.nav-tabs-primary .tabs-primary-item {
  color: #fbe2cc;
  font-size: 48rpx;
  font-weight: 600;
}
.nav-tabs-primary .bottom-line {
  animation-name: tab-primary-animation;
}
.nav-tabs-primary .bottom-old-line {
  animation-name: old-tab-primary-animation;
}
.nav-tabs-ordinary .tabs-ordinary-item {
  color: #dbefff;
  font-size: 48rpx;
  font-weight: 600;
}
.nav-tabs-ordinary .bottom-line {
  animation-name: tab-ordinary-animation;
}
.nav-tabs-ordinary .bottom-old-line {
  animation-name: old-tab-ordinary-animation;
}
.colorBlack .tabs-item {
  color: #000 !important;
}

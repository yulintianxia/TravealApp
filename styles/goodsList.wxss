.goods-list-wrap {
  background-color: #fff;
  margin-bottom: -12rpx;
  padding-left: 12rpx;
}
.goods-list-wrap .wr-goods-card {
  background-color: #fff;
  border-bottom: 1rpx solid #e6e6e6;
  padding: 24rpx 24rpx 24rpx 0;
}
.goods-list-wrap .wr-goods-card.no-border {
  border-bottom: none;
}
.goods-list-wrap .wr-goods-card .wr-goods-card__thumb {
  border-radius: 8rpx;
  height: 200rpx;
  margin-right: 24rpx;
  overflow: hidden;
  width: 200rpx;
}
.goods-list-wrap .wr-goods-card .title {
  -webkit-box-orient: vertical;
  line-clamp: 2;
  display: -webkit-box;
  overflow: hidden;
  vertical-align: middle;
  white-space: normal;
  width: 100%;
  word-spacing: normal;
}
.goods-list-wrap .wr-goods-card .subTitle {
  color: #898e92;
  font-size: 22rpx;
  line-height: 32rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.goods-list-wrap .wr-goods-card .wr-goods-card__content {
  display: -webkit-flex;
  display: flex;
  flex-flow: column nowrap;
  height: 200rpx;
  justify-content: space-between;
  position: relative;
  width: 100%;
}
.goods-list-wrap .wr-goods-card .wr-goods-card__content .wr-goods-card__title {
  -webkit-box-orient: vertical;
  line-clamp: 2;
  display: -webkit-box;
  font-size: 26rpx;
  font-weight: 400;
  line-height: 36rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  text-overflow: ellipsis;
}
.goods-list-wrap .wr-goods-card .wr-goods-card__content .wr-good-title-icon {
  height: 30rpx;
  margin-right: 10rpx;
  vertical-align: middle;
  width: 72rpx;
}
.goods-list-wrap
  .wr-goods-card
  .wr-goods-card__content
  .wr-good-title-icon
  image {
  height: 100%;
  width: 100%;
}
.goods-list-wrap .wr-goods-card .wr-goods-card__content .preSaleImg {
  width: 58rpx;
}
.goods-list-wrap .wr-goods-card .wr-goods-card__content .preSaleImgEN {
  width: 104rpx;
}
.goods-list-wrap
  .wr-goods-card
  .wr-goods-card__content
  .card-index--wr-goods-card__price {
  font-size: 32rpx;
}
.goods-list-wrap
  .wr-goods-card
  .wr-goods-card__content
  .card-index--wr-goods-card__price
  .symbol {
  font-size: 24rpx;
}
.goods-list-wrap .wr-goods-card .wr-goods-card__tags {
  flex-grow: 2;
}
.goods-list-wrap .wr-goods-card .goods-card-tags-wrap {
  color: #fa550f;
  display: -webkit-flex;
  display: flex;
  flex-flow: row wrap;
  flex-shrink: 0;
  height: 30rpx;
  overflow: hidden;
  text-align: center;
  width: 100%;
}
.goods-list-wrap .wr-goods-card .goods-card-tags-wrap .tag {
  border-radius: 8rpx;
  box-sizing: border-box;
  flex-shrink: 0;
  font-size: 20rpx;
  height: 32rpx;
  line-height: 32rpx;
  margin-right: 8rpx;
  padding: 0 8rpx;
  vertical-align: middle;
}
.goods-list-wrap .wr-goods-card .goods-card-tags-wrap .tag::after {
  border-radius: 16rpx;
}
.goods-list-wrap .wr-goods-card .goods-add-cart {
  align-items: center;
  bottom: 14rpx;
  display: -webkit-flex;
  display: flex;
  justify-content: center;
  position: absolute;
  right: 0;
  width: 48rpx;
}
.goods-list-wrap .wr-goods-card .goods-add-cart .goods-add-cart {
  height: 48rpx;
  line-height: 48rpx;
}
.goods-list-wrap.vertical {
  background-color: initial;
  display: -webkit-flex;
  display: flex;
  flex-flow: row wrap;
  justify-content: space-between;
  padding: 0rpx 12rpx;
}
.goods-list-wrap.vertical .wr-goods-card {
  border-bottom: none;
  display: -webkit-flex;
  display: flex;
  flex-flow: column nowrap;
  height: 574rpx;
  overflow: hidden;
  padding: 0;
  width: 340rpx;
}
.goods-list-wrap.vertical .wr-goods-card .wr-goods-card__thumb {
  height: 340rpx;
  width: 100%;
}
.goods-list-wrap.vertical .wr-goods-card .wr-goods-card__content {
  box-sizing: border-box;
  height: 234rpx;
  overflow: hidden;
  padding: 20rpx;
  width: 100%;
}
.goods-list-wrap.vertical
  .wr-goods-card
  .wr-goods-card__content
  .wr-goods-card__title {
  -webkit-box-orient: horizontal;
  line-clamp: 1;
  color: #333;
  display: block;
  height: 36rpx;
  white-space: nowrap;
}
.goods-list-wrap.vertical
  .wr-goods-card
  .wr-goods-card__content
  .card-index--wr-goods-card__origin-price {
  bottom: 60rpx;
  color: #aaa;
  font-size: 24rpx;
  left: 20rpx;
  margin-left: 0;
  position: absolute;
}
.goods-list-wrap.vertical .wr-goods-card .goods-add-cart {
  bottom: 20rpx;
  right: 20rpx;
}
.goods-list-wrap.vertical .normal-two {
  margin-bottom: 12rpx;
}
.goods-list-wrap .wr-goods-card__twoLine .wr-goods-card__title {
  line-clamp: 2 !important;
  -webkit-box-orient: vertical !important;
  display: -webkit-box !important;
  height: auto !important;
  white-space: normal !important;
}
